{% set isZh = locale == "zh" %}
<article class="day-card">
  <p class="card-kicker">{{ "第" if isZh else "Day " }}{{ item.data.day | padDay }}{{ "日" if isZh else "" }} / {{ book.total_days }}</p>
  <h2><a href="{{ item.url }}">{{ item.data.title }}</a></h2>
  <p>{{ item.data.summary }}</p>
</article>
