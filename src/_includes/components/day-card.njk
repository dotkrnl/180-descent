<article class="day-card">
  <p class="card-kicker">Day {{ item.data.day | padDay }} / {{ book.total_days }}</p>
  <h2><a href="{{ item.url }}">{{ item.data.title }}</a></h2>
  <p>{{ item.data.summary }}</p>
  {% if item.data.threads %}
    <p class="thread-list">{{ item.data.threads | join(" · ") }}</p>
  {% endif %}
</article>

