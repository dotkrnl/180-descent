{% set isZh = locale == "zh" %}
<!doctype html>
<html lang="{{ book.zh.language if isZh else book.language }}" data-theme="light">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, follow">
    <meta name="theme-color" content="#f5f3ec">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ '/assets/images/brand/favicon-32.png' | assetUrl }}">
    <title>{{ title }} · {{ book.zh.title if isZh else book.title }}</title>
    <link rel="stylesheet" href="{{ '/assets/css/book.css' | assetUrl }}">
  </head>
  <body class="print-document{% if includeDeepDive %} include-deep-dive{% endif %}">
    {{ content | safe }}
  </body>
</html>
