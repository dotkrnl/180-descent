---
layout: layouts/base.njk
---
{% set isZh = locale == "zh" %}
{% set dayCollection = collections.zhDays if isZh else collections.days %}
{% set previousDay = dayCollection | previousPublishedDay(day) %}
{% set nextDay = dayCollection | nextPublishedDay(day) %}
{% set dayDownloadPrefix = "/downloads/180-descent-zh-day-" + day_path if isZh else "/downloads/180-descent-day-" + day_path %}
{% macro dayNav(position) %}
<nav class="lesson-nav lesson-nav-{{ position }} wrap wide" aria-label="{{ "日课导航" if isZh else "Day navigation" }}">
  {% if previousDay %}
  <a class="lesson-nav-card" href="{{ previousDay.url }}">
    <span>{{ "上一篇" if isZh else "Previous" }}</span>
    <strong>{{ "第" if isZh else "Day " }}{{ previousDay.data.day | padDay }}{{ "日" if isZh else "" }} · {{ previousDay.data.title }}</strong>
  </a>
  {% else %}
  <span class="lesson-nav-card is-disabled">
    <span>{{ "上一篇" if isZh else "Previous" }}</span>
    <strong>{{ "全书起点" if isZh else "Start of the book" }}</strong>
  </span>
  {% endif %}
  <a class="lesson-nav-card is-syllabus" href="{{ "/zh/syllabus/" if isZh else "/syllabus/" }}">
    <span>{{ "课程表" if isZh else "Map" }}</span>
    <strong>{{ "完整课程表" if isZh else "Full syllabus" }}</strong>
  </a>
  {% if nextDay %}
  <a class="lesson-nav-card" href="{{ nextDay.url }}">
    <span>{{ "下一篇" if isZh else "Next" }}</span>
    <strong>{{ "第" if isZh else "Day " }}{{ nextDay.data.day | padDay }}{{ "日" if isZh else "" }} · {{ nextDay.data.title }}</strong>
  </a>
  {% else %}
  <span class="lesson-nav-card is-disabled">
    <span>{{ "下一篇" if isZh else "Next" }}</span>
    <strong>{{ "尚未发布" if isZh else "Not published yet" }}</strong>
  </span>
  {% endif %}
</nav>
{% endmacro %}
<article
  class="lesson"
  data-day="{{ day }}"
  data-reading-progress
  data-reading-locale="{{ "zh" if isZh else "en" }}"
  data-reading-day="{{ day }}"
  data-reading-url="{{ page.url | escape }}"
  data-reading-label="{{ "第" if isZh else "Day " }}{{ day | padDay }}{{ "日" if isZh else "" }} · {{ title | escape }}"
  data-reading-title="{{ title | escape }}"
  data-reading-summary="{{ summary | escape }}"
>
  <div class="download-strip">
    <div class="wrap wide">
      <span>{{ "下载本日：" if isZh else "Download this day:" }}</span>
      <a href="{{ dayDownloadPrefix }}.epub">EPUB</a>
      <a href="{{ dayDownloadPrefix }}.pdf">PDF</a>
    </div>
  </div>
  {{ dayNav("top") }}
  {{ content | safe }}
  {{ dayNav("bottom") }}
</article>
