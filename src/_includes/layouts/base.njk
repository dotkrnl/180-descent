{% set isZh = locale == "zh" %}
{% set uiTitle = book.zh.title if isZh else book.title %}
{% set uiSubtitle = book.zh.subtitle if isZh else book.subtitle %}
{% set uiDescription = book.zh.description if isZh else book.description %}
{% set isWebIndex = page.url == "/" or page.url == "/zh/" %}
{% set languageUrl = page.url | languageAlternateUrl(locale, day_path, alternate_url, hide_language_toggle) %}
{% set metaDescription = description or summary or uiDescription %}
{% set pageTitle = title + " · " + uiTitle if title else uiTitle %}
{% set canonicalPath = canonical_url or page.url %}
{% set canonicalUrl = canonicalPath | absoluteUrl(book.site_url) %}
{% set socialImagePath = seo_image or image %}
{% if not socialImagePath %}
  {% if day_path %}
    {% set socialImagePath = "/assets/images/social/zh-day-" + day_path + ".png" if isZh else "/assets/images/social/day-" + day_path + ".png" %}
  {% else %}
    {% set socialImagePath = "/assets/images/social/180-descent-zh.png" if isZh else "/assets/images/social/180-descent.png" %}
  {% endif %}
{% endif %}
{% set socialImageUrl = socialImagePath | absoluteUrl(book.site_url) %}
{% set alternateEnglishUrl = (languageUrl if isZh else page.url) | absoluteUrl(book.site_url) %}
{% set alternateZhUrl = (page.url if isZh else languageUrl) | absoluteUrl(book.site_url) %}
{% set dayCollection = collections.zhDays if isZh else collections.days %}
{% set previousDay = dayCollection | previousPublishedDay(day) if day else null %}
{% set nextDay = dayCollection | nextPublishedDay(day) if day else null %}
<!doctype html>
<html lang="{{ book.zh.language if isZh else book.language }}" data-theme="auto">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#f7f3ea">
    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ metaDescription }}">
    <meta name="robots" content="{{ robots or "index, follow" }}">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ '/assets/images/brand/favicon-32.png' | assetUrl }}">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ '/assets/images/brand/apple-touch-icon.png' | assetUrl }}">
    <link rel="manifest" href="/site.webmanifest">
    <link rel="canonical" href="{{ canonicalUrl }}">
    {% if languageUrl %}
    <link rel="alternate" hreflang="{{ book.language }}" href="{{ alternateEnglishUrl }}">
    <link rel="alternate" hreflang="{{ book.zh.language }}" href="{{ alternateZhUrl }}">
    <link rel="alternate" hreflang="x-default" href="{{ alternateEnglishUrl }}">
    {% endif %}
    {% if previousDay %}<link rel="prev" href="{{ previousDay.url | absoluteUrl(book.site_url) }}">{% endif %}
    {% if nextDay %}<link rel="next" href="{{ nextDay.url | absoluteUrl(book.site_url) }}">{% endif %}
    <meta property="og:type" content="{{ "article" if day else "website" }}">
    <meta property="og:site_name" content="{{ uiTitle }}">
    <meta property="og:title" content="{{ pageTitle }}">
    <meta property="og:description" content="{{ metaDescription }}">
    <meta property="og:url" content="{{ canonicalUrl }}">
    <meta property="og:image" content="{{ socialImageUrl }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:locale" content="{{ "zh_CN" if isZh else "en_US" }}">
    {% if languageUrl %}<meta property="og:locale:alternate" content="{{ "en_US" if isZh else "zh_CN" }}">{% endif %}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ pageTitle }}">
    <meta name="twitter:description" content="{{ metaDescription }}">
    <meta name="twitter:image" content="{{ socialImageUrl }}">
    <script>
      (function(){
        try{
          var theme = window.localStorage && window.localStorage.getItem("180-descent-theme");
          if(theme === "light" || theme === "dark"){
            document.documentElement.setAttribute("data-theme", theme);
          }
        }catch(error){}
      })();
    </script>
    <link rel="stylesheet" href="{{ '/assets/css/book.css' | assetUrl }}">
    <script src="{{ '/assets/js/book.js' | assetUrl }}" defer></script>
    {% for script in scripts or [] %}
      <script src="{{ script | assetUrl }}" defer></script>
    {% endfor %}
    <script type="application/ld+json">
{{ {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": uiTitle,
  "url": ("/zh/" if isZh else "/") | absoluteUrl(book.site_url),
  "description": uiDescription,
  "inLanguage": book.zh.language if isZh else book.language,
  "publisher": {
    "@type": "Organization",
    "name": book.publisher
  }
} | json | safe }}
    </script>
    {% if isWebIndex %}
    <script type="application/ld+json">
{{ {
  "@context": "https://schema.org",
  "@type": "Book",
  "name": uiTitle,
  "alternateName": uiSubtitle,
  "url": canonicalUrl,
  "description": uiDescription,
  "inLanguage": book.zh.language if isZh else book.language,
  "author": {
    "@type": "Organization",
    "name": book.zh.authors if isZh else book.authors
  },
  "publisher": {
    "@type": "Organization",
    "name": book.publisher
  },
  "datePublished": book.published_year,
  "isAccessibleForFree": true,
  "image": socialImageUrl
} | json | safe }}
    </script>
    {% endif %}
    {% if day %}
    <script type="application/ld+json">
{{ {
  "@context": "https://schema.org",
  "@type": "LearningResource",
  "name": ("第" + (day | padDay) + "日 · " + title) if isZh else ("Day " + (day | padDay) + ": " + title),
  "headline": title,
  "description": metaDescription,
  "url": canonicalUrl,
  "image": socialImageUrl,
  "inLanguage": book.zh.language if isZh else book.language,
  "author": {
    "@type": "Organization",
    "name": book.zh.authors if isZh else book.authors
  },
  "publisher": {
    "@type": "Organization",
    "name": book.publisher
  },
  "isPartOf": {
    "@type": "Book",
    "name": uiTitle,
    "url": ("/zh/" if isZh else "/") | absoluteUrl(book.site_url)
  },
  "position": day,
  "about": threads or []
} | json | safe }}
    </script>
    <script type="application/ld+json">
{{ {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": uiTitle,
      "item": ("/zh/" if isZh else "/") | absoluteUrl(book.site_url)
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "课程表" if isZh else "Syllabus",
      "item": ("/zh/syllabus/" if isZh else "/syllabus/") | absoluteUrl(book.site_url)
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": title,
      "item": canonicalUrl
    }
  ]
} | json | safe }}
    </script>
    {% elif not isWebIndex %}
    <script type="application/ld+json">
{{ {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": uiTitle,
      "item": ("/zh/" if isZh else "/") | absoluteUrl(book.site_url)
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": title or uiTitle,
      "item": canonicalUrl
    }
  ]
} | json | safe }}
    </script>
    {% endif %}
  </head>
  <body>
    <a class="skip-link" href="#content">{{ "跳到正文" if isZh else "Skip to content" }}</a>
    <header class="site-topbar">
      <div class="topbar-row">
        <a class="course" href="{{ "/zh/" if isZh else "/" }}"><img class="brand-mark" src="{{ '/assets/images/brand/180-descent-icon-96.png' | assetUrl }}" width="28" height="28" alt="" decoding="async">{{ uiTitle }}</a>
        <nav class="topnav" aria-label="{{ "主导航" if isZh else "Primary" }}">
          <a href="{{ "/zh/introduction/" if isZh else "/introduction/" }}">{{ "引言" if isZh else "Intro" }}</a>
          <a href="{{ "/zh/syllabus/" if isZh else "/syllabus/" }}">{{ "课程表" if isZh else "Syllabus" }}</a>
          <a href="{{ "/zh/downloads/" if isZh else "/downloads/" }}">{{ "下载" if isZh else "Downloads" }}</a>
        </nav>
        <div class="top-actions">
          {% if languageUrl %}
          <a class="toggle" href="{{ languageUrl }}" aria-label="{{ "切换到英文" if isZh else "切换到中文" }}">{{ "EN" if isZh else "中文" }}</a>
          {% endif %}
          <button class="toggle theme-toggle" id="themeBtn" type="button" aria-label="{{ "切换明暗主题" if isZh else "Toggle light or dark theme" }}">
            <svg class="theme-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2"></path>
              <path d="M12 20v2"></path>
              <path d="m4.93 4.93 1.41 1.41"></path>
              <path d="m17.66 17.66 1.41 1.41"></path>
              <path d="M2 12h2"></path>
              <path d="M20 12h2"></path>
              <path d="m6.34 17.66-1.41 1.41"></path>
              <path d="m19.07 4.93-1.41 1.41"></path>
            </svg>
            <svg class="theme-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>
    <main id="content">
      {{ content | safe }}
    </main>
    <footer class="site-footer">
      <div class="wrap wide footer-grid">
        <p><strong>{{ uiTitle }}</strong><br>{{ uiSubtitle }}<br>{% if isZh %}作者：{{ book.zh.authors }}<br>翻译：{{ book.zh.translators }}{% else %}By {{ book.authors }}{% endif %}</p>
        {% if isWebIndex %}
        <p><strong>{{ "人工编辑" if isZh else "Human editor" }}</strong><br><a href="{{ "https://jasonlau.io/cn/" if isZh else "https://jasonlau.io" }}">{{ "刘家昌" if isZh else "Jason Lau" }}</a></p>
        {% endif %}
        <p><a href="{{ book.repo }}">GitHub</a><br><a href="{{ "/zh/downloads/" if isZh else "/downloads/" }}">{{ "EPUB 与 PDF 下载" if isZh else "EPUB and PDF downloads" }}</a><br><a href="{{ "/zh/credits/" if isZh else "/credits/" }}">{{ "鸣谢" if isZh else "Credits" }}</a></p>
      </div>
    </footer>
  </body>
</html>
