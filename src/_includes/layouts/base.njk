{% set isZh = locale == "zh" %}
{% set uiTitle = book.zh.title if isZh else book.title %}
{% set uiSubtitle = book.zh.subtitle if isZh else book.subtitle %}
{% set uiDescription = book.zh.description if isZh else book.description %}
{% set isWebIndex = page.url == "/" or page.url == "/zh/" %}
{% if hide_language_toggle %}
  {% set languageUrl = "" %}
{% elif day_path %}
  {% set languageUrl = "/days/" + day_path + "/" if isZh else "/zh/days/" + day_path + "/" %}
{% else %}
  {% set languageUrl = alternate_url or ("/" if isZh else "/zh/") %}
{% endif %}
<!doctype html>
<html lang="{{ book.zh.language if isZh else book.language }}" data-theme="auto">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <title>{% if title %}{{ title }} · {% endif %}{{ uiTitle }}</title>
    <meta name="description" content="{{ description or uiDescription }}">
    <script>
      (function(){
        try{
          var theme = window.localStorage && window.localStorage.getItem("180-descent-theme");
          if(theme === "light" || theme === "dark"){
            document.documentElement.setAttribute("data-theme", theme);
          }
        }catch(error){}
      })();
    </script>
    <link rel="stylesheet" href="{{ '/assets/css/book.css' | assetUrl }}">
    <script src="{{ '/assets/js/book.js' | assetUrl }}" defer></script>
    {% for script in scripts or [] %}
      <script src="{{ script | assetUrl }}" defer></script>
    {% endfor %}
  </head>
  <body>
    <a class="skip-link" href="#content">{{ "跳到正文" if isZh else "Skip to content" }}</a>
    <header class="site-topbar">
      <div class="topbar-row">
        <a class="course" href="{{ "/zh/" if isZh else "/" }}"><span class="dot"></span>{{ uiTitle }}</a>
        <nav class="topnav" aria-label="{{ "主导航" if isZh else "Primary" }}">
          <a href="{{ "/zh/introduction/" if isZh else "/introduction/" }}">{{ "引言" if isZh else "Intro" }}</a>
          <a href="{{ "/zh/syllabus/" if isZh else "/syllabus/" }}">{{ "课程表" if isZh else "Syllabus" }}</a>
          <a href="{{ "/zh/downloads/" if isZh else "/downloads/" }}">{{ "下载" if isZh else "Downloads" }}</a>
        </nav>
        <div class="top-actions">
          {% if languageUrl %}
          <a class="toggle" href="{{ languageUrl }}" aria-label="{{ "切换到英文" if isZh else "切换到中文" }}">{{ "EN" if isZh else "中文" }}</a>
          {% endif %}
          <button class="toggle theme-toggle" id="themeBtn" type="button" aria-label="{{ "切换明暗主题" if isZh else "Toggle light or dark theme" }}">
            <svg class="theme-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2"></path>
              <path d="M12 20v2"></path>
              <path d="m4.93 4.93 1.41 1.41"></path>
              <path d="m17.66 17.66 1.41 1.41"></path>
              <path d="M2 12h2"></path>
              <path d="M20 12h2"></path>
              <path d="m6.34 17.66-1.41 1.41"></path>
              <path d="m19.07 4.93-1.41 1.41"></path>
            </svg>
            <svg class="theme-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>
    <main id="content">
      {{ content | safe }}
    </main>
    <footer class="site-footer">
      <div class="wrap wide footer-grid">
        <p><strong>{{ uiTitle }}</strong><br>{{ uiSubtitle }}<br>{% if isZh %}作者：{{ book.zh.authors }}<br>翻译：{{ book.zh.translators }}{% else %}By {{ book.authors }}{% endif %}</p>
        {% if isWebIndex %}
        <p><strong>{{ "人工编辑" if isZh else "Human editor" }}</strong><br><a href="{{ "https://jasonlau.io/cn/" if isZh else "https://jasonlau.io" }}">{{ "刘家昌" if isZh else "Jason Lau" }}</a></p>
        {% endif %}
        <p><a href="{{ book.repo }}">GitHub</a><br><a href="{{ "/zh/downloads/" if isZh else "/downloads/" }}">{{ "EPUB 与 PDF 下载" if isZh else "EPUB and PDF downloads" }}</a><br><a href="{{ "/zh/credits/" if isZh else "/credits/" }}">{{ "鸣谢" if isZh else "Credits" }}</a></p>
      </div>
    </footer>
  </body>
</html>
