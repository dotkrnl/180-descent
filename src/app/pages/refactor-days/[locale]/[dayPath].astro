---
import path from "node:path";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import AstroShell from "@app/layouts/AstroShell.astro";
import { listRegistryDayLocaleEntries, loadContentRegistry, type RegistryDayLocaleEntry } from "@lib/content";

type MdxModule = {
  default: AstroComponentFactory;
};

const mdxModules = import.meta.glob<MdxModule>("/tests/fixtures/content/days/**/*.mdx");

export async function getStaticPaths() {
  const fixtureDaysDir = path.join(process.cwd(), "tests/fixtures/content/days");
  const registry = await loadContentRegistry({ daysDir: fixtureDaysDir });

  return listRegistryDayLocaleEntries(registry).map((entry) => ({
    params: {
      locale: entry.locale,
      dayPath: entry.day.manifest.path
    },
    props: {
      entry
    }
  }));
}

const { entry } = Astro.props as { entry: RegistryDayLocaleEntry };
const modulePath = `/tests/fixtures/content/days/${entry.day.manifest.path}/${entry.body.path}`;
const loadBody = mdxModules[modulePath];

if (!loadBody) {
  throw new Error(`Missing MDX module for ${modulePath}`);
}

const Body = (await loadBody()).default;
---
<AstroShell title={`${entry.title} · Refactor Fixture`}>
  <article>
    <p>Day {entry.day.manifest.day} · {entry.day.manifest.block} · {entry.locale}</p>
    <h1>{entry.title}</h1>
    <p>{entry.summary}</p>
    <Body />
  </article>
</AstroShell>
