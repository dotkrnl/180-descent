---
import "../../assets/scss/book.scss";
import { getBookData } from "@app/site-data";
import type { Locale } from "@lib/schemas/day";

interface Props {
  title: string;
  locale: Locale;
  includeDeepDive: boolean;
}

const book = await getBookData();
const { title, locale, includeDeepDive } = Astro.props;
const isZh = locale === "zh";
---
<!doctype html>
<html lang={isZh ? book.zh.language : book.language} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#f5f3ec" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <title>{title} · {isZh ? book.zh.title : book.title}</title>
  </head>
  <body class:list={["print-document", { "include-deep-dive": includeDeepDive }]}>
    <slot />
  </body>
</html>
