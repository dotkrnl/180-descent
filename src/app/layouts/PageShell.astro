---
import BookShell from "@app/layouts/BookShell.astro";
import type { PageKind } from "@app/page-kind";
import { getBookData } from "@app/site-data";
import type { Locale } from "@lib/schemas/day";

interface Props {
  locale: Locale;
  pageKind: Exclude<PageKind, "home" | "lesson">;
  title: string;
  subtitle?: string;
  eyebrow?: string;
  description: string;
  canonicalPath: string;
  alternatePath?: string;
}

const book = await getBookData();
const { locale, pageKind, title, subtitle, eyebrow, description, canonicalPath, alternatePath } = Astro.props;
const isZh = locale === "zh";
const folioLabels = {
  syllabus: isZh ? "路线 / 001—180" : "Route / 001—180",
  downloads: isZh ? "便携版本 / 04" : "Field editions / 04",
  credits: isZh ? "来源档案 / 开放许可" : "Source register / Open licenses",
  introduction: isZh ? "起始坐标 / 000" : "Starting coordinates / 000",
  page: isZh ? "研究图册" : "Research atlas"
};
---
<BookShell
  title={title}
  description={description}
  locale={locale}
  pageKind={pageKind}
  canonicalPath={canonicalPath}
  alternatePath={alternatePath}
>
  <article class:list={["page", "wrap", "atlas-page", `atlas-page--${pageKind}`]}>
    <header class="page-hero atlas-page-hero">
      <p class="atlas-folio" aria-hidden="true">
        <span>{folioLabels[pageKind]}</span>
        <i></i>
      </p>
      <div class="atlas-page-title">
        <p class="eyebrow">{eyebrow ?? (isZh ? book.zh.subtitle : book.subtitle)}</p>
        <h1>{title}</h1>
        {subtitle && <p class="sub">{subtitle}</p>}
      </div>
    </header>
    <slot />
  </article>
</BookShell>
