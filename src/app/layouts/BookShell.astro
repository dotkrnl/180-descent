---
import { getBookData } from "@app/site-data";
import "../../assets/scss/book.scss";
import bookScriptUrl from "../../assets/js/book.js?url";
import brandLight from "../../assets/images/brand/180-descent-icon-96.png";
import brandDark from "../../assets/images/brand/180-descent-icon-dark-96.png";
import faviconLight from "../../assets/images/brand/favicon-32.png";
import faviconDark from "../../assets/images/brand/favicon-32-dark.png";
import appleTouchIcon from "../../assets/images/brand/apple-touch-icon.png";
import { bookSocialImagePath } from "@lib/assets/social-images";
import { homeUrl, staticPageUrl } from "@lib/static-site/routes";
import { SITE_THEME_COLORS } from "@app/theme-colors";

interface Props {
  title?: string;
  description?: string;
  locale: "en" | "zh";
  canonicalPath: string;
  alternatePath?: string;
  scripts?: string[];
  socialImagePath?: string;
  releaseBanner?: boolean;
}

const book = await getBookData();
const socialImageAssets = Object.fromEntries(
  Object.entries(import.meta.glob<string>("../../assets/images/social/*.png", {
    eager: true,
    import: "default",
    query: "?url"
  })).map(([modulePath, imagePath]) => [
    `/assets/images/social/${modulePath.split("/").pop()}`,
    imagePath
  ])
);
const { title, description, locale, canonicalPath, alternatePath, scripts = [], socialImagePath, releaseBanner = false } = Astro.props;
const isZh = locale === "zh";
const uiTitle = isZh ? book.zh.title : book.title;
const uiSubtitle = isZh ? book.zh.subtitle : book.subtitle;
const uiDescription = isZh ? book.zh.description : book.description;
const humanEditor = isZh ? book.zh.humanEditor : book.humanEditor;
const [linkedHumanEditor, ...plainHumanEditors] = humanEditor.shortName.split(/\s+and\s+|\s+与\s+/u);
const pageTitle = title ? `${title} · ${uiTitle}` : uiTitle;
const metaDescription = description ?? uiDescription;
const canonicalUrl = new URL(canonicalPath, book.siteUrl).href;
const alternateUrl = alternatePath ? new URL(alternatePath, book.siteUrl).href : undefined;
const enUrl = alternateUrl ? (isZh ? alternateUrl : canonicalUrl) : undefined;
const zhUrl = alternateUrl ? (isZh ? canonicalUrl : alternateUrl) : undefined;
const requestedSocialImagePath = socialImagePath ?? bookSocialImagePath(locale);
const socialAssetPath = socialImageAssets[requestedSocialImagePath];
if (!socialAssetPath) {
  throw new Error(`Missing social image asset: ${requestedSocialImagePath}`);
}
const socialImageUrl = new URL(socialAssetPath, book.siteUrl).href;
const homePath = homeUrl(locale);
const introUrl = staticPageUrl(locale, "introduction");
const syllabusUrl = staticPageUrl(locale, "syllabus");
const downloadsUrl = staticPageUrl(locale, "downloads");
const creditsUrl = staticPageUrl(locale, "credits");
const currentPath = Astro.url.pathname;
const pageKind = currentPath === homePath
  ? "home"
  : currentPath.includes("/days/")
    ? "lesson"
    : currentPath.includes("/syllabus")
      ? "syllabus"
      : currentPath.includes("/downloads")
        ? "downloads"
        : currentPath.includes("/credits")
          ? "credits"
          : currentPath.includes("/introduction")
            ? "introduction"
            : "page";
const { light: lightThemeColor, dark: darkThemeColor } = SITE_THEME_COLORS;
const structuredData = {
  "@context": "https://schema.org",
  "@type": title ? "WebPage" : "WebSite",
  "name": pageTitle,
  "url": canonicalUrl,
  "description": metaDescription,
  "inLanguage": isZh ? book.zh.language : book.language,
  "publisher": {
    "@type": "Organization",
    "name": book.publisher
  }
};
---
<!doctype html>
<html class="atlas-root" lang={isZh ? book.zh.language : book.language} data-theme="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta id="colorScheme" name="color-scheme" content="light dark" />
    <meta id="themeColorLight" name="theme-color" content={lightThemeColor} media="(prefers-color-scheme: light)" data-theme-color={lightThemeColor} />
    <meta id="themeColorDark" name="theme-color" content={darkThemeColor} media="(prefers-color-scheme: dark)" data-theme-color={darkThemeColor} />
    <script is:inline>
      (function(){
        try{
          var stored = window.localStorage && window.localStorage.getItem("180-descent-theme");
          var selection = stored === "light" || stored === "dark" ? stored : "auto";
          document.documentElement.setAttribute("data-theme", selection);
          if(selection !== "auto"){
            var colorScheme = document.getElementById("colorScheme");
            var lightMeta = document.getElementById("themeColorLight");
            var darkMeta = document.getElementById("themeColorDark");
            var selectedMeta = selection === "dark" ? darkMeta : lightMeta;
            var unselectedMeta = selection === "dark" ? lightMeta : darkMeta;
            var color = selectedMeta && selectedMeta.getAttribute("data-theme-color");
            if(colorScheme) colorScheme.setAttribute("content", selection);
            if(selectedMeta){
              selectedMeta.setAttribute("content", color || "");
              selectedMeta.setAttribute("media", "all");
            }
            if(unselectedMeta){
              unselectedMeta.setAttribute("content", color || "");
              unselectedMeta.setAttribute("media", "not all");
            }
          }
        }catch{}
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="robots" content="index, follow" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link id="themeFavicon" rel="icon" type="image/png" sizes="32x32" href={faviconLight.src} data-light-href={faviconLight.src} data-dark-href={faviconDark.src} />
    <link rel="apple-touch-icon" sizes="180x180" href={appleTouchIcon.src} />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalUrl} />
    {alternateUrl && enUrl && zhUrl && (
      <>
        <link rel="alternate" hreflang={book.language} href={enUrl} />
        <link rel="alternate" hreflang={book.zh.language} href={zhUrl} />
        <link rel="alternate" hreflang="x-default" href={enUrl} />
      </>
    )}
    <meta property="og:type" content={title ? "article" : "website"} />
    <meta property="og:site_name" content={uiTitle} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={isZh ? "zh_CN" : "en_US"} />
    {alternateUrl && <meta property="og:locale:alternate" content={isZh ? "en_US" : "zh_CN"} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <script src={bookScriptUrl} defer></script>
    {scripts.map((script) => <script src={script} defer></script>)}
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class:list={["atlas-shell", `page-${pageKind}`, { "locale-zh": isZh }]}>
    <a class="skip-link" href="#content">{isZh ? "跳到正文" : "Skip to content"}</a>
    <header class="site-topbar">
      <div class="topbar-row">
        <a class="course" href={homePath}>
          <span class="brand-mark-shell" aria-hidden="true">
            <img class="brand-mark brand-mark-light" src={brandLight.src} width="28" height="28" alt="" decoding="async" />
            <img class="brand-mark brand-mark-dark" src={brandDark.src} width="28" height="28" alt="" decoding="async" />
          </span>
          <span class="course-title">{uiTitle}</span>
          <span class="course-index" aria-hidden="true">001—180</span>
        </a>
        <p class="running-head" id="runningHead" aria-hidden="true">
          <span class="running-block" data-running-block></span>
          <span class="running-day" data-running-day></span>
          <span class="running-title" data-running-title></span>
          <span class="running-progress" data-running-progress></span>
        </p>
        <nav class="topnav" aria-label={isZh ? "主导航" : "Primary"}>
          <a href={introUrl} aria-current={currentPath === introUrl ? "page" : undefined}><span class="topnav-index" aria-hidden="true">01</span><span>{isZh ? "引言" : "Intro"}</span></a>
          <a href={syllabusUrl} aria-current={currentPath === syllabusUrl ? "page" : undefined}><span class="topnav-index" aria-hidden="true">02</span><span>{isZh ? "课程表" : "Syllabus"}</span></a>
          <a href={downloadsUrl} aria-current={currentPath === downloadsUrl ? "page" : undefined}><span class="topnav-index" aria-hidden="true">03</span><span>{isZh ? "下载" : "Downloads"}</span></a>
        </nav>
        <div class="top-actions">
          {alternatePath && (
            <a class="toggle" href={alternatePath} hreflang={isZh ? book.language : book.zh.language} lang={isZh ? book.language : book.zh.language} aria-label={isZh ? "EN，切换到英文" : "中文, Switch to Chinese"}>
              {isZh ? "EN" : "中文"}
            </a>
          )}
          <button class="toggle theme-toggle" id="themeBtn" type="button" aria-pressed="false" aria-label={isZh ? "切换到深色主题" : "Switch to dark theme"} data-label-dark={isZh ? "切换到深色主题" : "Switch to dark theme"} data-label-light={isZh ? "切换到浅色主题" : "Switch to light theme"}>
            <svg class="theme-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2"></path>
              <path d="M12 20v2"></path>
              <path d="m4.93 4.93 1.41 1.41"></path>
              <path d="m17.66 17.66 1.41 1.41"></path>
              <path d="M2 12h2"></path>
              <path d="M20 12h2"></path>
              <path d="m6.34 17.66-1.41 1.41"></path>
              <path d="m19.07 4.93-1.41 1.41"></path>
            </svg>
            <svg class="theme-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>
    {releaseBanner && (
      <aside class="release-banner" aria-label={isZh ? "发布说明" : "Release note"}>
        <div class="wrap wide">
          <strong>{isZh ? "发布说明" : "Release note"}</strong>
          <span>{isZh ? "新内容不一定每天更新。人工编辑有时会暂停发布，以便手动检查内容质量；最新发布版本也可能仍有尚未完成审阅的粗糙之处。" : "New content may not arrive every day. The human editor sometimes pauses publishing to manually check quality, and the latest release may still have sharp edges that the human has not finished reviewing yet."}</span>
        </div>
      </aside>
    )}
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap wide footer-grid">
        <p class="footer-colophon">
          <span class="footer-coordinate" aria-hidden="true">{isZh ? "知识图谱 · 001—180" : "Field atlas · 001—180"}</span>
          <strong>{uiTitle}</strong><br />
          {uiSubtitle}<br />
          {isZh ? `作者：${book.zh.authors}` : `By ${book.authors}`}
          <br />
          {isZh ? "人工编辑" : "Human editor"}<br />
          <a href={humanEditor.url}>{linkedHumanEditor}</a>{plainHumanEditors.length > 0 ? ` ${isZh ? "与" : "and"} ${plainHumanEditors.join(isZh ? "与" : " and ")}` : null}
        </p>
        <p class="footer-links"><a href={book.repo}>GitHub</a><br /><a href={downloadsUrl}>{isZh ? "EPUB 与 PDF 下载" : "EPUB and PDF downloads"}</a><br /><a href={creditsUrl}>{isZh ? "鸣谢" : "Credits"}</a></p>
      </div>
    </footer>
  </body>
</html>
