---
import PageShell from "@app/layouts/PageShell.astro";
import { getBookData } from "@app/site-data";
import type { Locale } from "@lib/schemas/day";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const book = await getBookData();
const isZh = locale === "zh";
const downloads = isZh ? book.zh.downloads : book.downloads;
---
<PageShell
  locale={locale}
  title={isZh ? "下载" : "Downloads"}
  subtitle={isZh ? "同一份地图，不同的形式。" : "One map, different forms."}
  eyebrow={isZh ? "格式" : "Formats"}
  description={isZh ? "选择精简的标准版，或收录专题附录的深入版；两者均提供 EPUB 与 PDF。" : "Choose a concise standard edition or the appendix-rich deep-dive edition in EPUB or PDF format."}
  canonicalPath={isZh ? "/zh/downloads/" : "/downloads/"}
  alternatePath={isZh ? "/downloads/" : "/zh/downloads/"}
>
  <div class="download-grid downloads-list">
    <article class="download-card">
      <p class="card-kicker">{isZh ? "EPUB" : "Standard EPUB"}</p>
      <h2><a href={downloads.epub}>{isZh ? "标准电子书版" : "Standard ebook edition"}</a></h2>
      <p>{isZh ? "适合各类电子阅读器与阅读应用，收录 180 天主线课程内容，不包含专题附录。" : "For ebook readers and reading apps. Contains the core 180-day lesson sequence without the optional research appendices."}</p>
    </article>
    <article class="download-card">
      <p class="card-kicker">{isZh ? "PDF" : "Standard PDF"}</p>
      <h2><a href={downloads.pdf}>{isZh ? "标准 PDF 版" : "Standard print edition"}</a></h2>
      <p>{isZh ? "便于打印、离线阅读与逐页批注；内容与标准电子书版一致，未收录专题附录。" : "A fixed-layout, print-friendly copy of the core lessons, tuned for paging, citations, and offline reading."}</p>
    </article>
    <article class="download-card">
      <p class="card-kicker">{isZh ? "EPUB · 专题深入版" : "Deep Dive EPUB"}</p>
      <h2><a href={downloads.deepEpub}>{isZh ? "专题深入电子书版" : "Deep-dive ebook edition"}</a></h2>
      <p>{isZh ? "在标准内容基础上增设每日专题附录，提供更丰富的背景知识与实例解析。" : "The ebook reader version with each day's optional appendix included for fuller context, extra examples, and source notes."}</p>
    </article>
    <article class="download-card">
      <p class="card-kicker">{isZh ? "PDF · 专题深入版" : "Deep Dive PDF"}</p>
      <h2><a href={downloads.deepPdf}>{isZh ? "专题深入 PDF 版" : "Deep-dive print edition"}</a></h2>
      <p>{isZh ? "完整收录全部专题附录，适合系统学习、打印存档与长期查阅。" : "The complete print-ready edition with deep-dive appendices included, best for offline study, annotation, or reference."}</p>
    </article>
  </div>
</PageShell>
