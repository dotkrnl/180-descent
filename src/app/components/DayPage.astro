---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import BookShell from "@app/layouts/BookShell.astro";
import DayNav from "@app/components/DayNav.astro";
import type { DayAppendixRenderEntry, RegistryDayRouteProps } from "@app/day-route";
import { getBookData, getSyllabus } from "@app/site-data";
import { dayArtifactDownloadUrl } from "@lib/artifacts/downloads";
import { daySocialImagePath } from "@lib/assets/social-images";
import { alternateLocale, dayUrl } from "@lib/static-site/routes";

interface Props extends RegistryDayRouteProps {
  Body: AstroComponentFactory;
  appendices: DayAppendixRenderEntry[];
}

const interactionScriptModules = Object.fromEntries(
  Object.entries(import.meta.glob<string>("../../assets/js/interactions/*.js", {
    eager: true,
    import: "default",
    query: "?url"
  })).map(([modulePath, script]) => {
    const entry = modulePath.split("/").pop()?.replace(/\.js$/, "");
    if (!entry) throw new Error(`Invalid interaction script path: ${modulePath}`);
    return [entry, script];
  })
);

const { entry, previous, next, Body, appendices } = Astro.props;
const book = await getBookData();
const syllabus = await getSyllabus(entry.locale);
const isZh = entry.locale === "zh";
const blockIndex = Math.max(0, syllabus.blocks.findIndex(
  (block) => entry.day.manifest.day >= block.startDay && entry.day.manifest.day <= block.endDay
));
// The descent hue: Block I sits at surface teal (200), the final block at
// abyssal violet (300). Resolved to a color by the block-scope tokens.
const blockHue = Math.round(200 + (blockIndex * 100) / Math.max(1, syllabus.blocks.length - 1));
const dayPath = entry.day.manifest.path;
const canonicalPath = dayUrl(entry.locale, dayPath);
const alternatePath = dayUrl(alternateLocale(entry.locale), dayPath);
const dayEpubUrl = dayArtifactDownloadUrl("epub", entry.locale, dayPath);
const dayPdfUrl = dayArtifactDownloadUrl("pdf", entry.locale, dayPath);
const socialImagePath = daySocialImagePath(entry.locale, dayPath);
const paddedDay = String(entry.day.manifest.day).padStart(3, "0");
const dayLabel = isZh ? `第${paddedDay}日` : `Day ${paddedDay}`;
const remainingDays = book.totalDays - entry.day.manifest.day;
const scripts = entry.day.manifest.interactionScripts.map((entryName) => {
  const script = interactionScriptModules[entryName];
  if (!script) {
    throw new Error(`Missing interaction script for ${entryName}`);
  }
  return script;
});
---
<BookShell title={entry.title} description={entry.summary} locale={entry.locale} pageKind="lesson" canonicalPath={canonicalPath} alternatePath={alternatePath} socialImagePath={socialImagePath} scripts={scripts}>
  <article
    class="lesson block-scope"
    style={`--block-hue:${blockHue}`}
    data-day={entry.day.manifest.day}
    data-block-hue={blockHue}
    data-running-day={dayLabel}
    data-running-block={syllabus.blocks[blockIndex]?.title ?? ""}
    data-total-days={book.totalDays}
    data-reading-progress
    data-reading-locale={entry.locale}
    data-reading-day={entry.day.manifest.day}
    data-reading-url={canonicalPath}
    data-reading-label={`${dayLabel} · ${entry.title}`}
    data-reading-title={entry.title}
    data-reading-summary={entry.summary}
  >
    <div class="download-strip">
      <div class="wrap wide">
          <span>{isZh ? "下载本日课程：" : "Download this day:"}</span>
        <a href={dayEpubUrl}>EPUB</a>
        <a href={dayPdfUrl}>PDF</a>
      </div>
    </div>
    {!next && (
      <aside class="latest-day-banner" aria-label={isZh ? "最新日课" : "Latest day"}>
        <div class="wrap wide">
          <strong>{isZh ? "最新日课" : "Latest day"}</strong>
          <span>{isZh ? "这是目前最新发布的课程，人工编辑可能尚未完成全部审阅；较早的课程通常已经过更多轮手工检查。" : "This is the latest released day, so it may still have sharp edges that the human editor has not finished reviewing yet. Earlier days have usually had more manual quality checks."}</span>
        </div>
      </aside>
    )}
    <DayNav locale={entry.locale} previous={previous} next={next} position="top" />
    <button class="rail-backdrop" type="button" data-rail-backdrop tabindex="-1" aria-label={isZh ? "关闭目录" : "Close contents"} hidden></button>
    <div class="lesson-stage">
      <aside class="lesson-rail" id="lessonRail" data-lesson-rail aria-label={isZh ? "阅读进度与本页目录" : "Reading progress and page contents"}>
        <div class="rail-depth" aria-hidden="true">
          <div class="rail-gauge"><div class="rail-gauge-fill" data-rail-gauge></div></div>
          <span class="rail-day">{dayLabel}</span>
          <span class="rail-depth-read" data-rail-read></span>
        </div>
        <nav class="rail-toc" data-rail-toc-nav aria-label={isZh ? "本页目录" : "On this page"} hidden>
          <p class="rail-toc-title">{isZh ? "本页目录" : "On this page"}</p>
          <ol data-rail-toc></ol>
        </nav>
      </aside>
      <div class="lesson-reading">
        <Body />
        <div class="wrap lesson-appendices">
          {appendices.map(({ id, title, Body: AppendixBody }) => (
            <details class="deep-dive" id={id}>
              <summary>
                <span class="ptitle">{isZh ? "专题深入附录" : "Deep dive appendix"}</span>
                <span class="deep-dive-title">{title}</span>
                <span class="deep-dive-sub">{isZh ? "选读内容。" : "Optional extension."}</span>
              </summary>
              <div class="deep-dive-body">
                <AppendixBody />
              </div>
            </details>
          ))}
          <p class="endcap">
            {isZh ? `第 ${paddedDay} 日终 · ` : `End of Day ${paddedDay} · `}
            <span class="gleam">{isZh ? `尚有 ${remainingDays} 日课程` : `${remainingDays} descents remain`}</span>
          </p>
        </div>
      </div>
    </div>
    <DayNav locale={entry.locale} previous={previous} next={next} position="bottom" />
  </article>
</BookShell>
