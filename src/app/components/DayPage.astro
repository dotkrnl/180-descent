---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import BookShell from "@app/layouts/BookShell.astro";
import { getBookData } from "@app/site-data";
import { dayArtifactDownloadUrl } from "@lib/artifacts/downloads";
import type { RegistryDayLocaleEntry } from "@lib/content/registry";
import { alternateLocale, dayUrl, staticPageUrl } from "@lib/static-site/routes";

interface AppendixRenderEntry {
  id: string;
  title: string;
  Body: AstroComponentFactory;
}

interface DayNavEntry {
  day: number;
  path: string;
  title: string;
}

interface Props {
  entry: RegistryDayLocaleEntry;
  previous?: DayNavEntry;
  next?: DayNavEntry;
  Body: AstroComponentFactory;
  appendices: AppendixRenderEntry[];
}

const interactionScriptModules = Object.fromEntries(
  Object.entries(import.meta.glob<string>("../../assets/js/interactions/*.js", {
    eager: true,
    import: "default",
    query: "?url"
  })).map(([modulePath, script]) => {
    const entry = modulePath.split("/").pop()?.replace(/\.js$/, "");
    if (!entry) throw new Error(`Invalid interaction script path: ${modulePath}`);
    return [entry, script];
  })
) as Record<string, string>;

const { entry, previous, next, Body, appendices } = Astro.props;
const book = await getBookData();
const isZh = entry.locale === "zh";
const dayPath = entry.day.manifest.path;
const canonicalPath = dayUrl(entry.locale, dayPath);
const alternatePath = dayUrl(alternateLocale(entry.locale), dayPath);
const dayEpubUrl = dayArtifactDownloadUrl("epub", entry.locale, dayPath);
const dayPdfUrl = dayArtifactDownloadUrl("pdf", entry.locale, dayPath);
const socialImagePath = isZh ? `/assets/images/social/zh-day-${dayPath}.png` : `/assets/images/social/day-${dayPath}.png`;
const paddedDay = String(entry.day.manifest.day).padStart(3, "0");
const dayLabel = isZh ? `第${paddedDay}日` : `Day ${paddedDay}`;
const remainingDays = book.totalDays - entry.day.manifest.day;
const navDayLabel = (day: number) => {
  const value = String(day).padStart(3, "0");
  return isZh ? `第${value}日` : `Day ${value}`;
};
const navHref = (item: DayNavEntry) => dayUrl(entry.locale, item.path);
const scripts = entry.day.manifest.interactionScripts.map((entryName) => {
  const script = interactionScriptModules[entryName];
  if (!script) {
    throw new Error(`Missing interaction script for ${entryName}`);
  }
  return script;
});
---
<BookShell title={entry.title} description={entry.summary} locale={entry.locale} canonicalPath={canonicalPath} alternatePath={alternatePath} socialImagePath={socialImagePath} scripts={scripts}>
  <article
    class="lesson"
    data-day={entry.day.manifest.day}
    data-reading-progress
    data-reading-locale={entry.locale}
    data-reading-day={entry.day.manifest.day}
    data-reading-url={canonicalPath}
    data-reading-label={`${dayLabel} · ${entry.title}`}
    data-reading-title={entry.title}
    data-reading-summary={entry.summary}
  >
    <div class="download-strip">
      <div class="wrap wide">
        <span>{isZh ? "下载本日：" : "Download this day:"}</span>
        <a href={dayEpubUrl}>EPUB</a>
        <a href={dayPdfUrl}>PDF</a>
      </div>
    </div>
    {!next && (
      <aside class="latest-day-banner" aria-label={isZh ? "最新日课" : "Latest day"}>
        <div class="wrap wide">
          <strong>{isZh ? "最新日课" : "Latest day"}</strong>
          <span>{isZh ? "这是当前最新发布的日课，可能仍有人工编辑尚未完成审阅的粗糙之处。较早日课通常已经经过更多手动质量检查。" : "This is the latest released day, so it may still have sharp edges that the human editor has not finished reviewing yet. Earlier days have usually had more manual quality checks."}</span>
        </div>
      </aside>
    )}
    <nav class="lesson-nav lesson-nav-top wrap wide" aria-label={isZh ? "日课导航（顶部）" : "Top day navigation"}>
      {previous ? (
        <a class="lesson-nav-card" href={navHref(previous)}>
          <span>{isZh ? "上一篇" : "Previous"}</span>
          <strong>{navDayLabel(previous.day)} · {previous.title}</strong>
        </a>
      ) : (
        <span class="lesson-nav-card is-disabled">
          <span>{isZh ? "上一篇" : "Previous"}</span>
          <strong>{isZh ? "全书起点" : "Start of the book"}</strong>
        </span>
      )}
      <a class="lesson-nav-card is-syllabus" href={staticPageUrl(entry.locale, "syllabus")}>
        <span>{isZh ? "课程表" : "Map"}</span>
        <strong>{isZh ? "完整课程表" : "Full syllabus"}</strong>
      </a>
      {next ? (
        <a class="lesson-nav-card" href={navHref(next)}>
          <span>{isZh ? "下一篇" : "Next"}</span>
          <strong>{navDayLabel(next.day)} · {next.title}</strong>
        </a>
      ) : (
        <span class="lesson-nav-card is-disabled">
          <span>{isZh ? "下一篇" : "Next"}</span>
          <strong>{isZh ? "尚未发布" : "Not published yet"}</strong>
        </span>
      )}
    </nav>
    <Body />
    <div class="wrap">
      {appendices.map(({ id, title, Body: AppendixBody }) => (
        <details class="deep-dive" id={id}>
          <summary>
            <span class="ptitle">{isZh ? "专题深入附录" : "Deep dive appendix"}</span>
            <span class="deep-dive-title">{title}</span>
            <span class="deep-dive-sub">{isZh ? "可选延伸阅读。" : "Optional extension."}</span>
          </summary>
          <div class="deep-dive-body">
            <AppendixBody />
          </div>
        </details>
      ))}
      <p class="endcap">
        {isZh ? `第 ${paddedDay} 日终 · ` : `End of Day ${paddedDay} · `}
        <span class="gleam">{isZh ? `还有 ${remainingDays} 日等待深入` : `${remainingDays} descents remain`}</span>
      </p>
    </div>
    <nav class="lesson-nav lesson-nav-bottom wrap wide" aria-label={isZh ? "日课导航（底部）" : "Bottom day navigation"}>
      {previous ? (
        <a class="lesson-nav-card" href={navHref(previous)}>
          <span>{isZh ? "上一篇" : "Previous"}</span>
          <strong>{navDayLabel(previous.day)} · {previous.title}</strong>
        </a>
      ) : (
        <span class="lesson-nav-card is-disabled">
          <span>{isZh ? "上一篇" : "Previous"}</span>
          <strong>{isZh ? "全书起点" : "Start of the book"}</strong>
        </span>
      )}
      <a class="lesson-nav-card is-syllabus" href={staticPageUrl(entry.locale, "syllabus")}>
        <span>{isZh ? "课程表" : "Map"}</span>
        <strong>{isZh ? "完整课程表" : "Full syllabus"}</strong>
      </a>
      {next ? (
        <a class="lesson-nav-card" href={navHref(next)}>
          <span>{isZh ? "下一篇" : "Next"}</span>
          <strong>{navDayLabel(next.day)} · {next.title}</strong>
        </a>
      ) : (
        <span class="lesson-nav-card is-disabled">
          <span>{isZh ? "下一篇" : "Next"}</span>
          <strong>{isZh ? "尚未发布" : "Not published yet"}</strong>
        </span>
      )}
    </nav>
  </article>
</BookShell>
