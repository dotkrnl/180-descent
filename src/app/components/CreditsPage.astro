---
import PageShell from "@app/layouts/PageShell.astro";
import { getCreditsData } from "@app/site-data";
import type { Locale } from "@lib/schemas/day";
import { alternateLocale, staticPageUrl } from "@lib/static-site/routes";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const credits = await getCreditsData();
const isZh = locale === "zh";
const sourceLabel = isZh ? "来源" : "source";

function isWebUrl(value: string): boolean {
  try {
    const url = new URL(value);
    return url.protocol === "http:" || url.protocol === "https:";
  } catch {
    return false;
  }
}

// Split the flat images list into project marks (self-generated brand assets)
// vs cited images (public-domain, CC-licensed diagrams and historical photos)
// so brand items don't get typographically flattened with third-party sources.
const projectImages = credits.images.filter((image) => /project[- ]owned/i.test(image.license));
const citedImages = credits.images.filter((image) => !/project[- ]owned/i.test(image.license));
---
<PageShell
  locale={locale}
  pageKind="credits"
  title={isZh ? "致谢与许可" : "Credits"}
  subtitle={isZh ? "随附资源的许可协议与来源信息。" : "Licenses and source attribution for bundled assets."}
  eyebrow={isZh ? "来源与许可" : "Attribution"}
  description={isZh ? "字体与图片素材的许可和来源信息。" : "Credits for fonts and assets."}
  canonicalPath={staticPageUrl(locale, "credits")}
  alternatePath={staticPageUrl(alternateLocale(locale), "credits")}
>
  <div class="credits-register">
    <section class="credit-section" aria-labelledby="font-credits-title">
      <header class="credit-section-head">
        <p class="progress-label">{isZh ? "字体档案" : "Type archive"}</p>
        <h2 id="font-credits-title">{isZh ? "字体" : "Fonts"}</h2>
        <span>{String(credits.fonts.length).padStart(2, "0")}</span>
      </header>
      <ol class="credit-list">
        {credits.fonts.map((font, index) => (
          <li>
            <span class="credit-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <strong>{font.name}</strong>
            <span class="credit-detail">{font.license}</span>
            <span class="credit-source">{isWebUrl(font.source) ? <a href={font.source}>{sourceLabel}</a> : font.source}</span>
          </li>
        ))}
      </ol>
    </section>

    {projectImages.length > 0 && (
      <section class="credit-section credit-section--project" aria-labelledby="project-marks-title">
        <header class="credit-section-head">
          <p class="progress-label">{isZh ? "项目自有素材" : "Project marks"}</p>
          <h2 id="project-marks-title">{isZh ? "本站生成图像" : "In-house imagery"}</h2>
          <span>{String(projectImages.length).padStart(2, "0")}</span>
        </header>
        <ol class="credit-list credit-list--images">
          {projectImages.map((image, index) => (
            <li>
              <span class="credit-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <strong>{image.title}</strong>
              <span class="credit-detail">{isZh ? "作者：" : "By "}{image.creator}{isZh ? "；" : " · "}{image.license}{isZh ? "。" : ". "}{image.notes}</span>
              <span class="credit-source">{isWebUrl(image.source) ? <a href={image.source}>{sourceLabel}</a> : image.source}</span>
            </li>
          ))}
        </ol>
      </section>
    )}

    {citedImages.length > 0 && (
      <section class="credit-section" aria-labelledby="image-credits-title">
        <header class="credit-section-head">
          <p class="progress-label">{isZh ? "引用图像" : "Cited images"}</p>
          <h2 id="image-credits-title">{isZh ? "外部来源" : "Third-party sources"}</h2>
          <span>{String(citedImages.length).padStart(2, "0")}</span>
        </header>
        <ol class="credit-list credit-list--images">
          {citedImages.map((image, index) => (
            <li>
              <span class="credit-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <strong>{image.title}</strong>
              <span class="credit-detail">{isZh ? "作者：" : "By "}{image.creator}{isZh ? "；" : " · "}{image.license}{isZh ? "。" : ". "}{image.notes}</span>
              <span class="credit-source">{isWebUrl(image.source) ? <a href={image.source}>{sourceLabel}</a> : image.source}</span>
            </li>
          ))}
        </ol>
      </section>
    )}
  </div>
</PageShell>
