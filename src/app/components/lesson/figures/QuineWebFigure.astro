---
import type { Locale } from "@lib/schemas/day";

interface Props {
  locale: Locale;
}

const locale = Astro.props.locale;
const zh = locale === "zh";
const gradientId = `quine-web-gradient-${locale}`;
const strikeMarkerId = `quine-web-strike-${locale}`;
const copy = zh
  ? {
      aria: "奎因的信念之网：经验打击外缘；逻辑位于受保护的中心。",
      core: ["逻辑、", "数学"],
      protected: "↑ 深层、受良好保护",
      experience: "经验",
      edge: "边缘：观察报告"
    }
  : {
      aria: "Quine's web of belief: experience strikes the outer edge; logic sits protected at the center.",
      core: ["logic,", "math"],
      protected: "↑ deep, well-protected",
      experience: "experience",
      edge: "edge: observation reports"
    };
---
<div class="quine-web-figure">
  <svg viewBox="0 0 320 260" role="img" aria-label={copy.aria}>
    <defs>
      <radialGradient id={gradientId} cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.22"></stop>
        <stop offset="100%" stop-color="var(--accent)" stop-opacity="0"></stop>
      </radialGradient>
    </defs>
    <circle cx="160" cy="130" r="120" fill={`url(#${gradientId})`} stroke="var(--line-strong)" stroke-width="1"></circle>
    <circle cx="160" cy="130" r="80" fill="none" stroke="var(--line)" stroke-width="1" stroke-dasharray="2 4"></circle>
    <circle cx="160" cy="130" r="40" fill="none" stroke="var(--line)" stroke-width="1" stroke-dasharray="2 4"></circle>
    <g stroke="var(--line-strong)" stroke-width="0.8" opacity="0.6">
      <line x1="160" y1="10" x2="160" y2="250"></line>
      <line x1="40" y1="130" x2="280" y2="130"></line>
      <line x1="75" y1="45" x2="245" y2="215"></line>
      <line x1="245" y1="45" x2="75" y2="215"></line>
    </g>
    <circle cx="160" cy="130" r="34" fill="var(--raised)" stroke="var(--accent)" stroke-width="1.5"></circle>
    <text x="160" y="128" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="10.5" fill="var(--ink)">{copy.core[0]}</text>
    <text x="160" y="138" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="10.5" fill="var(--ink)">{copy.core[1]}</text>
    <rect x={zh ? "70" : "62"} y="157" width={zh ? "180" : "196"} height="22" rx="7" fill="var(--paper)" fill-opacity="0.92" stroke="var(--line)" stroke-width=".8"></rect>
    <text x="160" y="170" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="10.5" fill="var(--ink-faint)">{copy.protected}</text>
    <g stroke="var(--contested)" stroke-width="2">
      <line x1="300" y1="60" x2="270" y2="85" marker-end={`url(#${strikeMarkerId})`}></line>
    </g>
    <text x="250" y="46" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="10.5" fill="var(--contested)">{copy.experience}</text>
    <text x="250" y="250" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="10.5" fill="var(--ink-faint)">{copy.edge}</text>
    <defs>
      <marker id={strikeMarkerId} markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L9,4.5 L0,9 z" fill="var(--contested)"></path></marker>
    </defs>
  </svg>
</div>
