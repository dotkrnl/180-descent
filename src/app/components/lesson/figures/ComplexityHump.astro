---
interface Props {
  locale?: "en" | "zh";
}

const zh = Astro.props.locale === "zh";
---
<figure class="complexity-hump">
  <svg viewBox="0 0 520 320" role="img" aria-label={zh ? "一条中间高、两端低的复杂性曲线：完美秩序和完美随机都复杂性低，中间最高。" : "A hump-shaped curve peaking in the middle: complexity is low for both perfect order and perfect randomness, and high in between."}>
    <line x1="56" y1="270" x2="496" y2="270" class="hump-axis"></line>
    <line x1="56" y1="270" x2="56" y2="40" class="hump-axis"></line>
    <text x="276" y="305" text-anchor="middle" class="hump-label">{zh ? "无序 / 熵 ->" : "disorder / entropy ->"}</text>
    <text x="30" y="155" text-anchor="middle" class="hump-label" transform="rotate(-90 30 155)">{zh ? "复杂性" : "complexity"}</text>
    <path d="M56,268 C150,255 196,70 276,70 C356,70 402,255 496,268" class="hump-line"></path>
    <path d="M56,268 C150,255 196,70 276,70 C356,70 402,255 496,268 L496,270 L56,270 Z" class="hump-fill"></path>
    <circle cx="80" cy="262" r="5" class="hump-dot side"></circle>
    <text x="82" y="260" text-anchor="middle" class="hump-name">{zh ? "晶体" : "crystal"}</text>
    <text x="146" y="198" text-anchor="middle" class="hump-small">{zh ? "过于有序" : "too ordered"}</text>
    <circle cx="276" cy="70" r="6" class="hump-dot peak"></circle>
    <text x="276" y="64" text-anchor="middle" class="hump-name">{zh ? "活细胞" : "a living cell"}</text>
    <text x="276" y="12" text-anchor="middle" class="hump-small">{zh ? "有结构且出人意料" : "structured + surprising"}</text>
    <circle cx="472" cy="262" r="5" class="hump-dot side"></circle>
    <text x="472" y="260" text-anchor="middle" class="hump-name">{zh ? "气体" : "gas"}</text>
    <text x="402" y="198" text-anchor="middle" class="hump-small">{zh ? "过于随机" : "too random"}</text>
    <line x1="276" y1="76" x2="276" y2="270" class="hump-drop"></line>
  </svg>
</figure>
