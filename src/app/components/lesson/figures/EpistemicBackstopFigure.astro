---
import type { Locale } from "@lib/schemas/day";

interface Props {
  locale: Locale;
}

const zh = Astro.props.locale === "zh";
const copy = zh
  ? {
      aria: "证言依靠在可能存在的录音录像后盾之上，而深度伪造移除了这一后盾。",
      testimony: "证言",
      testimonySub: "「相信我的说法」",
      honestBy: "由……约束",
      backstop: "后盾：可能存在录音录像",
      deepfakes: "深度伪造",
      footer: "移除横梁，上方的地板就会下陷",
      italic: false
    }
  : {
      aria: "Testimony resting on a backstop of possible recordings, which deepfakes remove.",
      testimony: "testimony",
      testimonySub: "\"trust my say-so\"",
      honestBy: "checked by…",
      backstop: "backstop: a recording could exist",
      deepfakes: "deepfakes",
      footer: "remove the beam, and the floor above it sags",
      italic: true
    };
---
<div class="epistemic-backstop-figure">
  <svg viewBox="0 0 520 180" role="img" aria-label={copy.aria}>
    <rect x="180" y="20" width="160" height="44" rx="9" fill="color-mix(in srgb,var(--accent) 12%,transparent)" stroke="var(--accent)" stroke-width="2"></rect>
    <text x="260" y="40" text-anchor="middle" font-family="Fraunces,serif" font-size="13" fill="var(--ink)">{copy.testimony}</text>
    <text x="260" y="55" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="10.5" fill="var(--ink-faint)">{copy.testimonySub}</text>
    <line x1="260" y1="64" x2="260" y2="96" stroke="var(--ink-faint)" stroke-width="1.5" stroke-dasharray="3 4"></line>
    <text x="300" y="84" text-anchor="start" font-family="Newsreader,serif" font-style={copy.italic ? "italic" : undefined} font-size="10.5" fill="var(--ink-soft)">{copy.honestBy}</text>
    <rect x="150" y="100" width="220" height="40" rx="9" fill="var(--paper)" stroke="var(--brass)" stroke-width="1.6"></rect>
    <text x="260" y="124" text-anchor="middle" font-family="Fraunces,serif" font-size="12" fill="var(--ink)">{copy.backstop}</text>
    <g stroke="var(--contested)" stroke-width="2.4">
      <line x1="392" y1="104" x2="430" y2="136"></line>
      <line x1="430" y1="104" x2="392" y2="136"></line>
    </g>
    <text x="412" y="154" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="10.5" fill="var(--contested)">{copy.deepfakes}</text>
    <text x="260" y="166" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="10.5" fill="var(--brass)">{copy.footer}</text>
  </svg>
</div>
