---
interface Props {
  locale?: "en" | "zh";
}

const zh = Astro.props.locale === "zh";
const copy = zh ? {
  aria: "一张有序图：同一份数据经过多个看似合理的分析选择，生成许多设定，其中一个显著结果被选择性报告。",
  title: "分岔路径花园",
  subtitle: "同一份数据，多套合理的分析设定，一个诱人的标题",
  dataset: "同一数据",
  noise: "只有噪声",
  choices: "合理选择",
  rows: [["离群值", "保留 / 剔除"], ["协变量", "无 / W"], ["尺度", "原始 / 秩"], ["样本", "全部 / 子组"]],
  results: "报告结果",
  branch: "最终报告的分支",
  caption: "分岔路径花园。数据只有噪声；分支一多，就很容易冒出一条看似「发现」的路径。真正的危险，是看过数据后再决定走哪条路。"
} : {
  aria: "An organized diagram showing one dataset, several defensible analysis choices, many resulting specifications, and one selectively reported significant result.",
  title: "THE GARDEN OF FORKING PATHS",
  subtitle: "same data, many defensible specifications, one tempting headline",
  dataset: "same dataset",
  noise: "noise only",
  choices: "reasonable choices",
  rows: [["outliers", "keep / trim"], ["covariate", "none / W"], ["scale", "raw / rank"], ["sample", "all / subset"]],
  results: "reported results",
  branch: "reported branch",
  caption: 'The garden of forking paths. The data are pure noise — yet enough branches guarantee one ends in a "discovery." The danger is choosing after the data points the way.'
};
---
<figure class="hero-fig forking-paths">
  <svg viewBox="0 0 640 320" role="img" aria-label={copy.aria}>
    <defs>
      <marker id="garden-arrow" markerWidth="9" markerHeight="9" refX="7.5" refY="4.5" orient="auto"><path d="M0,0 L9,4.5 L0,9 z" fill="var(--line-strong)"></path></marker>
    </defs>
    <rect x="8" y="10" width="624" height="284" rx="8" fill="var(--raised)" stroke="var(--line)"></rect>
    <g font-family="IBM Plex Mono,monospace">
      <text x="32" y="42" font-size="12" letter-spacing="1.6" fill="var(--accent)">{copy.title}</text>
      <text x="32" y="66" font-size="11" fill="var(--ink-faint)">{copy.subtitle}</text>
      <rect x="32" y="102" width="128" height="100" rx="8" fill="var(--paper)" stroke="var(--accent)" stroke-width="2"></rect>
      <text x="96" y="128" text-anchor="middle" font-size="13" font-weight="700" fill="var(--ink)">{copy.dataset}</text>
      <text x="96" y="148" text-anchor="middle" font-size="11" fill="var(--ink-faint)">{copy.noise}</text>
      <line x1="62" y1="177" x2="130" y2="177" stroke="var(--line-strong)" stroke-width="1.4"></line>
      <circle cx="70" cy="169" r="3" fill="var(--accent)"></circle>
      <circle cx="88" cy="182" r="3" fill="var(--ink-faint)"></circle>
      <circle cx="106" cy="172" r="3" fill="var(--accent)"></circle>
      <circle cx="124" cy="184" r="3" fill="var(--ink-faint)"></circle>
      <line x1="168" y1="152" x2="210" y2="152" stroke="var(--line-strong)" stroke-width="2" marker-end="url(#garden-arrow)"></line>
      <rect x="218" y="82" width="218" height="150" rx="8" fill="var(--paper)" stroke="var(--line-strong)" stroke-width="1.5"></rect>
      <text x="327" y="108" text-anchor="middle" font-size="12" font-weight="700" fill="var(--ink)">{copy.choices}</text>
      <g font-size="10.5">
        {copy.rows.map(([left, right], index) => (
          <>
            <text x="240" y={134 + index * 24} fill="var(--ink-soft)">{left}</text>
            <text x="338" y={134 + index * 24} fill="var(--ink-faint)">{right}</text>
          </>
        ))}
      </g>
      <line x1="240" y1="143" x2="416" y2="143" stroke="var(--line)" stroke-width="1"></line>
      <line x1="240" y1="167" x2="416" y2="167" stroke="var(--line)" stroke-width="1"></line>
      <line x1="240" y1="191" x2="416" y2="191" stroke="var(--line)" stroke-width="1"></line>
      <line x1="444" y1="152" x2="456" y2="152" stroke="var(--line-strong)" stroke-width="2" marker-end="url(#garden-arrow)"></line>
      <rect x="464" y="82" width="144" height="150" rx="8" fill="var(--paper)" stroke="var(--line-strong)" stroke-width="1.5"></rect>
      <text x="536" y="108" text-anchor="middle" font-size="12" font-weight="700" fill="var(--ink)">{copy.results}</text>
      <rect x="484" y="122" width="104" height="26" rx="6" fill="color-mix(in srgb,var(--contested) 12%,var(--paper))" stroke="var(--contested)" stroke-width="1.8"></rect>
      <text x="536" y="140" text-anchor="middle" font-size="12" font-weight="700" fill="var(--contested)">p = .03</text>
      <text x="536" y="165" text-anchor="middle" font-size="11" fill="var(--ink-faint)">p = .61</text>
      <text x="536" y="187" text-anchor="middle" font-size="11" fill="var(--ink-faint)">p = .44</text>
      <text x="536" y="209" text-anchor="middle" font-size="11" fill="var(--ink-faint)">p = .78</text>
      <rect x="450" y="246" width="172" height="28" rx="6" fill="color-mix(in srgb,var(--contested) 10%,var(--raised))" stroke="var(--contested)"></rect>
      <text x="536" y="265" text-anchor="middle" font-size="11" font-weight="700" fill="var(--contested)">{copy.branch}</text>
    </g>
  </svg>
  <figcaption>{copy.caption}</figcaption>
</figure>
