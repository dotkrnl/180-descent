---
interface Props {
  locale?: "en" | "zh";
}

type DagKind = "fork" | "chain" | "collider";

const zh = Astro.props.locale === "zh";
const copy = zh ? {
  aria: "三个具体 DAG 示例：叉形结构、链形结构和对撞结构。",
  cards: {
    fork: {
      aria: "叉形 DAG：夏季同时导致冰淇淋购买和溺水。",
      labels: ["夏季", "冰淇淋", "溺水"],
      title: "叉形 / 混杂",
      body: "夏季同时改变暴露与结果。比较前先对夏季取条件。"
    },
    chain: {
      aria: "链形 DAG：吸烟导致焦油，焦油导致癌症。",
      labels: ["吸烟", "焦油", "癌症"],
      title: "链形 / 中介",
      body: "焦油承载吸烟的部分效应。对焦油取条件会改变问题。"
    },
    collider: {
      aria: "对撞 DAG：能力与运气共同导致录取。",
      labels: ["能力", "运气", "录取"],
      title: "对撞结构",
      body: "能力与运气在录取处相遇。对录取取条件会诱发非因果关联。"
    }
  }
} : {
  aria: "Concrete DAG examples: a fork, a chain, and a collider.",
  cards: {
    fork: {
      aria: "Fork DAG: summer causes both ice-cream buying and drowning.",
      labels: ["Summer", "Ice cream", "Drowning"],
      title: "Fork / confounder",
      body: "Summer changes both exposure and outcome. Condition on summer before comparing."
    },
    chain: {
      aria: "Chain DAG: smoking causes tar, and tar causes cancer.",
      labels: ["Smoking", "Tar", "Cancer"],
      title: "Chain / mediator",
      body: "Tar carries part of smoking's effect. Conditioning on tar changes the question."
    },
    collider: {
      aria: "Collider DAG: skill and luck both cause admission.",
      labels: ["Skill", "Luck", "Admission"],
      title: "Collider",
      body: "Skill and luck meet at admission. Conditioning on admission induces a noncausal association."
    }
  }
} satisfies {
  aria: string;
  cards: Record<DagKind, { aria: string; labels: string[]; title: string; body: string }>;
};

const kinds: DagKind[] = ["fork", "chain", "collider"];
---
<div class="dag-examples" role="group" aria-label={copy.aria}>
  {kinds.map((kind) => {
    const card = copy.cards[kind];

    return (
      <figure class="dag-card">
        {kind === "fork" && (
          <svg viewBox="0 0 220 150" role="img" aria-label={card.aria}>
            <rect x="72" y="14" width="76" height="24" rx="5" fill="var(--paper)" stroke="var(--line)"></rect>
            <text x="110" y="30" text-anchor="middle" font-size="10.5" fill="var(--ink)">{card.labels[0]}</text>
            <rect x="22" y="112" width="72" height="24" rx="5" fill="var(--paper)" stroke="var(--line)"></rect>
            <text x="58" y="128" text-anchor="middle" font-size="10.5" fill="var(--ink)">{card.labels[1]}</text>
            <rect x="126" y="112" width="72" height="24" rx="5" fill="var(--paper)" stroke="var(--line)"></rect>
            <text x="162" y="128" text-anchor="middle" font-size="10.5" fill="var(--ink)">{card.labels[2]}</text>
            <g fill="var(--ink-soft)" stroke="var(--ink-soft)" stroke-width="2.1" stroke-linecap="round">
              <line x1="92" y1="40" x2="63.2" y2="101.2"></line>
              <path d="M60 108 L59.8 99.6 L66.6 102.8 Z" stroke="none"></path>
              <line x1="128" y1="40" x2="156.8" y2="101.2"></line>
              <path d="M160 108 L153.4 102.8 L160.2 99.6 Z" stroke="none"></path>
            </g>
          </svg>
        )}
        {kind === "chain" && (
          <svg viewBox="0 0 220 150" role="img" aria-label={card.aria}>
            <rect x="14" y="62" width="60" height="26" rx="5" fill="var(--paper)" stroke="var(--line)"></rect>
            <text x="44" y="79" text-anchor="middle" font-size="10.5" fill="var(--ink)">{card.labels[0]}</text>
            <rect x="96" y="62" width="44" height="26" rx="5" fill="var(--paper)" stroke="var(--line)"></rect>
            <text x="118" y="79" text-anchor="middle" font-size="10.5" fill="var(--ink)">{card.labels[1]}</text>
            <rect x="162" y="62" width="52" height="26" rx="5" fill="var(--paper)" stroke="var(--line)"></rect>
            <text x="188" y="79" text-anchor="middle" font-size="10.5" fill="var(--ink)">{card.labels[2]}</text>
            <g fill="var(--ink-soft)" stroke="var(--ink-soft)" stroke-width="2.1" stroke-linecap="round">
              <line x1="76" y1="75" x2="86.5" y2="75"></line>
              <path d="M94 75 L86.5 71.2 L86.5 78.8 Z" stroke="none"></path>
              <line x1="142" y1="75" x2="152.5" y2="75"></line>
              <path d="M160 75 L152.5 71.2 L152.5 78.8 Z" stroke="none"></path>
            </g>
          </svg>
        )}
        {kind === "collider" && (
          <svg viewBox="0 0 220 150" role="img" aria-label={card.aria}>
            <rect x="30" y="14" width="56" height="24" rx="5" fill="var(--paper)" stroke="var(--line)"></rect>
            <text x="58" y="30" text-anchor="middle" font-size="10.5" fill="var(--ink)">{card.labels[0]}</text>
            <rect x="134" y="14" width="56" height="24" rx="5" fill="var(--paper)" stroke="var(--line)"></rect>
            <text x="162" y="30" text-anchor="middle" font-size="10.5" fill="var(--ink)">{card.labels[1]}</text>
            <rect x="76" y="112" width="68" height="24" rx="5" fill="var(--paper)" stroke="var(--line)"></rect>
            <text x="110" y="128" text-anchor="middle" font-size="10.5" fill="var(--ink)">{card.labels[2]}</text>
            <g fill="var(--ink-soft)" stroke="var(--ink-soft)" stroke-width="2.1" stroke-linecap="round">
              <line x1="66" y1="40" x2="96.6" y2="101.3"></line>
              <path d="M100 108 L93.3 103 L100 99.6 Z" stroke="none"></path>
              <line x1="154" y1="40" x2="123.4" y2="101.3"></line>
              <path d="M120 108 L120 99.6 L126.7 103 Z" stroke="none"></path>
            </g>
          </svg>
        )}
        <figcaption><b>{card.title}</b><span>{card.body}</span></figcaption>
      </figure>
    );
  })}
</div>
