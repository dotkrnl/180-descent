            <rect x="388" y={y - 17} width="234" height="39" rx="7" fill={paper} stroke={lightLine} />
            <text x="401" y={y + 7} font-family="IBM Plex Mono, monospace" font-size="11" font-weight="700" fill={accent}>{row[0]}</text>
            <text x="487" y={y + 7} font-family="Fraunces, serif" font-size="18" font-weight="700" fill={ink}>{row[1]}</text>
          </g>;
        })}
        <text x="175" y="324" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="12" fill={brass}>{zh ? "4 项带有不确定度" : "4 uncertain"}</text>
        <text x="504" y="324" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="12" fill={accent}>{zh ? "7 项精确" : "7 exact"}</text>
        <text x="340" y="382" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="11" fill={soft}>{zh ? "精确性没有增加 · 系统风险降低" : "no exactness was created · systemic risk fell"}</text>
      </g>
    )}

    {kind === "kibble-balance" && (
      <g>
        <line x1="92" y1="102" x2="444" y2="102" stroke={ink} stroke-width="4" stroke-linecap="round" />
        <polygon points="268,110 252,139 284,139" fill={faint} /><circle cx="268" cy="102" r="6" fill={ink} />
        <line x1="130" y1="102" x2="130" y2="220" stroke={soft} stroke-width="2" />
        <rect x="76" y="205" width="31" height="111" rx="3" fill={raised} stroke={line} /><rect x="153" y="205" width="31" height="111" rx="3" fill={raised} stroke={line} /><rect x="76" y="305" width="108" height="18" rx="3" fill={raised} stroke={line} />
        <rect x="111" y="234" width="38" height="26" rx="4" fill={raised} stroke={accent} stroke-width="3" />
        <text x="130" y="280" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={accent}>{zh ? "线圈 L" : "coil L"}</text>
        <text x="91" y="198" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={brass}>N</text><text x="169" y="198" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={brass}>S</text>
        <line x1="444" y1="102" x2="444" y2="195" stroke={soft} stroke-width="2" /><rect x="402" y="195" width="84" height="66" rx="8" fill={raised} stroke={line} stroke-width="2" /><text x="444" y="225" text-anchor="middle" font-family="Fraunces, serif" font-size="19" font-weight="700" fill={ink}>1 kg</text><text x="444" y="247" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={faint}>{zh ? "待测质量" : "test mass"}</text>
        <line x1="195" y1="260" x2="195" y2="205" stroke={accent} stroke-width="3" marker-end={`url(#day13-${kind}-arrow-accent)`} /><text x="210" y="217" font-family="IBM Plex Mono, monospace" font-size="12" font-weight="700" fill={accent}>BLI</text>
        <line x1="510" y1="194" x2="510" y2="252" stroke={contested} stroke-width="3" marker-end={`url(#day13-${kind}-arrow-red)`} /><text x="526" y="239" font-family="IBM Plex Mono, monospace" font-size="12" font-weight="700" fill={contested}>mg</text>
        <rect x="526" y="68" width="126" height="256" rx="11" fill={raised} stroke={lightLine} />
        <text x="589" y="99" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={faint}>{zh ? "称量模式" : "WEIGHING"}</text><text x="589" y="124" text-anchor="middle" font-family="Fraunces, serif" font-size="18" font-weight="700" fill={ink}>mg = BLI</text>
        <line x1="545" y1="145" x2="633" y2="145" stroke={lightLine} />
        <text x="589" y="174" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={faint}>{zh ? "速度模式" : "VELOCITY"}</text><text x="589" y="199" text-anchor="middle" font-family="Fraunces, serif" font-size="18" font-weight="700" fill={ink}>U = BLv</text>
        <line x1="545" y1="220" x2="633" y2="220" stroke={lightLine} />
        <text x="589" y="251" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={accent}>{zh ? "消去 BL" : "CANCEL BL"}</text><text x="589" y="280" text-anchor="middle" font-family="Fraunces, serif" font-size="20" font-weight="700" fill={accent}>mgv = UI</text>
        <text x="340" y="374" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="11" fill={soft}>{zh ? "机械功率 = 电功率" : "mechanical power = electrical power"}</text>
      </g>
    )}

    {kind === "alpha-drift" && (
      <g>
        <line x1="221" y1="346" x2="646" y2="346" stroke={faint} stroke-width="1.4" />
