---
interface Props {
  locale?: "en" | "zh";
}

const zh = Astro.props.locale === "zh";
const copy = zh
  ? {
      title: "复杂性与涌现主题图",
      desc: "图中下方三条局部规则：分离、对齐、凝聚，分别影响许多个体。个体只看附近邻居，但这些局部连接共同形成上方的整体鸟群波形。",
      local: "局部规则",
      global: "整体模式",
      separation: "分离",
      alignment: "对齐",
      cohesion: "凝聚",
      neighbor: "只看邻居",
      flock: "没有指挥者的鸟群",
      note: "简单零件 -> 全局秩序"
    }
  : {
      title: "Complexity and emergence hero figure",
      desc: "The diagram shows three local rules, separation, alignment, and cohesion, feeding many individual agents. Each agent sees only nearby neighbors, but their local connections form the global flock wave above.",
      local: "local rules",
      global: "global pattern",
      separation: "separation",
      alignment: "alignment",
      cohesion: "cohesion",
      neighbor: "neighbors only",
      flock: "flock without a conductor",
      note: "simple parts -> global order"
    };
---
<figure class="hero-art emergence-hero">
  <svg viewBox="0 0 360 220" role="img" aria-labelledby={zh ? "emergence-hero-title-zh emergence-hero-desc-zh" : "emergence-hero-title-en emergence-hero-desc-en"}>
    <title id={zh ? "emergence-hero-title-zh" : "emergence-hero-title-en"}>{copy.title}</title>
    <desc id={zh ? "emergence-hero-desc-zh" : "emergence-hero-desc-en"}>{copy.desc}</desc>
    <style>
      .emergence-hero-bg{fill:var(--raised,#fbfaf5);stroke:var(--line-strong,#cabfa8);stroke-width:1}
      .emergence-label,.emergence-caption,.emergence-annotation{font-family:"IBM Plex Mono",monospace;fill:var(--ink-faint,#5d6c72);letter-spacing:.08em}
      .emergence-label{font-size:10.5px;text-transform:uppercase}.emergence-label.end{text-anchor:end}
      .emergence-caption{font-size:10.5px;fill:var(--accent-deep,#13525a)}.emergence-annotation{font-family:"Fraunces",serif;font-size:13.5px;fill:var(--ink,#172530)}
      .emergence-annotation.small{font-family:"IBM Plex Mono",monospace;font-size:10.5px;fill:var(--ink-faint,#5d6c72);letter-spacing:.03em;text-transform:uppercase}
      .emergence-title-plate rect{fill:var(--paper,#f5f3ec);stroke:var(--line,#ddd7c8);stroke-width:1}
      .rule-card rect{fill:var(--paper,#f5f3ec);stroke:var(--line-strong,#cabfa8)}.rule-card text{font-family:"IBM Plex Mono",monospace;font-size:10.5px;fill:var(--ink,#172530);letter-spacing:0;text-anchor:middle}
      .rule-icon{fill:none;stroke:var(--accent,#1d6f78);stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}.rule-arrow{fill:none;stroke:var(--line-strong,#cabfa8);stroke-width:1.1;stroke-dasharray:3 4;opacity:.65}
      .emergence-arrow-head{fill:var(--line-strong,#cabfa8)}.neighbor-net path{fill:none;stroke:var(--line-strong,#cabfa8);stroke-width:1.2;opacity:.55}.neighbor-net circle{fill:var(--paper,#f5f3ec);stroke:var(--accent,#1d6f78);stroke-width:1.8}
      .boid-field path{fill:var(--ink,#172530);opacity:.78}.boid-field path:nth-child(3n){fill:var(--accent-deep,#13525a)}.boid-field path:nth-child(4n){fill:var(--brass,#93651f)}
      .flock-band{fill:url(#emergence-wave);opacity:.22}.flock-wave{fill:none;stroke:var(--accent-deep,#13525a);stroke-width:1.8;stroke-linecap:round}.flock-wave.lower{stroke:var(--brass,#93651f);stroke-width:1.2;opacity:.72}
    </style>
    <defs>
      <marker id="emergence-arrow" viewBox="0 0 6 6" refX="5" refY="3" markerWidth="4" markerHeight="4" orient="auto-start-reverse">
        <path d="M0 0L6 3L0 6Z" class="emergence-arrow-head"></path>
      </marker>
      <linearGradient id="emergence-wave" x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color="var(--accent)" stop-opacity=".22"></stop>
        <stop offset=".48" stop-color="var(--accent)" stop-opacity=".88"></stop>
        <stop offset="1" stop-color="var(--brass)" stop-opacity=".72"></stop>
      </linearGradient>
    </defs>

    <rect x="8" y="8" width="344" height="198" rx="14" class="emergence-hero-bg"></rect>

    <text x="20" y="31" class="emergence-label">{copy.local}</text>
    <text x="340" y="31" class="emergence-label end">{copy.global}</text>

    <path class="flock-wave" d="M32 70C66 36 98 44 132 64C168 86 200 86 236 58C272 31 315 40 336 72"></path>
    <path class="flock-wave lower" d="M32 112C66 90 100 92 134 108C171 126 205 126 240 103C275 82 316 86 336 111"></path>
    <path class="flock-band" d="M32 70C66 36 98 44 132 64C168 86 200 86 236 58C272 31 315 40 336 72L336 111C316 86 275 82 240 103C205 126 171 126 134 108C100 92 66 90 32 112Z"></path>

    <g class="boid-field">
      <path d="M70 68l11 4l-10 6z"></path>
      <path d="M104 55l11 4l-10 6z"></path>
      <path d="M139 73l11 4l-10 6z"></path>
      <path d="M178 62l11 4l-10 6z"></path>
      <path d="M219 75l11 4l-10 6z"></path>
      <path d="M260 57l11 4l-10 6z"></path>
      <path d="M298 72l11 4l-10 6z"></path>
    </g>

    <g class="neighbor-net">
      <path d="M65 116L96 101L129 116L166 102L202 116L240 101L282 118"></path>
      <path d="M96 101L166 102M129 116L202 116M202 116L282 118"></path>
      <circle cx="65" cy="116" r="3.3"></circle><circle cx="96" cy="101" r="3.3"></circle><circle cx="129" cy="116" r="3.3"></circle>
      <circle cx="166" cy="102" r="3.3"></circle><circle cx="202" cy="116" r="3.3"></circle><circle cx="240" cy="101" r="3.3"></circle><circle cx="282" cy="118" r="3.3"></circle>
    </g>

    <g class="emergence-title-plate">
      <rect x="92" y="44" width="176" height="23" rx="11.5"></rect>
      <text x="180" y="60" text-anchor="middle" class="emergence-annotation">{copy.flock}</text>
    </g>
    <text x="180" y="139" text-anchor="middle" class="emergence-annotation small">{copy.neighbor}</text>

    <path class="rule-arrow" d="M82 158C95 146 108 138 128 130" marker-end="url(#emergence-arrow)"></path>
    <path class="rule-arrow" d="M180 158C180 148 180 140 180 132" marker-end="url(#emergence-arrow)"></path>
    <path class="rule-arrow" d="M278 158C264 146 250 138 232 130" marker-end="url(#emergence-arrow)"></path>

    <g class="rule-card" transform="translate(20 158)">
      <rect width="104" height="33" rx="7"></rect>
      <path d="M16 17L31 10M16 17L31 24" class="rule-icon"></path>
      <text x="71" y="21">{copy.separation}</text>
    </g>
    <g class="rule-card" transform="translate(128 158)">
      <rect width="104" height="33" rx="7"></rect>
      <path d="M17 12H38M17 18H38M17 24H38" class="rule-icon"></path>
      <text x="72" y="21">{copy.alignment}</text>
    </g>
    <g class="rule-card" transform="translate(236 158)">
      <rect width="104" height="33" rx="7"></rect>
      <path d="M16 10L32 18L16 26M40 10L24 18L40 26" class="rule-icon"></path>
      <text x="73" y="21">{copy.cohesion}</text>
    </g>

    <text x="180" y="202" text-anchor="middle" class="emergence-caption">{copy.note}</text>
  </svg>
</figure>
