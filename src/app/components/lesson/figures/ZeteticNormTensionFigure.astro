---
import type { Locale } from "@lib/schemas/day";

interface Props {
  locale: Locale;
}

const zh = Astro.props.locale === "zh";
const beliefMarkerId = `zetetic-norm-belief-${Astro.props.locale}`;
const inquiryMarkerId = `zetetic-norm-inquiry-${Astro.props.locale}`;
const copy = zh
  ? {
      aria: "一位探究者在证据收集规范与聚焦问题规范之间被拉扯。",
      center: ["你，", "正在数窗户"],
      beliefTitle: "信念规范",
      beliefLines: ["相信证据所", "支持的任何内容"],
      inquiryTitle: "探究规范",
      inquiryLines: ["忽略干扰，", "回答问题"],
      footer: "顺从其中一个 → 违背另一个",
      italic: false
    }
  : {
      aria: "A single inquirer pulled between an evidence-gathering norm and a focus-on-the-question norm.",
      center: ["you,", "counting"],
      beliefTitle: "Belief norm",
      beliefLines: ["believe whatever", "evidence supports"],
      inquiryTitle: "Zetetic norm",
      inquiryLines: ["ignore the noise,", "answer the question"],
      footer: "conform to one → violate the other",
      italic: true
    };
---
<div class="zetetic-norm-tension-figure">
  <svg viewBox="0 0 520 200" role="img" aria-label={copy.aria}>
    <circle cx="260" cy="100" r="34" fill="color-mix(in srgb,var(--accent) 16%,transparent)" stroke="var(--accent)" stroke-width="2"></circle>
    <text x="260" y="96" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="10.5" fill="var(--ink)">{copy.center[0]}</text>
    <text x="260" y="108" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="10.5" fill="var(--ink)">{copy.center[1]}</text>
    <line x1="226" y1="100" x2="120" y2="100" stroke="var(--hint)" stroke-width="1.6" marker-end={`url(#${beliefMarkerId})`}></line>
    <line x1="294" y1="100" x2="400" y2="100" stroke="var(--accent)" stroke-width="1.6" marker-end={`url(#${inquiryMarkerId})`}></line>
    <defs>
      <marker id={beliefMarkerId} markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L9,4.5 L0,9 z" fill="var(--hint)"></path></marker>
      <marker id={inquiryMarkerId} markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L9,4.5 L0,9 z" fill="var(--accent)"></path></marker>
    </defs>
    <rect x="8" y="62" width="118" height="76" rx="8" fill="var(--paper)" stroke="var(--hint)" stroke-width="1.4"></rect>
    <text x="67" y="84" text-anchor="middle" font-family="Fraunces,serif" font-size="12" fill="var(--ink)">{copy.beliefTitle}</text>
    <text x="67" y="104" text-anchor="middle" font-family="Newsreader,serif" font-size="10.5" font-style={copy.italic ? "italic" : undefined} fill="var(--ink-soft)">{copy.beliefLines[0]}</text>
    <text x="67" y="118" text-anchor="middle" font-family="Newsreader,serif" font-size="10.5" font-style={copy.italic ? "italic" : undefined} fill="var(--ink-soft)">{copy.beliefLines[1]}</text>
    <rect x="394" y="62" width="118" height="76" rx="8" fill="var(--paper)" stroke="var(--accent)" stroke-width="1.4"></rect>
    <text x="453" y="84" text-anchor="middle" font-family="Fraunces,serif" font-size="12" fill="var(--ink)">{copy.inquiryTitle}</text>
    <text x="453" y="104" text-anchor="middle" font-family="Newsreader,serif" font-size="10.5" font-style={copy.italic ? "italic" : undefined} fill="var(--ink-soft)">{copy.inquiryLines[0]}</text>
    <text x="453" y="118" text-anchor="middle" font-family="Newsreader,serif" font-size="10.5" font-style={copy.italic ? "italic" : undefined} fill="var(--ink-soft)">{copy.inquiryLines[1]}</text>
    <text x="260" y="170" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="10.5" fill="var(--brass)">{copy.footer}</text>
  </svg>
</div>
