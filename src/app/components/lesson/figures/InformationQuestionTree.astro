---
import MathInline from "@app/components/lesson/MathInline.astro";

interface Props {
  locale?: "en" | "zh";
}

const zh = Astro.props.locale === "zh";
---
<figure class="hero-fig">
  <svg viewBox="0 0 520 230" role="img" aria-label={zh ? "一个是/否问题的分支树，将 16 种可能性逐次减半，最终锁定为一个。" : "A branching tree of yes/no questions halving 16 possibilities down to one."}>
    <defs>
      <marker id="hb" markerWidth="7" markerHeight="7" refX="5.5" refY="3.5" orient="auto"><path d="M0,0 L7,3.5 L0,7 z" fill="var(--ink-faint)"></path></marker>
    </defs>
    <g id="qtree">
      <g stroke="var(--line-strong)" stroke-width="1" fill="none">
        <line x1="40" y1="42" x2="160" y2="42" opacity="0.45"></line>
        <line x1="40" y1="52.3" x2="160" y2="42" opacity="0.45"></line>
        <line x1="40" y1="62.5" x2="160" y2="64" opacity="0.45"></line>
        <line x1="40" y1="72.8" x2="160" y2="64" opacity="0.45"></line>
        <line x1="40" y1="83.1" x2="160" y2="86" opacity="0.45"></line>
        <line x1="40" y1="93.3" x2="160" y2="86" opacity="0.45"></line>
        <line x1="40" y1="103.6" x2="160" y2="108" opacity="0.45"></line>
        <line x1="40" y1="113.9" x2="160" y2="108" opacity="0.45"></line>
        <line x1="40" y1="124.1" x2="160" y2="130" opacity="0.45"></line>
        <line x1="40" y1="134.4" x2="160" y2="130" opacity="0.45"></line>
        <line x1="40" y1="144.7" x2="160" y2="152" opacity="0.45"></line>
        <line x1="40" y1="154.9" x2="160" y2="152" opacity="0.45"></line>
        <line x1="40" y1="165.2" x2="160" y2="174" opacity="0.45"></line>
        <line x1="40" y1="175.5" x2="160" y2="174" opacity="0.45"></line>
        <line x1="40" y1="185.7" x2="160" y2="196" opacity="0.45"></line>
        <line x1="40" y1="196" x2="160" y2="196" opacity="0.45"></line>
        <line x1="160" y1="42" x2="280" y2="42" opacity="0.45"></line>
        <line x1="160" y1="64" x2="280" y2="42" opacity="0.45"></line>
        <line x1="160" y1="86" x2="280" y2="93.3" opacity="0.45"></line>
        <line x1="160" y1="108" x2="280" y2="93.3" opacity="0.45"></line>
        <line x1="160" y1="130" x2="280" y2="144.7" opacity="0.45"></line>
        <line x1="160" y1="152" x2="280" y2="144.7" opacity="0.45"></line>
        <line x1="160" y1="174" x2="280" y2="196" opacity="0.45"></line>
        <line x1="160" y1="196" x2="280" y2="196" opacity="0.45"></line>
        <line x1="280" y1="42" x2="400" y2="42" opacity="0.45"></line>
        <line x1="280" y1="93.3" x2="400" y2="42" opacity="0.45"></line>
        <line x1="280" y1="144.7" x2="400" y2="196" opacity="0.45"></line>
        <line x1="280" y1="196" x2="400" y2="196" opacity="0.45"></line>
        <line x1="400" y1="42" x2="486" y2="119" opacity="0.9"></line>
        <line x1="400" y1="196" x2="486" y2="119" opacity="0.9"></line>
      </g>
      <g fill="var(--accent)">
        <circle cx="40" cy="42" r="3.4"></circle>
        <circle cx="40" cy="52.3" r="3.4"></circle>
        <circle cx="40" cy="62.5" r="3.4"></circle>
        <circle cx="40" cy="72.8" r="3.4"></circle>
        <circle cx="40" cy="83.1" r="3.4"></circle>
        <circle cx="40" cy="93.3" r="3.4"></circle>
        <circle cx="40" cy="103.6" r="3.4"></circle>
        <circle cx="40" cy="113.9" r="3.4"></circle>
        <circle cx="40" cy="124.1" r="3.4"></circle>
        <circle cx="40" cy="134.4" r="3.4"></circle>
        <circle cx="40" cy="144.7" r="3.4"></circle>
        <circle cx="40" cy="154.9" r="3.4"></circle>
        <circle cx="40" cy="165.2" r="3.4"></circle>
        <circle cx="40" cy="175.5" r="3.4"></circle>
        <circle cx="40" cy="185.7" r="3.4"></circle>
        <circle cx="40" cy="196" r="3.4"></circle>
      </g>
      <g fill="color-mix(in srgb,var(--accent) 55%,transparent)">
        <circle cx="160" cy="42" r="3.4"></circle>
        <circle cx="160" cy="64" r="3.4"></circle>
        <circle cx="160" cy="86" r="3.4"></circle>
        <circle cx="160" cy="108" r="3.4"></circle>
        <circle cx="160" cy="130" r="3.4"></circle>
        <circle cx="160" cy="152" r="3.4"></circle>
        <circle cx="160" cy="174" r="3.4"></circle>
        <circle cx="160" cy="196" r="3.4"></circle>
        <circle cx="280" cy="42" r="3.4"></circle>
        <circle cx="280" cy="93.3" r="3.4"></circle>
        <circle cx="280" cy="144.7" r="3.4"></circle>
        <circle cx="280" cy="196" r="3.4"></circle>
        <circle cx="400" cy="42" r="3.4"></circle>
        <circle cx="400" cy="196" r="3.4"></circle>
      </g>
      <circle cx="486" cy="119" r="6" fill="var(--brass)" stroke="var(--raised)" stroke-width="2"></circle>
    </g>
    <g font-family="IBM Plex Mono,monospace" font-size="10.5" fill="var(--ink-faint)" text-anchor="middle">
      <text x="40" y="222">16</text>
      <text x="160" y="222">8</text>
      <text x="280" y="222">4</text>
      <text x="400" y="222">2</text>
      <text x="486" y="222">1</text>
    </g>
    <g font-family="IBM Plex Mono,monospace" font-size="10.5" fill="var(--accent)" text-anchor="middle" letter-spacing="0.05em">
      <text x="100" y="20">Q1</text>
      <text x="220" y="20">Q2</text>
      <text x="340" y="20">Q3</text>
      <text x="443" y="20">Q4</text>
    </g>
  </svg>
  {zh ? (
    <figcaption>四个好问题即可锁定 16 种可能中的一种。<MathInline latex={String.raw`\log_2 16 = 4`} /> 比特。</figcaption>
  ) : (
    <figcaption>Four good questions pin down one of sixteen things. <MathInline latex={String.raw`\log_2 16 = 4`} /> bits.</figcaption>
  )}
</figure>
