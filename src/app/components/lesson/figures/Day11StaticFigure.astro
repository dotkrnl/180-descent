          return (
            <g>
              <line x1={mark.x.toFixed(1)} y1={mark.y.toFixed(1)} x2={mark.x.toFixed(1)} y2={samplingY0} stroke={brass} stroke-width="1.2" stroke-dasharray="4 4"></line>
