  { label: copy.darts.biased, x: 256, points: [[26, -19], [31, -22], [23, -15], [28, -12], [21, -23]], fill: contested },
  { label: copy.darts.noisy, x: 408, points: [[-41, -8], [28, 31], [7, -39], [-19, 28], [34, -20]], fill: brass },
  { label: copy.darts.both, x: 560, points: [[5, -51], [61, -9], [28, 37], [74, 21], [41, -35]], fill: accent }
];

const samplingNMax = 40;
const samplingX0 = 76;
const samplingX1 = 566;
const samplingY0 = 246;
const samplingY1 = 76;
const samplingYMax = 28;

function erf(x: number): number {
  const sign = x < 0 ? -1 : 1;
  const ax = Math.abs(x);
  const t = 1 / (1 + 0.3275911 * ax);
  const y = 1 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * Math.exp(-ax * ax);
  return sign * y;
}

function phi(z: number): number {
  return 0.5 * (1 + erf(z / Math.SQRT2));
}

function samplingRateAt(n: number): number {
  const gap = 0.25 - 0.18;
  const sd = Math.SQRT2 * 0.165 / Math.sqrt(n);
  return 100 * phi(-gap / sd);
}

function samplingX(n: number): number {
  return samplingX0 + ((n - 1) / (samplingNMax - 1)) * (samplingX1 - samplingX0);
}

function samplingY(rate: number): number {
  return samplingY0 - (rate / samplingYMax) * (samplingY0 - samplingY1);
}

const samplingRates = Array.from({ length: samplingNMax }, (_, index) => samplingRateAt(index + 1));
const samplingPath = samplingRates.map((rate, index) => {
  const n = index + 1;
  return `${index ? "L" : "M"}${samplingX(n).toFixed(1)},${samplingY(rate).toFixed(1)}`;
}).join(" ");

const samplingMarks = [2, 8, 24].map((n) => {
  const rate = samplingRateAt(n);
  return { n, rate, x: samplingX(n), y: samplingY(rate) };
});

