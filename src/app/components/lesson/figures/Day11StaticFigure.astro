        {[0, 14, 28].map((tick) => {
          const y = samplingY(tick);
          return (
            <g>
              <line x1={samplingX0} y1={y.toFixed(1)} x2={samplingX1} y2={y.toFixed(1)} stroke={line} stroke-width=".8"></line>
