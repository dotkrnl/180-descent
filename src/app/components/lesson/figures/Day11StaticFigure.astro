];

const prospectAlpha = 0.88;
const prospectLambda = 2.25;
const prospectXMid = 310;
const prospectYMid = 182;
const prospectXScale = 2.45;
const prospectYScale = 1.25;

function prospectValue(x: number): number {
  return x >= 0 ? x ** prospectAlpha : -prospectLambda * ((-x) ** prospectAlpha);
}

function prospectPoint(x: number): { x: number; y: number } {
  return {
    x: prospectXMid + x * prospectXScale,
    y: prospectYMid - prospectValue(x) * prospectYScale
  };
}

function prospectPath(from: number, to: number): string {
  const out: string[] = [];
  for (let x = from; x <= to; x += 4) {
    const p = prospectPoint(x);
    out.push(`${out.length ? "L" : "M"}${p.x.toFixed(1)},${p.y.toFixed(1)}`);
  }
  return out.join(" ");
}

const prospectGain = prospectPoint(50);
const prospectLoss = prospectPoint(-50);

const dartBoards = [
