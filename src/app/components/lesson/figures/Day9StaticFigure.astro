---
interface Props {
  kind:
    | "thermostat"
    | "governor"
    | "loops"
    | "bathtub-errors"
    | "thresholds"
    | "deep-loops"
    | "ashby"
    | "cybersyn"
    | "resilience"
    | "tipping-types"
    | "cliff"
    | "timeline";
  locale?: "en" | "zh";
}

const kind = Astro.props.kind;
const zh = Astro.props.locale === "zh";

const ink = "var(--ink, #172530)";
const soft = "var(--ink-soft, #41545d)";
const faint = "var(--ink-faint, #64747b)";
const line = "var(--line, #cfc4ad)";
const lineStrong = "var(--line-strong, #a99570)";
const paper = "var(--paper, #f5f3ec)";
const raised = "var(--raised, #fbfaf5)";
const accent = "var(--accent, #1d6f78)";
const accentDeep = "var(--accent-deep, #13525a)";
const brass = "var(--brass, #93651f)";
const ok = "var(--ok, #2a704a)";
const warn = "var(--hint, #b76636)";
const danger = "var(--heat, #a8442d)";

const copy = {
  thermostat: zh
    ? { title: "恒温器反馈环", set: "设定 21° · 当前 18°", tag: "感知 → 比较 → 修正 → 再次感知", cap: "恒温器：一台廉价机器，能守住一个目标，抵抗世界的拉扯。" }
    : { title: "Thermostat feedback loop", set: "SET 21° · NOW 18°", tag: "sense → compare → correct → sense again", cap: "The thermostat: a cheap machine that holds a goal against a world trying to pull it away." },
  governor: zh
    ? { title: "离心调速器", top: "随发动机旋转", valve: "蒸汽阀", cap: "转速加快 → 飞球外张 → 套筒上升 → 阀门关闭 → 机器减速。" }
    : { title: "Centrifugal governor", top: "spins with the engine", valve: "steam valve", cap: "Faster spin → balls fly outward → sleeve rises → valve closes → engine slows." },
  loops: zh
    ? { title: "增强与平衡回路", pop: "人口", births: "出生", crowd: "拥挤", scarce: "稀缺", r: "增强", b: "平衡", cap: "每个真实人口都是增长引擎与限制刹车之间的拔河。" }
    : { title: "Reinforcing and balancing loops", pop: "population", births: "births", crowd: "crowding", scarce: "scarcity", r: "reinforcing", b: "balancing", cap: "Every real population is a tug-of-war between growth engines and limiting brakes." },
  "bathtub-errors": zh
    ? { title: "36% 难题：常见错法", correct: "正确：存量继续上升", wrong: "常见错误：存量模仿流入", inflow: "流入", outflow: "流出", level: "水位", cap: "斯威尼与斯特曼的浴缸题：许多人画出的不是累积曲线，而是与流入同步起伏的曲线。" }
    : { title: "The 36% problem: the common wrong graph", correct: "correct: stock keeps rising", wrong: "common error: stock copies inflow", inflow: "inflow", outflow: "outflow", level: "level", cap: "Booth Sweeney and Sterman's bathtub task: many people draw the stock as if it should rise and fall with the inflow." },
  thresholds: zh
    ? { title: "气候临界阈值", current: "当前升温", paris: "巴黎 1.5°C", cap: "中心估计与不确定范围；几项下界已经进入当前升温区间。" }
    : { title: "Climate tipping thresholds", current: "current warming", paris: "Paris 1.5°C", cap: "Central estimates and uncertainty ranges; several lower bounds already overlap today's warming." },
  "deep-loops": zh
    ? { title: "回路套着回路", cap: "回路之内还有回路；看得越深，回路越多。" }
    : { title: "Loops inside loops", cap: "Loops inside loops inside loops. The deeper you look, the more there are." },
  ashby: zh
    ? { title: "必需多样性定律", disturbances: "扰动（多样性 = D）", system: "系统", outcome: "结果能否稳定？", regulator: "调节器", responses: "响应（多样性 = R）", rule: "需要 R ≥ D", cap: "调节器只能中和与它拥有的响应种类同样多的麻烦。" }
    : { title: "Law of Requisite Variety", disturbances: "disturbances (variety = D)", system: "system", outcome: "outcome held steady?", regulator: "regulator", responses: "responses (variety = R)", rule: "needs R ≥ D", cap: "A regulator can only neutralize as many kinds of trouble as it has kinds of response." },
  cybersyn: zh
    ? { title: "Cybersyn 操作室", cap: "七把转椅、大按钮扶手、墙上的经济状态：个人电脑出现前的国家反馈仪表盘。" }
    : { title: "Cybersyn Opsroom", cap: "Seven chairs, big-button armrests, the economy on the walls: a national feedback dashboard before personal computers." },
  resilience: zh
    ? { title: "霍林的两种恢复力", narrow: "窄而深", wide: "宽而浅", fast: "回弹快 · 大冲击会翻", slow: "恢复慢 · 可吸收大冲击", cap: "快速回弹与大冲击耐受并不是同一件事。" }
    : { title: "Holling's two resiliences", narrow: "narrow & deep", wide: "wide & shallow", fast: "snaps back fast · tips from a big shock", slow: "slow to recover · absorbs big shocks", cap: "Fast return and large-shock tolerance are not the same thing." },
  "tipping-types": zh
    ? { title: "三种临界", bif: "B · 分岔", noise: "N · 噪声", rate: "R · 速率", cap: "三条通向翻车的路：阈值、冲击，以及变化太快。" }
    : { title: "Three tipping routes", bif: "B · bifurcation", noise: "N · noise", rate: "R · rate", cap: "Three ways to tip: threshold, shock, and change applied too fast." },
  cliff: zh
    ? { title: "追踪悬崖", now: "现在", forecast: "预测：何时，以及落到哪里", far: "彼岸", cap: "旧科学能感到地面变软；新科学想知道日期、深度，以及彼岸山谷的地图。" }
    : { title: "Catching the cliff", now: "now", forecast: "forecast: when, and where it lands", far: "the far side", cap: "The old science could feel the ground softening; the new science wants the date, depth, and far-side map." },
  timeline: zh
    ? { title: "2020-2026 前沿时间线", cap: "色彩：预测、规避与恢复力感知、正向临界点、现实检验。" }
    : { title: "2020-2026 frontier timeline", cap: "Colour: prediction, evasion and resilience-sensing, positive tipping, and reality checks." }
}[kind];

const marks = [
  { label: zh ? "格陵兰冰盖" : "Greenland ice", lo: 0.8, mid: 1.5, hi: 3.0 },
  { label: zh ? "西南极冰盖" : "W. Antarctic ice", lo: 1.0, mid: 1.5, hi: 3.0 },
  { label: zh ? "暖水珊瑚礁" : "Warm-water reefs", lo: 1.0, mid: 1.5, hi: 2.0 },
  { label: zh ? "突发冻土融化" : "Abrupt permafrost", lo: 1.0, mid: 1.5, hi: 2.3 },
  { label: zh ? "副极地环流" : "Subpolar gyre", lo: 1.1, mid: 1.8, hi: 3.8 },
  { label: zh ? "东南极盆地" : "E.A. basins", lo: 2.0, mid: 3.0, hi: 6.0 },
  { label: zh ? "亚马逊退化" : "Amazon dieback", lo: 2.0, mid: 3.5, hi: 6.0 },
  { label: zh ? "冻土坍塌" : "Permafrost collapse", lo: 3.0, mid: 4.0, hi: 6.0 },
  { label: zh ? "AMOC 崩溃" : "AMOC collapse", lo: 1.4, mid: 4.0, hi: 8.0 },
  { label: zh ? "北极冬季海冰" : "Arctic winter ice", lo: 4.5, mid: 6.3, hi: 8.7 },
  { label: zh ? "东南极冰盖" : "E. Antarctic ice", lo: 5.0, mid: 7.5, hi: 10.0 }
];

const years = [
  { y: 2020, label: zh ? "社会临界" : "social tipping", color: ok, x: 60, row: 70 },
  { y: 2021, label: zh ? "AI 分类" : "AI classifier", color: accent, x: 150, row: 120 },
  { y: 2021, label: zh ? "斑图规避" : "pattern evasion", color: brass, x: 150, row: 190 },
  { y: 2022, label: zh ? "卫星恢复力" : "satellite resilience", color: brass, x: 250, row: 95 },
  { y: 2023, label: zh ? "数字孪生" : "digital twins", color: accent, x: 350, row: 165 },
  { y: 2024, label: zh ? "日期太不确定" : "dates too uncertain", color: danger, x: 450, row: 115 },
  { y: 2025, label: zh ? "不规则采样 AI" : "irregular-sample AI", color: accent, x: 545, row: 205 }
];
---
<figure class={`day9-static-figure day9-static-figure-${kind}`}>
  {kind === "thermostat" && (
    <svg viewBox="0 0 300 330" role="img" aria-label={copy.title}>
      <defs>
        <linearGradient id="day9-thermo-glass" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0%" stop-color={raised}></stop>
          <stop offset="100%" stop-color={paper}></stop>
        </linearGradient>
        <marker id="day9-thermo-arrow" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto">
          <path d="M0,0 L6,3 L0,6 z" fill={accent}></path>
        </marker>
      </defs>
      <rect x="24" y="18" width="252" height="272" rx="18" fill={raised} stroke={line}></rect>
      <path d="M188 78 C228 80 244 112 232 142 C221 169 190 171 176 196" fill="none" stroke={accent} stroke-width="2.2" stroke-dasharray="4 6" stroke-linecap="round" marker-end="url(#day9-thermo-arrow)" opacity=".9"></path>
      <rect x="70" y="52" width="54" height="154" rx="27" fill={paper} stroke={lineStrong} stroke-width="2"></rect>
      <rect x="88" y="70" width="18" height="118" rx="9" fill="url(#day9-thermo-glass)" stroke={line} stroke-width="1"></rect>
      <rect x="92" y="122" width="10" height="66" rx="5" fill={accent}></rect>
      <circle cx="97" cy="214" r="31" fill={paper} stroke={lineStrong} stroke-width="2"></circle>
      <circle cx="97" cy="214" r="21" fill={accent}></circle>
      <circle cx="90" cy="205" r="5" fill={raised} opacity=".72"></circle>
      {[0, 1, 2, 3, 4, 5].map((i) => <line x1="130" y1={75 + i * 23} x2={i === 3 ? 154 : 145} y2={75 + i * 23} stroke={i === 3 ? brass : faint} stroke-width={i === 3 ? 1.8 : 1}></line>)}
      <text x="162" y="80" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={faint}>24°</text>
      <text x="162" y="149" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={brass}>21°</text>
      <text x="162" y="195" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={faint}>18°</text>
      <g transform="translate(172 90)">
        <rect x="0" y="0" width="76" height="42" rx="8" fill={paper} stroke={line}></rect>
        <text x="38" y="17" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={faint}>{zh ? "设定" : "set"}</text>
        <text x="38" y="34" text-anchor="middle" font-family="Fraunces, serif" font-size="18" fill={brass}>21°</text>
        <rect x="0" y="58" width="76" height="42" rx="8" fill={paper} stroke={line}></rect>
        <text x="38" y="75" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={faint}>{zh ? "现在" : "now"}</text>
        <text x="38" y="92" text-anchor="middle" font-family="Fraunces, serif" font-size="18" fill={accent}>18°</text>
        <rect x="0" y="116" width="76" height="34" rx="8" fill={paper} stroke={accent} stroke-width="1.3"></rect>
        <text x="38" y="137" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={accentDeep}>{zh ? "加热开启" : "heat on"}</text>
      </g>
      <text x="150" y={zh ? 276 : 270} text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="12" fill={accentDeep}>
        {zh ? (
          copy.tag
        ) : (
          <>
            <tspan x="150" dy="0">sense → compare → correct</tspan>
            <tspan x="150" dy="15">sense again</tspan>
          </>
        )}
      </text>
    </svg>
  )}

  {kind === "governor" && (
    <svg viewBox="0 0 280 260" role="img" aria-label={copy.title}>
      <defs>
        <marker id="day9-gov-arrow" markerWidth="5" markerHeight="5" refX="4.2" refY="2.5" orient="auto"><path d="M0,0 L5,2.5 L0,5 z" fill={warn}></path></marker>
      </defs>
      <rect x="12" y="10" width="256" height="236" rx="14" fill={raised} stroke={line}></rect>
      <text x="140" y="32" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="11" fill={faint}>{copy.top}</text>
      <g class="governor-spin-ring" transform="translate(140 60)">
        <ellipse cx="0" cy="0" rx="36" ry="9" fill="none" stroke={warn} stroke-width="1.45" stroke-dasharray="7 7" opacity=".85"></ellipse>
        <path d="M26 -6 C38 0 38 8 25 13" fill="none" stroke={warn} stroke-width="1.45" stroke-linecap="round" marker-end="url(#day9-gov-arrow)"></path>
      </g>
      <rect x="116" y="210" width="48" height="14" rx="2" fill={lineStrong}></rect>
      <rect class="governor-valve" x="121" y="196" width="38" height="10" rx="2" fill={brass}></rect>
      <rect x="133" y="166" width="14" height="42" fill={faint}></rect>
      <text x="140" y="240" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={faint}>{copy.valve}</text>
      <line x1="140" y1="48" x2="140" y2="168" stroke={ink} stroke-width="4" stroke-linecap="round"></line>
      <circle cx="140" cy="44" r="6" fill={ink}></circle>
      <g class="governor-arms">
        <rect class="governor-sleeve" x="128" y="137" width="24" height="10" rx="2" fill={brass}></rect>
        <line x1="140" y1="62" x2="79" y2="111" stroke={soft} stroke-width="3" stroke-linecap="round"></line>
        <line x1="140" y1="62" x2="201" y2="111" stroke={soft} stroke-width="3" stroke-linecap="round"></line>
        <circle cx="72" cy="117" r="13" fill={accent}></circle>
        <circle cx="208" cy="117" r="13" fill={accent}></circle>
        <line x1="79" y1="123" x2="130" y2="142" stroke={faint} stroke-width="2"></line>
        <line x1="201" y1="123" x2="150" y2="142" stroke={faint} stroke-width="2"></line>
      </g>
      <path d="M66 92 C44 104 43 132 65 146" fill="none" stroke={warn} stroke-width="1.45" stroke-linecap="round" marker-end="url(#day9-gov-arrow)" opacity=".9"></path>
      <path d="M214 92 C236 104 237 132 215 146" fill="none" stroke={warn} stroke-width="1.45" stroke-linecap="round" marker-end="url(#day9-gov-arrow)" opacity=".9"></path>
    </svg>
  )}

  {kind === "loops" && (
    <svg viewBox="0 0 600 260" role="img" aria-label={copy.title}>
      <defs><marker id="day9-loop-head" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto"><path d="M0,0 L7,3.5 L0,7 z" fill={faint}></path></marker></defs>
      <rect x="10" y="10" width="580" height="232" rx="12" fill={raised} stroke={line}></rect>
      <g transform="translate(10 8)">
        <circle cx="150" cy="120" r="74" fill="none" stroke={brass} stroke-width="1.6" stroke-dasharray="4 5"></circle>
        <text x="150" y="116" text-anchor="middle" font-family="Fraunces, serif" font-size="30" fill={brass}>R</text>
        <text x="150" y="138" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={faint}>{copy.r}</text>
        <rect x="96" y="20" width="108" height="30" rx="7" fill={paper} stroke={lineStrong}></rect>
        <text x="150" y="39" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={ink}>{copy.pop}</text>
        <rect x="96" y="190" width="108" height="30" rx="7" fill={paper} stroke={lineStrong}></rect>
        <text x="150" y="209" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={ink}>{copy.births}</text>
        <path d="M150 50 C210 70 210 170 150 190" fill="none" stroke={faint} stroke-width="1.6" marker-end="url(#day9-loop-head)"></path>
        <path d="M150 190 C90 170 90 70 150 50" fill="none" stroke={faint} stroke-width="1.6" marker-end="url(#day9-loop-head)"></path>
        <text x="232" y="125" font-family="IBM Plex Mono, monospace" font-size="14" fill={brass}>+</text>
        <text x="60" y="125" font-family="IBM Plex Mono, monospace" font-size="14" fill={brass}>+</text>
      </g>
      <g transform="translate(10 8)">
        <circle cx="430" cy="120" r="74" fill="none" stroke={accent} stroke-width="1.6"></circle>
        <text x="430" y="116" text-anchor="middle" font-family="Fraunces, serif" font-size="30" fill={accent}>B</text>
        <text x="430" y="138" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={faint}>{copy.b}</text>
        <rect x="376" y="20" width="108" height="30" rx="7" fill={paper} stroke={lineStrong}></rect>
        <text x="430" y="39" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={ink}>{copy.pop}</text>
        <rect x="376" y="188" width="108" height="36" rx="7" fill={paper} stroke={lineStrong}></rect>
        <text x="430" y="203" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={ink}>{copy.crowd}</text>
        <text x="430" y="217" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={ink}>{copy.scarce}</text>
        <path d="M430 50 C490 70 490 170 430 188" fill="none" stroke={faint} stroke-width="1.6" marker-end="url(#day9-loop-head)"></path>
        <path d="M430 188 C370 170 370 70 430 50" fill="none" stroke={faint} stroke-width="1.6" marker-end="url(#day9-loop-head)"></path>
        <text x="512" y="125" font-family="IBM Plex Mono, monospace" font-size="14" fill={accent}>+</text>
        <text x="338" y="125" font-family="IBM Plex Mono, monospace" font-size="14" fill={danger}>-</text>
      </g>
    </svg>
  )}

  {kind === "bathtub-errors" && (
    <svg viewBox="0 0 360 430" role="img" aria-label={copy.title}>
      <rect x="8" y="8" width="344" height="398" rx="12" fill={raised} stroke={line}></rect>
      <g transform="translate(24 36)">
        <rect x="0" y="0" width="312" height="146" rx="8" fill={paper} stroke={line}></rect>
        <line x1="30" y1="120" x2="288" y2="120" stroke={lineStrong}></line>
        <line x1="30" y1="24" x2="30" y2="120" stroke={lineStrong}></line>
        <path d="M30 112 L70 94 L110 50 L150 24 L190 56 L230 88 L288 116" fill="none" stroke={accent} stroke-width="2.5" stroke-linecap="round"></path>
        <line x1="30" y1="78" x2="288" y2="78" stroke={brass} stroke-width="2" stroke-dasharray="6 5"></line>
        <path d="M30 113 C88 96 140 72 174 52 C206 34 244 43 288 76" fill="none" stroke={ok} stroke-width="3" stroke-linecap="round"></path>
        <text x="14" y="18" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={ok}>{copy.correct}</text>
        <text x="236" y="50" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={accent}>{copy.inflow}</text>
        <text x="236" y="96" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={brass}>{copy.outflow}</text>
      </g>
      <g transform="translate(24 205)">
        <rect x="0" y="0" width="312" height="146" rx="8" fill={paper} stroke={line}></rect>
        <line x1="30" y1="120" x2="288" y2="120" stroke={lineStrong}></line>
        <line x1="30" y1="24" x2="30" y2="120" stroke={lineStrong}></line>
        <path d="M30 112 L70 94 L110 50 L150 24 L190 56 L230 88 L288 116" fill="none" stroke={accent} stroke-width="2.4" stroke-linecap="round" opacity=".32"></path>
        <line x1="30" y1="78" x2="288" y2="78" stroke={brass} stroke-width="2" stroke-dasharray="6 5" opacity=".5"></line>
        <path d="M30 112 L70 94 L110 50 L150 24 L190 56 L230 88 L288 116" fill="none" stroke={danger} stroke-width="3" stroke-linecap="round"></path>
        <text x="14" y="18" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={danger}>{copy.wrong}</text>
        <text x="252" y="42" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={danger}>{copy.level}</text>
      </g>
      <text x="180" y="376" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={faint}>
        {zh ? (
          <>
            <tspan x="180" dy="0">规则不是「水位跟着水龙头走」，</tspan>
            <tspan x="180" dy="14">而是「流入 - 流出会累积」。</tspan>
          </>
        ) : (
          <>
            <tspan x="180" dy="0">not “level follows faucet”;</tspan>
            <tspan x="180" dy="14">it is “inflow minus outflow accumulates.”</tspan>
          </>
        )}
      </text>
    </svg>
  )}

  {kind === "thresholds" && (
    <svg viewBox="0 0 360 560" role="img" aria-label={copy.title}>
      <rect x="8" y="8" width="344" height="528" rx="12" fill={raised} stroke={line}></rect>
      <text x="20" y="32" font-family="IBM Plex Mono, monospace" font-size="11" fill={accentDeep}>{copy.title}</text>
      <g transform="translate(142 58)">
        {[0, 2, 4, 6, 8, 10].map((v) => <g>
          <line x1={v * 19} y1="0" x2={v * 19} y2="380" stroke={line} stroke-dasharray="2 6" opacity=".72"></line>
          <text x={v * 19} y="402" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={faint}>{v}°</text>
        </g>)}
        <rect x={1.35 * 19 - 1.5} y="0" width="3" height="380" fill={brass} opacity=".84"></rect>
        <line x1={1.5 * 19} y1="0" x2={1.5 * 19} y2="380" stroke={brass} stroke-width="1.4" stroke-dasharray="3 4"></line>
        <text x={1.35 * 19 + 8} y="-8" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={brass}>{copy.current}</text>
