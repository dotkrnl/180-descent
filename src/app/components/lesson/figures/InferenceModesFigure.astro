---
interface Props {
  locale?: "en" | "zh";
}

const zh = Astro.props.locale === "zh";
const copy = zh ? {
  aria: "三种推理之箭：演绎向内收敛、确定无疑；归纳越过圆点向外延伸；溯因一跃而起、奔向解释。",
  deduction: ["演绎", "所有 M 都是 P", "s 是 M", "∴ s 是 P", "保真", "已蕴涵"],
  induction: ["归纳", "……故皆然？", "超越已知", "或毁于下一例"],
  abduction: ["溯因", "意外线索", "最能解释", "它的故事"],
  bottom: "三种推理引擎——保证自左至右递减",
  caption: "演绎把你锁在安全的房间里；归纳与溯因送你出门——代价是确定性。"
} : {
  aria: "Three arrows of inference: deduction pointing inward and certain, induction reaching beyond the dots, abduction leaping to an explanation.",
  deduction: ["DEDUCTION", "all M are P", "s is M", "∴ s is P", "truth-preserving", "entailed"],
  induction: ["INDUCTION", "…so all of them?", "reaches beyond", "next case may break it"],
  abduction: ["ABDUCTION", "surprising clue", "best story that", "would explain it"],
  bottom: "three engines of inference — guarantee shrinks left → right",
  caption: "Deduction keeps you safe but locked in the room. Induction and abduction get you out — at the price of certainty."
};
---
<figure class="hero-art">
  <svg viewBox="0 0 460 250" role="img" aria-label={copy.aria}>
    <defs>
      <marker id="ah" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L9,4.5 L0,9 z" fill="var(--accent)"></path></marker>
      <marker id="ahb" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L9,4.5 L0,9 z" fill="var(--brass)"></path></marker>
      <marker id="ahc" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L9,4.5 L0,9 z" fill="var(--contested)"></path></marker>
    </defs>
    <g font-family="IBM Plex Mono,monospace" font-size="10.5">
      <text x="73" y="24" text-anchor="middle" fill="var(--accent)" letter-spacing="1.5">{copy.deduction[0]}</text>
      <rect x="20" y="40" width="106" height="74" rx="9" fill="none" stroke="var(--accent)" stroke-width="1.5"></rect>
      <text x="73" y="66" text-anchor="middle" fill="var(--ink-soft)">{copy.deduction[1]}</text>
      <text x="73" y="82" text-anchor="middle" fill="var(--ink-soft)">{copy.deduction[2]}</text>
      <line x1="35" y1="90" x2="111" y2="90" stroke="var(--line-strong)" stroke-width="1"></line>
      <text x="73" y="106" text-anchor="middle" fill="var(--ink)">{copy.deduction[3]}</text>
      <text x="73" y="135" text-anchor="middle" fill="var(--ok)" font-size="10.5">{copy.deduction[4]}</text>
      <text x="73" y="149" text-anchor="middle" fill="var(--ink-faint)" font-size="10.5">{copy.deduction[5]}</text>
    </g>
    <g font-family="IBM Plex Mono,monospace" font-size="10.5">
      <text x="230" y="24" text-anchor="middle" fill="var(--brass)" letter-spacing="1.5">{copy.induction[0]}</text>
      <circle cx="196" cy="58" r="5" fill="var(--ink-soft)"></circle>
      <circle cx="214" cy="74" r="5" fill="var(--ink-soft)"></circle>
      <circle cx="190" cy="80" r="5" fill="var(--ink-soft)"></circle>
      <circle cx="210" cy="94" r="5" fill="var(--ink-soft)"></circle>
      <path d="M222,86 C250,80 258,70 270,62" fill="none" stroke="var(--brass)" stroke-width="1.6" stroke-dasharray="4 4" marker-end="url(#ahb)"></path>
      <text x="248" y="116" text-anchor="middle" fill="var(--ink-soft)" font-size="10.5">{copy.induction[1]}</text>
      <text x="230" y="135" text-anchor="middle" fill="var(--brass)" font-size="10.5">{copy.induction[2]}</text>
      <text x="230" y="149" text-anchor="middle" fill="var(--contested)" font-size="10.5">{copy.induction[3]}</text>
    </g>
    <g font-family="IBM Plex Mono,monospace" font-size="10.5">
      <text x="388" y="24" text-anchor="middle" fill="var(--contested)" letter-spacing="1.5">{copy.abduction[0]}</text>
      <text x="388" y="60" text-anchor="middle" fill="var(--ink-soft)" font-size="10.5">{copy.abduction[1]}</text>
      <circle cx="388" cy="74" r="4" fill="var(--contested)"></circle>
      <path d="M388,82 Q360,100 388,116" fill="none" stroke="var(--contested)" stroke-width="1.6" marker-end="url(#ahc)"></path>
      <text x="388" y="132" text-anchor="middle" fill="var(--ink)" font-size="10.5">{copy.abduction[2]}</text>
      <text x="388" y="146" text-anchor="middle" fill="var(--ink)" font-size="10.5">{copy.abduction[3]}</text>
    </g>
    <text x="230" y="182" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="10.5" fill="var(--ink-faint)" letter-spacing="1">{copy.bottom}</text>
  </svg>
  <figcaption>{copy.caption}</figcaption>
</figure>
