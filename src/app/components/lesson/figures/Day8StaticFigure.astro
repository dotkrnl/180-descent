---
interface Props {
  kind: "percolation" | "cellular" | "boolean" | "nonreciprocal" | "physical-learning" | "grokking" | "hyperuniform";
  locale?: "en" | "zh";
}

const kind = Astro.props.kind;
const zh = Astro.props.locale === "zh";

const ink = "#172530";
const soft = "#41545d";
const faint = "#5d6c72";
const line = "#cabfa8";
const paper = "#f5f3ec";
const raised = "#fbfaf5";
const accent = "#1d6f78";
const accentDeep = "#13525a";
const brass = "#93651f";
const ok = "#2a704a";
const heat = "#a8442d";

const copy = {
  percolation: zh
    ? { title: "渗流阈值", a: "低 p", b: "接近 pc", c: "高 p", note: "有限网格中是圆滑转变；无限极限中才有尖锐阈值。" }
    : { title: "Percolation threshold", a: "low p", b: "near pc", c: "high p", note: "Finite grids round the transition; the sharp threshold belongs to the infinite ideal." },
  cellular: zh
    ? { title: "规则 30 与规则 110", left: "规则 30: 混沌纹理", right: "规则 110: 局域结构与碰撞", note: "同样的一维局部规则，可以走向噪声、秩序或通用计算。" }
    : { title: "Rule 30 and Rule 110", left: "Rule 30: chaotic texture", right: "Rule 110: localized structures", note: "One-dimensional local rules can lead to noise, order, or universal computation." },
  boolean: zh
    ? { title: "随机布尔网络", a: "低 K: 冻结", b: "K = 2: 临界附近", c: "高 K: 噪声", note: "经典无偏模型中，小扰动在 K≈2 附近由收缩转为扩散。" }
    : { title: "Random Boolean networks", a: "low K: frozen", b: "K = 2: near critical", c: "high K: noisy", note: "In the classic unbiased model, perturbations switch from shrinking to spreading near K≈2." },
  nonreciprocal: zh
    ? { title: "非互易追逐", note: "A 对 B 的影响不被 B 对 A 镜像；团簇因此可以持续运动。" }
    : { title: "Nonreciprocal pursuit", note: "A's influence on B is not mirrored by B's influence on A, so clusters can keep moving." },
  "physical-learning": zh
    ? { title: "局部物理学习", note: "局部更新向内传播；全局误差下降。" }
    : { title: "Local physical learning", note: "Local updates propagate inward; global error falls." },
  grokking: zh
    ? { title: "Grokking 曲线", train: "训练", test: "测试", note: "先记忆，长平台期后才突然样本外泛化；这是模型特定证据，不是普适相变证明。" }
    : { title: "Grokking curve", train: "train", test: "test", note: "Memorization comes first; test generalization jumps after a long plateau." },
  hyperuniform: zh
    ? { title: "晶体、随机、超均匀", a: "晶体", b: "随机", c: "超均匀", note: "局部无序，大尺度涨落被压低。" }
    : { title: "Crystal, random, hyperuniform", a: "crystal", b: "random", c: "hyperuniform", note: "Locally disordered; large-scale fluctuations suppressed." }
}[kind];

function caRows(rule: number, rows = 34, cols = 65): number[][] {
  let row = Array(cols).fill(0);
  row[Math.floor(cols / 2)] = 1;
  const out = [row];
  for (let y = 1; y < rows; y += 1) {
    const prev = out[y - 1];
    row = prev.map((_, x) => {
      const code = ((prev[x - 1] ?? 0) << 2) | (prev[x] << 1) | (prev[x + 1] ?? 0);
      return (rule >> code) & 1;
    });
    out.push(row);
  }
  return out;
}

const rule30 = caRows(30);
const rule110 = caRows(110);
const grids = [
  [
    "00100100",
    "00010010",
    "01000100",
    "00100001",
    "00001000",
    "01000010",
    "00010000",
    "00100001"
  ],
  [
    "01101010",
    "10111001",
    "00101110",
    "11010100",
    "01101101",
    "10110110",
    "01011001",
    "00101110"
  ],
  [
    "11101110",
    "10111101",
    "11101111",
    "01111101",
    "11110111",
    "10111111",
    "11101101",
    "01111111"
  ]
];
const hyperPoints = {
  crystal: Array.from({ length: 25 }, (_, i) => [34 + (i % 5) * 24, 80 + Math.floor(i / 5) * 20]),
  random: [[40, 81], [62, 101], [88, 87], [104, 121], [132, 92], [151, 135], [54, 146], [86, 158], [119, 153], [159, 165], [33, 196], [69, 187], [102, 209], [143, 204], [171, 193], [43, 224], [92, 235], [126, 230], [161, 244], [178, 219]],
  hyper: [[38, 84], [68, 101], [98, 82], [130, 105], [166, 86], [46, 137], [83, 148], [116, 128], [151, 148], [177, 126], [32, 188], [70, 206], [105, 183], [141, 204], [174, 184], [48, 238], [88, 224], [126, 245], [160, 226], [184, 248]]
};
---
<figure class={`day8-static-figure day8-static-figure-${kind}`}>
  <svg viewBox="0 0 720 320" role="img" aria-label={copy.title}>
    <rect x="12" y="12" width="696" height="296" rx="14" fill={raised} stroke={line} stroke-width="1.2"></rect>
    <text x="34" y="42" font-family="IBM Plex Mono, monospace" font-size="13" fill={accentDeep} letter-spacing="1.1">{copy.title}</text>

    {kind === "percolation" && (
      <>
        {grids.map((grid, gi) => (
          <g transform={`translate(${60 + gi * 215} 72)`}>
            <text x="52" y="-12" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="11" fill={faint}>{gi === 0 ? copy.a : gi === 1 ? copy.b : copy.c}</text>
            {grid.map((row, y) => row.split("").map((cell, x) => (
              <rect x={x * 13} y={y * 13} width="11" height="11" rx="2" fill={cell === "1" ? (gi === 2 && x > 1 && x < 6 ? accent : brass) : paper} stroke={line} stroke-width=".45"></rect>
            )))}
            {gi === 2 && <path d="M33 0L33 102M46 0L46 102M59 0L59 102" stroke={accentDeep} stroke-width="3" opacity=".42"></path>}
          </g>
        ))}
      </>
    )}

    {kind === "cellular" && (
      <>
        {[{ rows: rule30, x: 54, label: copy.left, color: ink }, { rows: rule110, x: 384, label: copy.right, color: accentDeep }].map((panel) => (
          <g transform={`translate(${panel.x} 72)`}>
            <text x="132" y="-12" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="11" fill={faint}>{panel.label}</text>
            <rect x="-6" y="-2" width="276" height="146" rx="6" fill={paper} stroke={line}></rect>
            {panel.rows.map((row, y) => row.map((cell, x) => cell ? (
              <rect x={x * 4} y={y * 4} width="3.6" height="3.6" fill={panel.color}></rect>
            ) : null))}
          </g>
        ))}
      </>
    )}

    {kind === "boolean" && (
      <>
        {[
          { x: 66, label: copy.a, bars: [42, 20, 10, 5, 2, 1, 1, 1], color: line },
          { x: 272, label: copy.b, bars: [52, 38, 43, 31, 35, 24, 28, 20], color: accent },
          { x: 478, label: copy.c, bars: [48, 63, 33, 68, 24, 59, 37, 65], color: heat }
        ].map((panel) => (
          <g transform={`translate(${panel.x} 78)`}>
            <text x="70" y="-18" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="11" fill={faint}>{panel.label}</text>
            <rect x="0" y="0" width="140" height="110" rx="7" fill={paper} stroke={line}></rect>
            {panel.bars.map((bar, i) => <rect x={16 + i * 14} y={92 - bar} width="8" height={bar} fill={panel.color} opacity=".85"></rect>)}
          </g>
        ))}
      </>
    )}

    {kind === "nonreciprocal" && (
      <g transform="translate(64 72)">
        <defs><marker id="day8-arrow-nonreciprocal" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0 0L10 5L0 10Z" fill={accentDeep}></path></marker></defs>
        <path d="M84 86C156 22 244 42 304 98C370 160 458 156 544 84" fill="none" stroke={accent} stroke-width="3" marker-end="url(#day8-arrow-nonreciprocal)"></path>
        {[70, 95, 119, 153, 190, 228].map((x, i) => <circle cx={x} cy={92 + (i % 2) * 22} r="13" fill={accent} opacity=".85"></circle>)}
        {[340, 374, 414, 451, 488, 526].map((x, i) => <circle cx={x} cy={102 - (i % 2) * 24} r="13" fill={brass} opacity=".9"></circle>)}
        <text x="300" y="188" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="12" fill={soft}>{copy.note}</text>
      </g>
    )}

    {kind === "physical-learning" && (
      <g transform="translate(72 70)">
        <rect x="0" y="0" width="260" height="152" rx="8" fill={paper} stroke={line}></rect>
        {Array.from({ length: 5 }, (_, y) => Array.from({ length: 7 }, (_, x) => (
          <>
            {x < 6 && <line x1={28 + x * 34} y1={28 + y * 24} x2={62 + x * 34} y2={28 + y * 24} stroke={line} stroke-width="1"></line>}
            {y < 4 && <line x1={28 + x * 34} y1={28 + y * 24} x2={28 + x * 34} y2={52 + y * 24} stroke={line} stroke-width="1"></line>}
            <circle cx={28 + x * 34} cy={28 + y * 24} r="5" fill={x === 0 || x === 6 || y === 0 || y === 4 ? brass : accent}></circle>
          </>
        )))}
        <g transform="translate(330 10)">
          <line x1="0" y1="126" x2="250" y2="126" stroke={line}></line>
          <line x1="0" y1="0" x2="0" y2="126" stroke={line}></line>
          <path d="M0 20C34 28 50 50 76 62C118 82 152 86 250 112" fill="none" stroke={accentDeep} stroke-width="3"></path>
          <path d="M0 30C42 45 77 68 116 78C157 89 194 94 250 104" fill="none" stroke={brass} stroke-width="2" stroke-dasharray="5 5"></path>
        </g>
        <text x="300" y="190" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="12" fill={soft}>{copy.note}</text>
      </g>
    )}

    {kind === "grokking" && (
      <g transform="translate(80 70)">
        <line x1="0" y1="160" x2="560" y2="160" stroke={line}></line>
        <line x1="0" y1="0" x2="0" y2="160" stroke={line}></line>
        <path d="M0 142C40 46 84 22 132 20L560 20" fill="none" stroke={brass} stroke-width="3"></path>
        <path d="M0 146C170 144 260 143 330 138C382 134 407 34 458 24C493 18 526 18 560 18" fill="none" stroke={accentDeep} stroke-width="3"></path>
        <text x="492" y="44" font-family="IBM Plex Mono, monospace" font-size="12" fill={brass}>{copy.train}</text>
        <text x="492" y="72" font-family="IBM Plex Mono, monospace" font-size="12" fill={accentDeep}>{copy.test}</text>
        <text x="280" y="202" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="12" fill={soft}>{copy.note}</text>
      </g>
    )}

    {kind === "hyperuniform" && (
      <>
        {[
          { pts: hyperPoints.crystal, x: 54, label: copy.a },
          { pts: hyperPoints.random, x: 270, label: copy.b },
          { pts: hyperPoints.hyper, x: 486, label: copy.c }
        ].map((panel) => (
          <g transform={`translate(${panel.x} 50)`}>
            <text x="86" y="18" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="11" fill={faint}>{panel.label}</text>
            <rect x="0" y="34" width="172" height="210" rx="8" fill={paper} stroke={line}></rect>
            {panel.pts.map(([x, y]) => <circle cx={x} cy={y} r="4.6" fill={panel.label === copy.b ? brass : accentDeep} opacity=".9"></circle>)}
            <circle cx="86" cy="140" r="54" fill="none" stroke={panel.label === copy.b ? heat : ok} stroke-width="2" stroke-dasharray="4 5" opacity=".7"></circle>
          </g>
        ))}
      </>
    )}

    {kind !== "nonreciprocal" && kind !== "physical-learning" && kind !== "grokking" && kind !== "hyperuniform" && (
      <text x="360" y="296" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="12" fill={soft}>{copy.note}</text>
    )}
  </svg>
</figure>
