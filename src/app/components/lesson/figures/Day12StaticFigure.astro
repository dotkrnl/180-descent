        <text x="461" y="275" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="14" fill={ink}>E[k_friend] = E[k^2] / E[k]</text>
        <text x="461" y="303" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="11" fill={soft}>{zh ? "度数方差越大，差距通常越大" : "degree variance usually widens the gap"}</text>
      </g>
    )}

    {kind === "navigability" && (
      <g>
        {[55,105,155].map((radius) => <circle cx="176" cy="185" r={radius} fill="none" stroke={line} stroke-width="1.3" stroke-dasharray="5 6" />)}
        <circle cx="176" cy="185" r="10" fill={accent} />
