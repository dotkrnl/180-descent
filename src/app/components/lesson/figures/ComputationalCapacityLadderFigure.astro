---
import type { Locale } from "@lib/schemas/day";

interface Props {
  locale: Locale;
}

const zh = Astro.props.locale === "zh";
const copy = zh
  ? {
      aria: "分别显示设备操作速率和宇宙累计操作总数的两条对数图表。",
      ratesTitle: "速率 · 每秒操作次数",
      opsPerSecond: "每秒操作次数（对数）",
      laptop: "笔记本",
      exascale: "百亿亿次级 ~10¹⁸/s",
      ultimate: "1公斤终极笔记本",
      cumulativeTitle: "累计 · 自大爆炸以来的操作总数",
      universe: "宇宙至今",
      universeOps: "总计 ~10^120 次操作"
    }
  : {
      aria: "Separate logarithmic charts for device operation rates and the universe's cumulative operations.",
      ratesTitle: "Rates · operations per second",
      opsPerSecond: "operations per second (log)",
      laptop: "laptop",
      exascale: "exascale ~10¹⁸/s",
      ultimate: "ultimate 1-kg laptop",
      cumulativeTitle: "Cumulative · operations since Big Bang",
      universe: "universe so far",
      universeOps: "~10^120 total ops"
    };
---
<div class="computational-capacity-ladder-figure">
  <svg viewBox="0 0 640 300" role="img" aria-label={copy.aria}>
    <text x="60" y="26" font-family="IBM Plex Mono,monospace" font-size="11" fill="var(--ink-soft)">{copy.ratesTitle}</text>
    <line x1="60" y1="210" x2="610" y2="210" stroke="var(--line-strong)" stroke-width="1.2"></line>
    <g font-family="IBM Plex Mono,monospace" font-size="10.5" fill="var(--ink-faint)" text-anchor="middle">
      <line x1="70" y1="206" x2="70" y2="214" stroke="var(--line-strong)"></line><text x="70" y="228">10¹⁰</text>
      <line x1="179" y1="206" x2="179" y2="214" stroke="var(--line-strong)"></line><text x="179" y="228">10²⁰</text>
      <line x1="288" y1="206" x2="288" y2="214" stroke="var(--line-strong)"></line><text x="288" y="228">10³⁰</text>
      <line x1="397" y1="206" x2="397" y2="214" stroke="var(--line-strong)"></line><text x="397" y="228">10⁴⁰</text>
      <line x1="506" y1="206" x2="506" y2="214" stroke="var(--line-strong)"></line><text x="506" y="228">10⁵⁰</text>
      <text x="335" y="244" fill="var(--ink-soft)">{copy.opsPerSecond}</text>
    </g>
    <g>
      <line x1="92" y1="210" x2="92" y2="95" stroke="var(--accent)" stroke-width="1.4" stroke-dasharray="3 3"></line>
      <circle cx="92" cy="95" r="7" fill="var(--accent)" stroke="var(--raised)" stroke-width="2"></circle>
      <text x="92" y="83" font-family="IBM Plex Mono,monospace" font-size="10.5" fill="var(--ink-soft)" text-anchor="middle">{copy.laptop}</text>
      <text x="92" y="72" font-family="IBM Plex Mono,monospace" font-size="10.5" fill="var(--ink-faint)" text-anchor="middle">~10¹²/s</text>
    </g>
    <g>
      <line x1="157" y1="210" x2="157" y2="130" stroke="var(--accent)" stroke-width="1.4" stroke-dasharray="3 3"></line>
      <circle cx="157" cy="130" r="6" fill="var(--accent)" fill-opacity="0.6" stroke="var(--raised)" stroke-width="2"></circle>
      <text x="170" y="128" font-family="IBM Plex Mono,monospace" font-size="10.5" fill="var(--ink-faint)" text-anchor="start">{copy.exascale}</text>
    </g>
    <g>
      <line x1="517" y1="210" x2="517" y2="60" stroke="var(--brass)" stroke-width="1.4" stroke-dasharray="3 3"></line>
      <circle cx="517" cy="60" r="7" fill="var(--brass)" stroke="var(--raised)" stroke-width="2"></circle>
      <text x="517" y="48" font-family="IBM Plex Mono,monospace" font-size="10.5" fill="var(--ink-soft)" text-anchor="middle">{copy.ultimate}</text>
      <text x="517" y="37" font-family="IBM Plex Mono,monospace" font-size="10.5" fill="var(--ink-faint)" text-anchor="middle">~10^51/s</text>
    </g>
    <text x="60" y="268" font-family="IBM Plex Mono,monospace" font-size="11" fill="var(--ink-soft)">{copy.cumulativeTitle}</text>
    <line x1="300" y1="266" x2="610" y2="266" stroke="var(--line-strong)" stroke-width="1.2"></line>
    <g font-family="IBM Plex Mono,monospace" font-size="10.5" fill="var(--ink-faint)" text-anchor="middle">
      <line x1="300" y1="262" x2="300" y2="270" stroke="var(--line-strong)"></line><text x="300" y="292">10^90</text>
      <line x1="455" y1="262" x2="455" y2="270" stroke="var(--line-strong)"></line><text x="455" y="292">10¹⁰⁵</text>
      <line x1="610" y1="262" x2="610" y2="270" stroke="var(--line-strong)"></line><text x="610" y="292">10^120</text>
    </g>
    <g>
      <circle cx="610" cy="266" r="7" fill="var(--heat)" stroke="var(--raised)" stroke-width="2"></circle>
      <text x="540" y="258" font-family="IBM Plex Mono,monospace" font-size="10.5" fill="var(--ink-soft)" text-anchor="end">{copy.universe}</text>
      <text x="540" y="279" font-family="IBM Plex Mono,monospace" font-size="10.5" fill="var(--ink-faint)" text-anchor="end">{copy.universeOps}</text>
    </g>
  </svg>
</div>
