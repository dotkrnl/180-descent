---
interface Props {
  kind: "hero-map" | "dial-curve" | "weather-chart" | "frontier-map" | "extrapolation-cliff";
  locale?: "en" | "zh";
}

const kind = Astro.props.kind;
const zh = Astro.props.locale === "zh";

const ink = "var(--ink, #172530)";
const soft = "var(--ink-soft, #41545d)";
const faint = "var(--ink-faint, #5d6c72)";
const line = "var(--line, #ddd7c8)";
const lineStrong = "var(--line-strong, #cabfa8)";
const paper = "var(--paper, #f5f3ec)";
const raised = "var(--raised, #fbfaf5)";
const accent = "var(--accent, #1d6f78)";
const accentDeep = "var(--accent-deep, #13525a)";
const brass = "var(--brass, #93651f)";
const ok = "var(--ok, #2a704a)";
const contested = "var(--contested, #a23c34)";

const copy = {
  hero: zh
    ? {
        aria: "一张与帝国等大的地图覆盖在疆域之上，右下角已经卷起破败。",
        tag: "比例尺：与帝国同大",
        caption: "博尔赫斯想象的帝国造出一张与疆域同样大小的地图；后人让它在荒野里腐烂。"
      }
    : {
        aria: "An empire-sized one-to-one map laid over the territory it depicts, peeling and decaying at one corner.",
        tag: "scale: empire-sized",
        caption: "Borges imagined an empire that built a map the exact size of its territory. Their descendants let it rot."
      },
  dial: zh
    ? {
        aria: "一张图显示保真度随细节上升，而有用性先上升后在一比一地图处崩塌。",
        title: "理想化的甜点不在两端",
        detail: "更多细节",
        value: "价值",
        fidelity: "保真度",
        usefulness: "有用性",
        tooBare: "过度抽象",
        useful: "可用中段",
        tooMuch: "淹没于细节",
        caption: "一个好模型保留任务需要的结构，而不是追求最大细节。保真度可以持续上升；有用性通常不会。"
      }
    : {
        aria: "A chart showing fidelity rising with detail while usefulness rises, peaks, and collapses at the one-to-one map.",
        title: "The useful model lives away from both edges",
        detail: "more detail",
        value: "value",
        fidelity: "fidelity",
        usefulness: "usefulness",
        tooBare: "too bare",
        useful: "useful middle",
        tooMuch: "detail swamp",
        caption: "A good model preserves the structure needed for a task rather than maximizing detail. Fidelity can keep rising; usefulness usually cannot."
      },
  weather: zh
    ? {
        aria: "三条横向柱形图概括 AI 天气模型在同行评议基准中的目标指标占比或预报时间收益。",
        title: "基准胜利到底说了什么",
        parity: "目标占比 50%",
        caption: "GraphCast 与 GenCast 报告的是目标指标占比；Pangu-Weather 报告的是相对 IFS 的预报时间收益。它们证明预报技能或速度，不证明模型内部已经理解物理。",
        rows: [
          ["GraphCast", "90% 目标", "DeepMind · Science"],
          ["GenCast", "97.2% 目标", "DeepMind · Nature"],
          ["Pangu-Weather", "10-15 小时收益", "Huawei · Nature"]
        ]
      }
    : {
        aria: "Three horizontal bars summarizing peer-reviewed AI weather benchmark target shares or forecast-time gains.",
        title: "What the benchmark wins actually say",
        parity: "target share 50%",
        caption: "GraphCast and GenCast report target-metric shares; Pangu-Weather reports forecast-time gains over IFS. They establish forecast skill or speed, not that the model's interior understands physics.",
        rows: [
          ["GraphCast", "90% targets", "DeepMind · Science"],
          ["GenCast", "97.2% targets", "DeepMind · Nature"],
          ["Pangu-Weather", "10-15 h gain", "Huawei · Nature"]
        ]
      }
    ,
  frontier: zh
    ? {
        aria: "一张散点图按证据强度和潜在影响排列十三项 AI 建模前沿工作。",
        title: "十三条前沿之龙",
        x: "证据更扎实",
        y: "潜在影响更大",
        thin: "大主张，薄冰",
        solid: "真正革命",
        caption: "位置取决于判断，而非测量。绿色靠右的工作已经较稳；左上角的宏大说法仍需要等待验证。",
        labels: ["托卡马克", "Aurora", "FunSearch", "泄漏", "外推", "GNoME", "MatterGen", "AI-Descartes", "Prithvi", "KAN", "虚拟细胞", "cBottle", "AI Scientist"]
      }
    : {
        aria: "A scatter plot arranging thirteen AI modeling frontier developments by evidential strength and potential impact.",
        title: "Thirteen frontier dragons",
        x: "stronger evidence",
        y: "larger impact if true",
        thin: "big claim, thin ice",
        solid: "the real revolution",
        caption: "The positions are a calibration exercise, not a measurement. Green work toward the right is comparatively solid; the upper-left claims are still dragons.",
        labels: ["Tokamak", "Aurora", "FunSearch", "Leakage", "Extrapolation", "GNoME", "MatterGen", "AI-Descartes", "Prithvi", "KAN", "Virtual cell", "cBottle", "AI Scientist"]
      },
  cliff: zh
    ? {
        aria: "一张折线图显示真实升温持续上升，而机器学习代理模型在训练范围外向熟悉气候回漂。",
        title: "外推悬崖",
        trained: "训练范围",
        warming: "施加升温",
        temp: "预测全球温度",
        truth: "真实趋势",
        emulator: "代理模型",
        edge: "训练边缘",
        drift: "回漂到熟悉处",
        caption: "这个图是示意，不复刻某篇论文的图。它表达 NeuralGCM 与 ACE2 警示的失效模式：训练区内技能很强，不等于训练区外有机制性理解。"
      }
    : {
        aria: "A line chart where true warming continues upward while a machine-learning emulator drifts back toward the familiar climate outside the training range.",
        title: "The extrapolation cliff",
        trained: "trained here",
        warming: "warming applied",
        temp: "predicted global temperature",
        truth: "truth",
        emulator: "emulator",
        edge: "edge of training",
        drift: "drifts back to the familiar",
        caption: "This is a schematic, not a reproduction of a paper figure. It captures the failure mode flagged by NeuralGCM and ACE2: skill inside the training climate is not mechanism outside it."
      }
};

const weatherWidths = [90, 97.2, 72];
const frontierItems = [
  { n: 1, x: 0.90, y: 0.76, t: "ok" },
  { n: 2, x: 0.72, y: 0.84, t: "ok" },
  { n: 3, x: 0.83, y: 0.62, t: "ok" },
  { n: 4, x: 0.88, y: 0.86, t: "ok" },
  { n: 5, x: 0.84, y: 0.80, t: "ok" },
  { n: 6, x: 0.60, y: 0.70, t: "hint" },
  { n: 7, x: 0.66, y: 0.66, t: "hint" },
  { n: 8, x: 0.58, y: 0.72, t: "hint" },
  { n: 9, x: 0.45, y: 0.60, t: "hint" },
  { n: 10, x: 0.35, y: 0.58, t: "hint" },
  { n: 11, x: 0.20, y: 0.92, t: "bad" },
  { n: 12, x: 0.30, y: 0.74, t: "bad" },
  { n: 13, x: 0.16, y: 0.55, t: "bad" }
];
const frontierColor = (status: string) => status === "ok" ? ok : status === "hint" ? brass : contested;
const sx = (x: number) => 82 + 420 * x;
const sy = (y: number) => 258 - 188 * y;
const figureAria = kind === "hero-map"
  ? copy.hero.aria
  : kind === "dial-curve"
    ? copy.dial.aria
    : kind === "weather-chart"
      ? copy.weather.aria
      : kind === "frontier-map"
        ? copy.frontier.aria
        : copy.cliff.aria;
---
<figure class={`figbox day10-static-figure day10-static-figure-${kind}`} aria-label={figureAria}>
  {kind === "hero-map" && (
    <>
      <svg viewBox="0 0 360 240" aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id="day10-land" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color={raised}></stop>
            <stop offset="100%" stop-color={paper}></stop>
          </linearGradient>
        </defs>
        <path d="M28,150 C40,96 92,70 130,86 C150,60 210,52 236,84 C292,72 330,110 320,158 C332,196 286,222 232,210 C196,232 120,230 92,206 C44,212 18,186 28,150 Z" fill="url(#day10-land)" stroke={lineStrong} stroke-width="1.6"></path>
        <path d="M96,196 C128,168 132,140 168,128 C196,118 206,96 232,92" fill="none" stroke={accent} stroke-width="1.5" opacity=".65"></path>
        <path d="M210,206 C214,176 244,164 268,150" fill="none" stroke={accent} stroke-width="1.2" opacity=".55"></path>
        <circle cx="176" cy="150" r="4.8" fill={contested}></circle>
        <circle cx="176" cy="150" r="9" fill="none" stroke={contested} stroke-width="1" opacity=".5"></circle>
        <text x="176" y="138" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={soft}>{zh ? "首都" : "capital"}</text>
        <g opacity=".94">
          <path d="M40,140 C52,86 104,60 142,76 C162,50 222,42 248,74 C304,62 342,100 332,148 L300,176 C300,176 250,210 196,198 C160,220 84,218 56,194 C36,188 30,166 40,140 Z" fill="none" stroke={brass} stroke-width="1.7" stroke-dasharray="5 4"></path>
          <line x1="92" y1="70" x2="92" y2="200" stroke={brass} stroke-width=".7" opacity=".45"></line>
          <line x1="158" y1="58" x2="158" y2="210" stroke={brass} stroke-width=".7" opacity=".45"></line>
          <line x1="224" y1="58" x2="224" y2="206" stroke={brass} stroke-width=".7" opacity=".45"></line>
          <line x1="60" y1="118" x2="330" y2="118" stroke={brass} stroke-width=".7" opacity=".45"></line>
          <line x1="56" y1="166" x2="320" y2="166" stroke={brass} stroke-width=".7" opacity=".45"></line>
        </g>
        <path d="M300,176 C286,190 268,196 252,192 C268,182 276,176 282,168 Z" fill={paper} stroke={brass} stroke-width="1.1" opacity=".96"></path>
        <text x="300" y="206" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={faint}>{zh ? "残破边角" : "tattered ruins"}</text>
        <text x="180" y="226" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" letter-spacing=".8" fill={contested}>{copy.hero.tag}</text>
      </svg>
      <figcaption>{copy.hero.caption}</figcaption>
    </>
  )}

  {kind === "dial-curve" && (
    <>
      <svg viewBox="0 0 520 250" aria-hidden="true" focusable="false">
        <rect x="18" y="14" width="484" height="206" rx="14" fill={raised} stroke={line}></rect>
        <text x="260" y="42" text-anchor="middle" font-family="Fraunces, serif" font-size="19" font-weight="600" fill={ink}>{copy.dial.title}</text>
        <line x1="70" y1="184" x2="454" y2="184" stroke={lineStrong} stroke-width="1.4"></line>
        <line x1="70" y1="62" x2="70" y2="184" stroke={lineStrong} stroke-width="1.4"></line>
        <text x="262" y="211" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={faint}>{copy.dial.detail}</text>
        <text x="42" y="126" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={faint} transform="rotate(-90 42 126)">{copy.dial.value}</text>
        <path d="M70 184 C128 116 170 74 214 68 C270 61 324 94 362 141 C392 169 420 183 454 184" fill="none" stroke={brass} stroke-width="3" stroke-linecap="round"></path>
        <path d="M70 184 C116 138 162 108 210 91 C280 66 358 55 454 51" fill="none" stroke={accent} stroke-width="3" stroke-linecap="round"></path>
        <line x1="206" y1="58" x2="206" y2="184" stroke={ink} stroke-width="1" stroke-dasharray="4 5" opacity=".45"></line>
        <circle cx="206" cy="70" r="5" fill={accent}></circle>
        <circle cx="206" cy="69" r="5" fill={brass}></circle>
        <g font-family="IBM Plex Mono, monospace" font-size="10.5">
          <circle cx="344" cy="72" r="4" fill={accent}></circle><text x="354" y="76" fill={soft}>{copy.dial.fidelity}</text>
          <circle cx="344" cy="92" r="4" fill={brass}></circle><text x="354" y="96" fill={soft}>{copy.dial.usefulness}</text>
        </g>
        <text x="91" y="202" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={faint}>{copy.dial.tooBare}</text>
        <text x="173" y="202" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={brass}>{copy.dial.useful}</text>
        <text x="374" y="202" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={contested}>{copy.dial.tooMuch}</text>
      </svg>
      <figcaption>{copy.dial.caption}</figcaption>
    </>
  )}

  {kind === "weather-chart" && (
    <>
      <svg viewBox="0 0 620 330" aria-hidden="true" focusable="false">
        <rect x="18" y="18" width="584" height="282" rx="14" fill={raised} stroke={line}></rect>
        <text x="310" y="52" text-anchor="middle" font-family="Fraunces, serif" font-size="21" font-weight="600" fill={ink}>{copy.weather.title}</text>
        <line x1="186" y1="82" x2="186" y2="246" stroke={lineStrong} stroke-width="1"></line>
        <line x1="380" y1="82" x2="380" y2="246" stroke={faint} stroke-width="1" stroke-dasharray="5 5" opacity=".65"></line>
        <text x="380" y="270" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={faint}>{copy.weather.parity}</text>
        {copy.weather.rows.map((row, index) => {
          const y = 96 + index * 64;
          const width = weatherWidths[index] * 3.5;
          const valueLabel = row[1];
          const valueX = Math.min(526, 186 + width - 10);
          return (
            <g>
              <text x="72" y={y + 12} font-family="Fraunces, serif" font-size="16" font-weight="600" fill={ink}>{row[0]}</text>
              <text x="72" y={y + 30} font-family="IBM Plex Mono, monospace" font-size="10.5" fill={faint}>{row[2]}</text>
              <rect x="186" y={y} width="360" height="30" rx="7" fill={paper} stroke={lineStrong}></rect>
              <rect x="186" y={y} width={width} height="30" rx="7" fill={index === 2 ? ok : accent}></rect>
              <text x={valueX} y={y + 20} text-anchor="end" font-family="IBM Plex Mono, monospace" font-size="10.5" font-weight="600" fill="#fff">{valueLabel}</text>
            </g>
          );
        })}
        <g font-family="IBM Plex Mono, monospace" font-size="10.5" fill={faint}>
          <text x="186" y="270" text-anchor="middle">0%</text>
          <text x="546" y="270" text-anchor="middle">100%</text>
        </g>
      </svg>
      <figcaption>{copy.weather.caption}</figcaption>
    </>
  )}

  {kind === "frontier-map" && (
    <>
      <svg viewBox="0 0 690 430" aria-hidden="true" focusable="false">
        <rect x="18" y="18" width="654" height="382" rx="14" fill={raised} stroke={line}></rect>
        <text x="310" y="52" text-anchor="middle" font-family="Fraunces, serif" font-size="21" font-weight="600" fill={ink}>{copy.frontier.title}</text>
        <rect x="82" y="70" width="210" height="94" fill={contested} opacity=".08"></rect>
        <rect x="292" y="70" width="210" height="94" fill={ok} opacity=".08"></rect>
        <line x1="82" y1="258" x2="512" y2="258" stroke={lineStrong} stroke-width="1.4"></line>
        <line x1="82" y1="70" x2="82" y2="258" stroke={lineStrong} stroke-width="1.4"></line>
        <line x1="292" y1="70" x2="292" y2="258" stroke={line} stroke-width="1" stroke-dasharray="5 5"></line>
        <line x1="82" y1="164" x2="512" y2="164" stroke={line} stroke-width="1" stroke-dasharray="5 5"></line>
        <text x="297" y="293" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={faint}>{copy.frontier.x}</text>
        <text x="48" y="166" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={faint} transform="rotate(-90 48 166)">{copy.frontier.y}</text>
        <text x="94" y="87" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={contested}>{copy.frontier.thin}</text>
        <text x="500" y="87" text-anchor="end" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={ok}>{copy.frontier.solid}</text>
        {frontierItems.map((item) => (
          <g>
            <circle cx={sx(item.x)} cy={sy(item.y)} r="12" fill={frontierColor(item.t)} stroke={raised} stroke-width="2"></circle>
            <text x={sx(item.x)} y={sy(item.y) + 4} text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" font-weight="600" fill="#fff">{item.n}</text>
          </g>
        ))}
        <g font-family="IBM Plex Mono, monospace" font-size="10.5" fill={soft}>
          {copy.frontier.labels.slice(0, 7).map((label, index) => {
            const y = 112 + index * 22;
            return (
              <g>
                <circle cx="512" cy={y - 4} r="7" fill={frontierColor(frontierItems[index].t)}></circle>
                <text x="525" y={y}>{frontierItems[index].n}. {label}</text>
              </g>
            );
          })}
          {copy.frontier.labels.slice(7).map((label, index) => {
            const item = frontierItems[index + 7];
            const y = 112 + index * 22;
            return (
              <g>
                <circle cx="512" cy={y + 154} r="7" fill={frontierColor(item.t)}></circle>
                <text x="525" y={y + 158}>{item.n}. {label}</text>
              </g>
            );
          })}
        </g>
      </svg>
      <figcaption>{copy.frontier.caption}</figcaption>
    </>
  )}

  {kind === "extrapolation-cliff" && (
    <>
      <svg viewBox="0 0 620 330" aria-hidden="true" focusable="false">
        <rect x="18" y="18" width="584" height="282" rx="14" fill={raised} stroke={line}></rect>
        <text x="310" y="52" text-anchor="middle" font-family="Fraunces, serif" font-size="21" font-weight="600" fill={ink}>{copy.cliff.title}</text>
        <rect x="92" y="78" width="190" height="150" fill={accent} opacity=".09"></rect>
        <text x="187" y="74" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={accent}>{copy.cliff.trained}</text>
        <line x1="92" y1="228" x2="532" y2="228" stroke={lineStrong} stroke-width="1.4"></line>
        <line x1="92" y1="78" x2="92" y2="228" stroke={lineStrong} stroke-width="1.4"></line>
        <text x="312" y="266" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={faint}>{copy.cliff.warming}  (+0K · +1K · +2K · +3K · +4K)</text>
        <text x="52" y="153" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={faint} transform="rotate(-90 52 153)">{copy.cliff.temp}</text>
        <path d="M92,214 L195,190 L298,160 L410,123 L510,88" fill="none" stroke={soft} stroke-width="3" stroke-linecap="round"></path>
        <circle cx="510" cy="88" r="5" fill={soft}></circle>
        <text x="518" y="85" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={soft}>{copy.cliff.truth}</text>
        <path d="M92,215 L195,191 L298,162 L410,164 L510,199" fill="none" stroke={contested} stroke-width="3" stroke-linecap="round"></path>
        <circle cx="510" cy="199" r="5" fill={contested}></circle>
        <text x="518" y="203" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={contested}>{copy.cliff.emulator}</text>
        <line x1="282" y1="78" x2="282" y2="228" stroke={brass} stroke-width="1.2" stroke-dasharray="5 5"></line>
        <text x="292" y="98" font-family="IBM Plex Mono, monospace" font-size="10.5" fill={brass}>{copy.cliff.edge}</text>
        <path d="M423,160 C452,170 474,184 496,205" fill="none" stroke={brass} stroke-width="1.4"></path>
        <text x="383" y="213" font-family="Fraunces, serif" font-size="15" font-style="italic" fill={brass}>{copy.cliff.drift}</text>
      </svg>
      <figcaption>{copy.cliff.caption}</figcaption>
    </>
  )}
</figure>
