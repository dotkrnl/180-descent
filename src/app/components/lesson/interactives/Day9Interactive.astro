---
import FormatOnly from "@app/components/lesson/FormatOnly.astro";
import Panel from "@app/components/lesson/Panel.astro";
import PanelNote from "@app/components/lesson/PanelNote.astro";
import PanelTitle from "@app/components/lesson/PanelTitle.astro";

interface Props {
  kind: "feedback" | "bathtub" | "tipping" | "leverage" | "daisyworld" | "classifier" | "evasion";
  locale?: "en" | "zh";
}

const kind = Astro.props.kind;
const zh = Astro.props.locale === "zh";

const text = {
  feedback: zh
    ? { eyebrow: "交互 · 搭建它，再打破它", title: "反馈引擎", note: "房间起初很冷，控制器想要 21°C。调高增益（修正有多猛）和延迟（读数有多陈旧），看一只平静的恒温器变成麦克斯韦的噩梦：追逐、振荡，最后把自己撕裂。再把接线翻成正反馈，看目标追踪者变成失控者。", gain: "增益 — 修正强度", delay: "延迟 — 读数滞后", wiring: "接线", neg: "负反馈 · 稳定", pos: "正反馈 · 失控", calm: "平静控制", hunt: "振荡", tear: "撕裂", squeal: "尖啸" }
    : { eyebrow: "Interactive · build it and break it", title: "The Feedback Engine", note: "A room starts cold; the controller wants 21°C. Turn up the gain (how aggressively it corrects) and the delay (how stale its readings are), and watch a calm thermostat turn into Maxwell's nightmare: hunting, oscillating, and finally tearing itself apart. Then flip the wire to positive feedback and see a goal-seeker become a runaway.", gain: "Gain — correction strength", delay: "Delay — lag in the reading", wiring: "Wiring", neg: "Negative · stabilizing", pos: "Positive · runaway", calm: "Calm control", hunt: "The hunt", tear: "Tear it apart", squeal: "The squeal" },
  bathtub: zh
    ? { eyebrow: "交互 · 反直觉的水槽", title: "水位为何持续上升", note: "水龙头（上图）先升高、再降低，形成一个峰。排水口由你设定。下图是水位。关键是：只要水龙头仍大于排水口，水位就持续上升；它只会在水龙头降到排水口以下之后才到峰值。存量滞后于流量。", inflow: "水龙头 — 峰值流入", outflow: "排水口 — 恒定流出", co2: "CO2 水槽", balance: "保持平衡", empty: "排水获胜" }
    : { eyebrow: "Interactive · the counterintuitive tub", title: "Why the Water Keeps Rising", note: "The faucet (top) ramps up, then ramps back down: a hump. The drain is whatever you set it to. The bottom chart is the water level. The thing to notice: the level keeps rising the whole time the faucet beats the drain, and only peaks after the faucet has already started shutting off. Stock lags flow.", inflow: "Faucet — peak inflow", outflow: "Drain — constant outflow", co2: "The CO2 tub", balance: "Hold it steady", empty: "Drain wins" },
  tipping: zh
    ? { eyebrow: "交互 · 感受临界拐点", title: "稳定地貌", note: "拖动驱动因素，让山谷变形。球坐在自己的盆地里，并会微微抖动。越接近临界点，盆地越平，球的游走范围（方差）和迟滞性（自相关）越高；推过折叠点后，再往回拖也不会马上回来。那段回不去的距离，就是滞后。", driver: "驱动因素（如升温）", res: "恢复力", variance: "方差", ac: "自相关", safe: "安全稳定", edge: "在边缘", reset: "重置球" }
    : { eyebrow: "Interactive · feel the tipping point", title: "The Stability Landscape", note: "Drag the driver to deform the valleys. The ball sits in its basin, and jitters. Watch two things as you push toward a tipping point: the basin flattens, and the ball's wandering (variance) and sluggishness (autocorrelation) climb. Push past the fold, then drag the driver back: the gap before return is hysteresis.", driver: "Driver (e.g. warming)", res: "Resilience", variance: "Variance", ac: "Autocorr.", safe: "Safe & stable", edge: "On the edge", reset: "Reset ball" },
  leverage: zh
    ? { eyebrow: "交互 · 梅多斯的杠杆点", title: "系统中的干预位置", note: "按唐娜拉·梅多斯从 12（最弱）到 1（最强）排序。点击任意横档，查看为什么越高越有力，也越难触及。", top: "↑ 更强杠杆 · 更难触及", bottom: "↓ 更弱杠杆 · 争论最密集" }
    : { eyebrow: "Interactive · Meadows' leverage points", title: "Places to Intervene in a System", note: "Ranked from 12 (weakest) to 1 (strongest), after Donella Meadows. Tap any rung to see why higher leverage is stronger and harder to reach.", top: "↑ stronger leverage · harder to reach", bottom: "↓ weaker leverage · where everyone fights" },
  daisyworld: zh
    ? { eyebrow: "交互 · 雏菊世界的寓言", title: "一个自己守住温度的世界", note: "拖动太阳亮度。蓝线是有雏菊的温度，虚线是没有生命的裸岩。雏菊会在很宽范围内把温度压平成平台，直到恒星过亮而崩溃。", lum: "太阳亮度", life: "有生命温度", dead: "裸岩温度", dim: "昏暗年轻星", hot: "更热恒星", edge: "接近断点", collapse: "越过崩溃" }
    : { eyebrow: "Interactive · the parable of Daisyworld", title: "A World That Holds Its Own Temperature", note: "Drag solar luminosity. The blue curve is temperature with daisies; the dashed line is a dead rock. Daisies flatten temperature across a wide range, until the star becomes too bright and the system collapses.", lum: "Solar luminosity", life: "Temp · with life", dead: "Temp · dead rock", dim: "Young, dim star", hot: "Hotter star", edge: "Near the breaking point", collapse: "Past collapse" },
  classifier: zh
    ? { eyebrow: "交互 · 同样的震颤，三道不同的悬崖", title: "分类器听到了你听不到的什么", note: "选择一条崩溃路径。通用预警信号在三种情况下都会上升；分类器读取接近过程的形状，给出分岔类型。", route: "崩溃路径", fold: "折叠 · 跳跃", hopf: "霍普夫 · 振荡", trans: "跨临界 · 滑移", variance: "方差", ac: "滞后一阶自相关" }
    : { eyebrow: "Interactive · the same tremor, three different cliffs", title: "What a Classifier Hears That You Can't", note: "Pick a route to collapse. Generic warning signals rise in all three cases; the classifier reads the shape of approach and names the bifurcation.", route: "Route to collapse", fold: "Fold · jump", hopf: "Hopf · oscillate", trans: "Transcritical · slide", variance: "Variance", ac: "Lag-1 autocorr." },
  evasion: zh
    ? { eyebrow: "交互 · 规避还是崩溃", title: "空间斑图的逃生舱口", note: "提高环境压力。关闭自组织，系统到临界点会整体崩溃；打开它，系统会裂成图灵式斑图并撑过更高压力。", stress: "环境压力", mode: "空间自组织", off: "关闭 · 均匀", on: "开启 · 允许斑图" }
    : { eyebrow: "Interactive · evade or collapse", title: "The Escape Hatch of Spatial Patterns", note: "Raise environmental stress. With self-organization off, the system collapses at its tipping point; turn it on and patterns let it persist far longer.", stress: "Environmental stress", mode: "Spatial self-organization", off: "Off · uniform", on: "On · patterns allowed" }
}[kind];

const print = {
  feedback: zh
    ? {
        title: "静态替代 · 反馈引擎",
        caption: "增益和延迟共同决定控制回路是收敛、振荡，还是失控；符号一旦翻成正反馈，误差会喂养误差。",
        columns: ["设置", "系统行为", "要点"],
        rows: [
          ["低增益、短延迟、负反馈", "平稳靠近 21°C", "修正足够温和，也来得足够早。"],
          ["高增益、长延迟、负反馈", "围绕目标来回振荡", "修正抵达时状态已经变了，系统开始追着自己的影子跑。"],
          ["正反馈", "偏差越修越大", "回路符号翻转后，目标追踪者变成失控放大器。"]
        ]
      }
    : {
        title: "Static alternate · Feedback Engine",
        caption: "Gain and delay decide whether a control loop converges, oscillates, or runs away; flip the sign to positive feedback and error feeds error.",
        columns: ["Setting", "System behavior", "Point"],
        rows: [
          ["Low gain, short delay, negative feedback", "Settles toward 21°C", "Correction is gentle enough and arrives early enough."],
          ["High gain, long delay, negative feedback", "Oscillates around the target", "Correction arrives after the state has changed, so the loop chases itself."],
          ["Positive feedback", "Deviation amplifies", "A sign flip turns goal-seeking into runaway amplification."]
        ]
      },
  bathtub: zh
    ? {
        title: "静态替代 · 水槽累积",
        caption: "水位是存量；水龙头和排水口是流量。只要流入仍大于流出，水位就继续上升，即使水龙头已经开始关小。",
        columns: ["阶段", "流量关系", "水位"],
        rows: [
          ["水龙头上升", "流入大于流出", "快速上升"],
          ["水龙头回落但仍高于排水", "流入仍大于流出", "继续上升"],
          ["水龙头低于排水", "流出大于流入", "才开始下降"]
        ]
      }
    : {
        title: "Static alternate · Bathtub accumulation",
        caption: "The level is a stock; faucet and drain are flows. The level keeps rising as long as inflow still exceeds outflow, even after the faucet starts closing.",
        columns: ["Phase", "Flow relation", "Water level"],
        rows: [
          ["Faucet rising", "Inflow exceeds outflow", "Rises quickly"],
          ["Faucet falling but still above drain", "Inflow still exceeds outflow", "Keeps rising"],
          ["Faucet below drain", "Outflow exceeds inflow", "Only then falls"]
        ]
      },
  tipping: zh
    ? {
        title: "静态替代 · 稳定地貌",
        caption: "驱动因素把山谷压平时，恢复力下降，方差和自相关上升；越过折叠点后，系统进入另一个盆地，回程出现滞后。",
        columns: ["位置", "预警信号", "结果"],
        rows: [
          ["深盆地", "恢复力高，方差低", "扰动后会回到原状态"],
          ["临界边缘", "恢复力低，方差和自相关高", "小扰动也可能触发翻转"],
          ["越过折叠点", "旧盆地消失", "回撤驱动因素也不会立刻回来"]
        ]
      }
    : {
        title: "Static alternate · Stability landscape",
        caption: "As the driver flattens the valley, resilience falls while variance and autocorrelation rise; after the fold, the system lands in another basin and hysteresis delays return.",
        columns: ["Position", "Warning signal", "Result"],
        rows: [
          ["Deep basin", "High resilience, low variance", "Perturbations return to the old state"],
          ["Near the edge", "Low resilience, high variance and autocorrelation", "Small shocks can trigger a transition"],
          ["Past the fold", "The old basin is gone", "Undoing the driver is not enough for immediate return"]
        ]
      },
  leverage: zh
    ? {
        title: "静态替代 · 梅多斯杠杆点",
        caption: "从弱到强，系统干预点大致从参数、缓冲和管路，走向信息流、规则、自组织、目标和范式。",
        columns: ["层级", "例子", "为什么重要"],
        rows: [
          ["12-10", "参数、缓冲、存量-流量结构", "最容易争论，也最常只是微调。"],
          ["9-6", "延迟、平衡回路、增强回路、信息流", "改变反馈如何抵达行动者。"],
          ["5-1", "规则、自组织、目标、范式、超越范式", "改变系统真正优化和想象的东西。"]
        ]
      }
    : {
        title: "Static alternate · Meadows' leverage points",
        caption: "From weak to strong, interventions move from parameters, buffers, and plumbing toward information flows, rules, self-organization, goals, and paradigms.",
        columns: ["Level", "Examples", "Why it matters"],
        rows: [
          ["12-10", "Parameters, buffers, stock-flow structure", "Most visible, often only tuning."],
          ["9-6", "Delays, balancing loops, reinforcing loops, information flows", "Changes how feedback reaches actors."],
          ["5-1", "Rules, self-organization, goals, paradigms, transcending paradigms", "Changes what the system optimizes for and can imagine."]
        ]
      },
  daisyworld: zh
    ? {
        title: "静态替代 · 雏菊世界",
        caption: "有生命的星球把温度曲线压成平台：黑雏菊在暗星下吸热，白雏菊在亮星下反射热，直到亮度太高而崩溃。",
        columns: ["太阳亮度", "雏菊组成", "温度结果"],
        rows: [
          ["偏暗", "黑雏菊较多", "吸收更多热量，世界被暖起来"],
          ["中等", "黑白雏菊共同调节", "温度保持在适生平台"],
          ["过亮", "雏菊死亡", "调节失败，温度跟随裸岩上升"]
        ]
      }
    : {
        title: "Static alternate · Daisyworld",
        caption: "Life flattens the temperature curve: black daisies warm a dim world, white daisies reflect heat on a bright one, until luminosity gets too high and regulation collapses.",
        columns: ["Solar luminosity", "Daisy mix", "Temperature result"],
        rows: [
          ["Dim", "More black daisies", "Absorbs heat and warms the world"],
          ["Moderate", "Black and white daisies regulate together", "Temperature stays on a habitable plateau"],
          ["Too bright", "Daisies die out", "Regulation fails and temperature follows dead rock"]
        ]
      },
  classifier: zh
    ? {
        title: "静态替代 · 临界分类器",
        caption: "方差和自相关在多种临界路径中都会上升；分类器试图读取接近崩溃的形状，区分折叠、霍普夫和跨临界分岔。",
        columns: ["路径", "形状", "落点"],
        rows: [
          ["折叠", "缓慢接近后突然跳跃", "系统落入远处状态"],
          ["霍普夫", "振荡幅度增长", "未来不是新水平，而是周期振荡"],
          ["跨临界", "两种稳定性互换", "一个状态滑让给另一个状态"]
        ]
      }
    : {
        title: "Static alternate · Tipping classifier",
        caption: "Variance and autocorrelation rise in many routes to tipping; the classifier reads the shape of approach to separate fold, Hopf, and transcritical bifurcations.",
        columns: ["Route", "Shape", "Landing"],
        rows: [
          ["Fold", "Slow approach, then sudden jump", "System lands in a distant state"],
          ["Hopf", "Oscillation grows", "The future is a cycle, not a new level"],
          ["Transcritical", "Stabilities exchange", "One state slides out as another takes over"]
        ]
      },
  evasion: zh
    ? {
        title: "静态替代 · 斑图规避",
        caption: "均匀系统会在压力达到临界点时整体崩溃；允许空间自组织时，系统可以裂成斑图，用稀疏覆盖换取更长存活。",
        columns: ["模式", "压力升高时", "教训"],
        rows: [
          ["均匀", "跨过阈值后整体崩溃", "没有空间结构可供系统退守"],
          ["允许斑图", "形成斑块并撑过更高压力", "自组织可以暂时规避临界点"],
          ["压力过高", "斑图也变稀并失败", "规避不是免疫，只是买时间"]
        ]
      }
    : {
        title: "Static alternate · Pattern evasion",
        caption: "A uniform system collapses at its threshold; with spatial self-organization, it can break into patterns and trade uniform cover for longer persistence.",
        columns: ["Mode", "As stress rises", "Lesson"],
        rows: [
          ["Uniform", "Collapses once the threshold is crossed", "No spatial structure remains to retreat into"],
          ["Patterns allowed", "Forms patches and persists under higher stress", "Self-organization can evade a tipping point for a while"],
          ["Stress too high", "Patterns thin out and fail", "Evasion is not immunity; it buys time"]
        ]
      }
}[kind];
---
<Panel class="day9-interactive web-only" data-day9-kind={kind} data-locale={zh ? "zh" : "en"}>
  <PanelTitle>{text.eyebrow}</PanelTitle>
  <h3>{text.title}</h3>
  <PanelNote>{text.note}</PanelNote>

  {kind === "feedback" && (
    <div class="day9-grid">
      <div class="day9-controls">
        <label>{text.gain} <strong data-out="gain">0.14</strong><input data-role="gain" type="range" min="0" max="100" value="20" /></label>
        <label>{text.delay} <strong data-out="delay">4</strong><input data-role="delay" type="range" min="0" max="40" value="4" /></label>
        <span class="day9-kicker">{text.wiring}</span>
        <div class="day9-seg">
          <button data-sign="neg" aria-pressed="true">{text.neg}</button>
          <button data-sign="pos" aria-pressed="false">{text.pos}</button>
        </div>
        <div class="day9-presets">
          <button data-preset="calm">{text.calm}</button>
          <button data-preset="hunt">{text.hunt}</button>
          <button data-preset="tear">{text.tear}</button>
          <button data-preset="squeal">{text.squeal}</button>
        </div>
      </div>
      <div class="day9-plot">
        <svg data-role="plot" viewBox="0 0 600 270" role="img" aria-label={text.title}></svg>
        <div class="day9-verdict"><strong data-out="state"></strong><span data-out="expl"></span></div>
      </div>
    </div>
  )}

  {kind === "bathtub" && (
    <div class="day9-grid">
      <div class="day9-controls">
        <label>{text.inflow} <strong data-out="in">8.0</strong><input data-role="in" type="range" min="10" max="100" value="80" /></label>
        <label>{text.outflow} <strong data-out="out">3.0</strong><input data-role="out" type="range" min="0" max="100" value="30" /></label>
        <div class="day9-callout" data-out="msg"></div>
        <div class="day9-presets">
          <button data-preset="co2">{text.co2}</button>
          <button data-preset="balance">{text.balance}</button>
          <button data-preset="empty">{text.empty}</button>
        </div>
      </div>
      <div class="day9-plot">
        <svg data-role="flow" viewBox="0 0 600 150" role="img" aria-label={text.inflow}></svg>
        <svg data-role="level" viewBox="0 0 600 168" role="img" aria-label={text.outflow}></svg>
      </div>
    </div>
  )}

  {kind === "tipping" && (
    <div class="day9-grid">
      <div class="day9-controls">
        <label>{text.driver} <strong data-out="driver">-0.25</strong><input data-role="driver" type="range" min="-60" max="60" value="-25" /></label>
        <div class="day9-readouts">
          <div><span>{text.res}</span><strong data-out="res">high</strong><i data-bar="res"></i></div>
          <div><span>{text.variance}</span><strong data-out="var">low</strong><i data-bar="var"></i></div>
          <div><span>{text.ac}</span><strong data-out="ac">0.20</strong><i data-bar="ac"></i></div>
        </div>
        <div class="day9-verdict"><strong data-out="state"></strong><span data-out="expl"></span></div>
        <div class="day9-presets">
          <button data-preset="safe">{text.safe}</button>
          <button data-preset="edge">{text.edge}</button>
          <button data-preset="reset">{text.reset}</button>
        </div>
      </div>
      <div class="day9-plot"><svg data-role="plot" viewBox="0 0 600 330" role="img" aria-label={text.title}></svg></div>
    </div>
  )}

  {kind === "leverage" && (
    <>
      <div class="day9-ladder-note">{text.top}</div>
      <div class="day9-ladder" data-role="ladder"></div>
      <div class="day9-ladder-note">{text.bottom}</div>
    </>
  )}

  {kind === "daisyworld" && (
    <div class="day9-grid">
      <div class="day9-controls">
        <label>{text.lum} <strong data-out="lum">1.00</strong><input data-role="lum" type="range" min="60" max="170" value="100" /></label>
        <div class="day9-planet" data-role="bar"><span data-seg="black">black</span><span data-seg="white">white</span><span data-seg="bare">bare</span></div>
        <div class="day9-readouts two">
          <div><span>{text.life}</span><strong data-out="life">-</strong></div>
          <div><span>{text.dead}</span><strong data-out="dead">-</strong></div>
        </div>
        <div class="day9-callout" data-out="state"></div>
        <div class="day9-presets">
          <button data-preset="80">{text.dim}</button>
          <button data-preset="120">{text.hot}</button>
          <button data-preset="150">{text.edge}</button>
          <button data-preset="165">{text.collapse}</button>
        </div>
      </div>
      <div class="day9-plot"><svg data-role="plot" viewBox="0 0 600 330" role="img" aria-label={text.title}></svg></div>
    </div>
  )}

  {kind === "classifier" && (
    <div class="day9-grid">
      <div class="day9-controls">
        <span class="day9-kicker">{text.route}</span>
        <div class="day9-seg three">
          <button data-bc="fold" aria-pressed="true">{text.fold}</button>
          <button data-bc="hopf" aria-pressed="false">{text.hopf}</button>
          <button data-bc="trans" aria-pressed="false">{text.trans}</button>
        </div>
        <div class="day9-readouts">
          <div><span>{text.variance}</span><strong data-out="var">rising</strong><i data-bar="var"></i></div>
          <div><span>{text.ac}</span><strong data-out="ac">→ 1</strong><i data-bar="ac"></i></div>
        </div>
        <div class="day9-verdict"><strong data-out="state"></strong><span data-out="expl"></span></div>
      </div>
      <div class="day9-plot"><svg data-role="plot" viewBox="0 0 600 300" role="img" aria-label={text.title}></svg></div>
    </div>
  )}

  {kind === "evasion" && (
    <div class="day9-grid">
      <div class="day9-controls">
        <label>{text.stress} <strong data-out="stress">0.30</strong><input data-role="stress" type="range" min="0" max="100" value="30" /></label>
        <span class="day9-kicker">{text.mode}</span>
        <div class="day9-seg">
          <button data-ev="off" aria-pressed="true">{text.off}</button>
          <button data-ev="on" aria-pressed="false">{text.on}</button>
        </div>
        <div class="day9-vgrid" data-role="grid" aria-hidden="true"></div>
        <div class="day9-verdict"><strong data-out="state"></strong><span data-out="expl"></span></div>
      </div>
      <div class="day9-plot"><svg data-role="plot" viewBox="0 0 600 300" role="img" aria-label={text.title}></svg></div>
