---
import Panel from "@app/components/lesson/Panel.astro";
import PanelNote from "@app/components/lesson/PanelNote.astro";
import PanelTitle from "@app/components/lesson/PanelTitle.astro";

interface Props {
  locale?: "en" | "zh";
}

const zh = Astro.props.locale === "zh";
const copy = zh ? {
  panelTitle: "交互 · 选择你的出路",
  heading: "怀疑论者的三段论——四扇出口之门",
  note: "下面的论证是有效的：如果你接受所有三行，你就是怀疑论者。因此你必须拒绝某一点。每一次拒绝都是真实的招式，有真实的捍卫者——以及真实的代价。选择其一，看看你与谁为伍。",
  p1: "你并不知道自己不是一只无手的缸中之脑（一个无法分辨的伪造）。",
  p2: "封闭性：如果你知道你有双手，你就知道自己不是那样的缸中之脑。",
  conclusion: "所以你不知道自己有双手。",
  question: "你拒绝哪一行？",
  buttons: [
    ["skeptic", "接受全部三点"],
    ["moore", "拒绝 P1"],
    ["dretske", "拒绝 P2（否定封闭性）"],
    ["context", "重新定义「知道」"]
  ],
  initialWho: "选择一扇门……",
  initialBody: "每个选项都会使你所拒绝的那行变暗，并告诉你落到了何处。"
} : {
  panelTitle: "Interactive · pick your escape",
  heading: "The Skeptic's Syllogism — four doors out",
  note: "The argument below is valid: if you accept all three lines, you're a skeptic. So you must reject something. Each rejection is a real move with real defenders — and real costs. Pick one and see whose company you've joined.",
  p1: "You don't know you're not a handless brain in a vat (an indistinguishable fake).",
  p2: "Closure: if you know you have hands, you know you're not such a vat-brain.",
  conclusion: "So you don't know you have hands.",
  question: "Which line do you refuse?",
  buttons: [
    ["skeptic", "Accept all three"],
    ["moore", "Reject P1"],
    ["dretske", "Reject P2 (deny closure)"],
    ["context", 'Redefine "know"']
  ],
  initialWho: "Choose a door…",
  initialBody: "Each option dims the line you're rejecting and tells you where you've landed."
};
---
<Panel class="web-only cm-machine">
  <PanelTitle>{copy.panelTitle}</PanelTitle>

  <h3>{copy.heading}</h3>

  <PanelNote>{copy.note}</PanelNote>

  <div class="cm-arg" id="appendix-d001-cmArg">
    <div class="cm-line cm-p1" id="appendix-d001-cmP1"><span class="pn">P1</span><span class="pt">{zh ? copy.p1 : <>You don't <strong>know</strong> you're not a handless brain in a vat (an indistinguishable fake).</>}</span></div>
    <div class="cm-line cm-p2" id="appendix-d001-cmP2"><span class="pn">P2</span><span class="pt">{zh ? copy.p2 : <><strong>Closure:</strong> if you know you have hands, you know you're not such a vat-brain.</>}</span></div>
    <div class="cm-line concl cm-c" id="appendix-d001-cmC"><span class="pn">∴</span><span class="pt">{zh ? copy.conclusion : <>So you <strong>don't know</strong> you have hands.</>}</span></div>
  </div>

  <div class="cm-exits">
    <p class="h">{copy.question}</p>
    <div class="cm-btns">
      {copy.buttons.map(([exit, label]) => <button class="cm-btn" data-exit={exit}>{label}</button>)}
    </div>
  </div>

  <div class="cm-out cm-outlet" id="appendix-d001-cmOut">
    <span class="who">{copy.initialWho}</span>
    {copy.initialBody}
  </div>
</Panel>
