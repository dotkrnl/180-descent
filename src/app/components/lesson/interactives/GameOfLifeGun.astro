---
import Panel from "@app/components/lesson/Panel.astro";
import PanelNote from "@app/components/lesson/PanelNote.astro";
import PanelTitle from "@app/components/lesson/PanelTitle.astro";

interface Props {
  locale?: "en" | "zh";
}

const zh = Astro.props.locale === "zh";
---
<Panel class="web-only emergence-life">
  <PanelTitle>{zh ? "交互 · 两条规则生成计算" : "Interactive · computation from a two-rule universe"}</PanelTitle>
  <h3>{zh ? "康威生命游戏与永不停火的滑翔机枪" : "Conway's Game of Life, and the gun that fires forever"}</h3>
  <PanelNote>{zh ? "一个由活细胞和死细胞组成的网格，只按邻居数量更新。从这套极简规则中会出现滑翔机、振荡器，以及下方著名的 Gosper 滑翔机枪：一个会不断吐出滑翔机的有限图样。这个玩具宇宙是图灵完备的。" : "A grid of cells, each alive or dead, updates on two rules about live neighbors. From this tiny rulebook come gliders, oscillators, and the famous Gosper glider gun below: a finite pattern that spits out a glider forever. This toy universe is Turing-complete."}</PanelNote>

  <div class="gol-wrap">
    <div class="gol-stage">
      <canvas
        id="gol"
        width="380"
        height="220"
        role="application"
        tabindex="0"
        aria-label={zh ? "可编辑的康威生命游戏网格，初始显示滑翔机枪。" : "Editable Conway's Game of Life grid, initially showing a glider gun."}
        aria-describedby="gol-keyboard-help gol-cell-status"
        aria-keyshortcuts="ArrowUp ArrowDown ArrowLeft ArrowRight Space Enter"
      ></canvas>
    </div>
    <div class="gol-side">
      <p class="glabel">{zh ? "完整规则" : "The entire rulebook"}</p>
      <ul class="gol-rules">
        <li>{zh ? "一个活细胞若有 2 或 3 个活邻居，就继续存活。" : "A live cell with 2 or 3 live neighbors survives."}</li>
        <li>{zh ? "一个死细胞若恰有 3 个活邻居，就诞生。" : "A dead cell with exactly 3 live neighbors is born."}</li>
        <li>{zh ? "其他情况全部死亡或保持死亡。" : "Everything else dies or stays dead."}</li>
      </ul>
      <div class="emergence-controls no-margin" role="group" aria-label={zh ? "生命游戏控制" : "Game of Life controls"}>
        <button class="simbtn primary" id="gol-play" type="button" aria-label={zh ? "暂停生命游戏" : "Pause the Game of Life"}>{zh ? "暂停" : "Pause"}</button>
        {" "}
        <button class="simbtn" id="gol-gun" type="button" aria-label={zh ? "载入滑翔机枪图样" : "Load the glider gun pattern"}>{zh ? "滑翔机枪" : "Glider gun"}</button>
        {" "}
        <button class="simbtn" id="gol-rand" type="button" aria-label={zh ? "生成随机汤图样" : "Generate a random soup pattern"}>{zh ? "随机汤" : "Random soup"}</button>
        {" "}
        <button class="simbtn" id="gol-clear" type="button" aria-label={zh ? "清空生命游戏网格" : "Clear the Game of Life grid"}>{zh ? "清空" : "Clear"}</button>
      </div>
      <p class="gol-note" id="gol-keyboard-help">{zh ? "点击细胞；或聚焦网格，用方向键选择细胞，再按空格键或回车键切换。第 " : "Click a cell, or focus the grid and use the arrow keys to choose one; press Space or Enter to toggle it. Generation "}<b id="gol-gen">0</b>{zh ? " 代。" : "."}</p>
      <p class="sr-only" id="gol-cell-status" aria-live="polite" aria-atomic="true"></p>
    </div>
  </div>
</Panel>
