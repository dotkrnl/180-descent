---
import Panel from "@app/components/lesson/Panel.astro";
import PanelNote from "@app/components/lesson/PanelNote.astro";
import PanelTitle from "@app/components/lesson/PanelTitle.astro";

interface Props {
  locale?: "en" | "zh";
}

const zh = Astro.props.locale === "zh";
---
<Panel class="web-only emergence-percolation">
  <PanelTitle>{zh ? "交互 · 渗流阈值" : "Interactive · the percolation threshold"}</PanelTitle>
  <h3>{zh ? "一片森林何时连成火路？" : "When does a forest become one connected path?"}</h3>
  <PanelNote>{zh ? "拖动密度滑块。每个格点都会以概率 p 独立填充。青色表示已经从顶部连到底部的贯穿簇；接近 p ≈ 0.59 时，有限网格中的概率曲线会陡然变陡，但不会成为真正无限系统里的数学悬崖。" : "Drag the density slider. Each site is independently filled with probability p. Teal marks a cluster that spans from top to bottom; near p ≈ 0.59 the finite grid's probability curve steepens, but it is not the exact cliff of the infinite ideal."}</PanelNote>

  <div class="perc-grid">
    <div class="perc-stage">
      <canvas id="perc" width="420" height="420" aria-label={zh ? "渗流网格模拟，显示填充格点和贯穿簇。" : "Percolation grid simulation showing filled sites and any spanning cluster."}></canvas>
    </div>
    <div class="perc-side">
      <div class="perc-meter">
        <p class="perc-label">{zh ? "填充概率" : "fill probability"}</p>
        <p class="perc-value"><span id="perc-pval">0.59</span> <small>{zh ? "临界附近" : "near critical"}</small></p>
        <input id="perc-p" type="range" min="0" max="100" value="59" aria-label={zh ? "填充概率 p" : "Fill probability p"} />
      </div>

      <div class="perc-verdict" id="perc-verdict" aria-live="polite">{zh ? "检查贯穿簇中…" : "Checking for a spanning cluster..."}</div>
      <p class="perc-stat">{zh ? "填充格点" : "filled sites"} <b id="perc-filled">0</b> · {zh ? "最大簇" : "largest cluster"} <b id="perc-largest">0</b></p>

      <div class="emergence-controls no-margin" role="group" aria-label={zh ? "渗流模拟控制" : "Percolation simulation controls"}>
        <button class="simbtn primary" id="perc-reroll">{zh ? "重新抽样" : "Reroll grid"}</button>
        {" "}
        <button class="simbtn" id="perc-low">{zh ? "低密度" : "Low p"}</button>
        {" "}
        <button class="simbtn" id="perc-critical">{zh ? "临界附近" : "Near p_c"}</button>
        {" "}
        <button class="simbtn" id="perc-high">{zh ? "高密度" : "High p"}</button>
      </div>

      <p class="perc-note">{zh ? "有限网格会有偶然性：阈值下方也可能贯穿，阈值上方也可能失败。真正尖锐的转变属于无限系统。" : "Finite grids are noisy: a sample can span below the threshold or fail above it. The mathematically sharp transition belongs to the infinite system."}</p>
    </div>
  </div>
</Panel>
