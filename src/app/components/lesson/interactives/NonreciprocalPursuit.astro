---
import Panel from "@app/components/lesson/Panel.astro";
import PanelNote from "@app/components/lesson/PanelNote.astro";
import PanelTitle from "@app/components/lesson/PanelTitle.astro";

interface Props {
  locale?: "en" | "zh";
}

const zh = Astro.props.locale === "zh";
---
<Panel class="web-only frontier-interactive emergence-nonrecip">
  <PanelTitle>{zh ? "交互 · 非互易运动" : "Interactive · nonreciprocal pursuit"}</PanelTitle>
  <h3>{zh ? "持续运动的非互易团簇" : "The chase that never settles"}</h3>
  <PanelNote>{zh ? "两种粒子遵循不对称的有效相互作用。把滑块从对称推向非互易，观察团簇从静止聚集变成持续漂移的运动结构。" : "Two particle species follow asymmetric effective interactions. Move the slider from symmetric toward nonreciprocal and watch clumps turn from static clusters into travelling structures."}</PanelNote>

  <div class="frontier-stage frontier-wide">
    <canvas id="nonrecip" width="720" height="380" aria-label={zh ? "两种粒子因非互易相互作用形成持续运动的团簇。" : "Two particle species forming travelling clusters through nonreciprocal pursuit."}></canvas>
  </div>

  <div class="frontier-controls">
    <div class="nbr-row">
      <span>{zh ? "非互易性" : "nonreciprocity"}&nbsp;=&nbsp;<b id="nrval">0.90</b></span>
      <input type="range" id="nrslider" min="0" max="100" value="90" aria-label={zh ? "非互易强度" : "Nonreciprocity strength"} />
    </div>
    <button class="simbtn" id="nr-reset">{zh ? "重置" : "Reset"}</button>
  </div>

  <div class="frontier-readout" aria-live="polite">
    <span>{zh ? "状态" : "state"} <b id="nr-state">—</b></span>
    <span>{zh ? "平均速度" : "mean speed"} <b id="nr-speed">—</b></span>
  </div>
</Panel>
