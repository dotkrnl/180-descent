---
import Panel from "@app/components/lesson/Panel.astro";
import PanelNote from "@app/components/lesson/PanelNote.astro";
import PanelTitle from "@app/components/lesson/PanelTitle.astro";

interface Props {
  locale?: "en" | "zh";
}

const zh = Astro.props.locale === "zh";
const copy = zh ? {
  panelTitle: "交互 · 从另一个方向学习与第 1 日相同的课程",
  heading: "准确性支配",
  note: "设定你对下一张牌为红色 (S) 以及不是红色 (¬S) 的置信度——这两个拨盘与第 1 日的荷兰赌相同。图表将你的置信度显示为一个点。两个角落是世界仅有的两种可能状态。融贯的置信度位于连接它们的直线上。偏离这条线，就会有一个融贯的点比你更接近两个角落——无论实际情况如何，它都比你的置信度更接近事实。",
  sLabel: "对 S 的置信度——「下一张牌为红色」",
  nLabel: "对 ¬S 的置信度——「下一张牌不是红色」",
  sAria: "对 S 的置信度",
  nAria: "对 ¬S 的置信度",
  ledgerTitle: "融贯——未被支配",
  ledgerBody: "你的置信度之和等于 1，所以该点位于线上。在每一个世界中，没有其他置信度比它更接近事实。这是对准确性的基本要求——与第 1 日荷兰赌判断相同，且无需进行任何投注即可达成。",
  snap: "↳ 吸附到融贯线上",
  aria: "一个单位正方形，绘制了对 S 的置信度与对 ¬S 的置信度，包含两个真值角和融贯线。",
  axisS: "对 S 的置信度 →",
  axisN: "对 ¬S 的置信度 →",
  line: "融贯：总和 = 1",
  worldTrue: "世界：S 为真",
  worldFalse: "世界：S 为假",
  caption: "在线上：没有什么能在真值上胜过你。"
} : {
  panelTitle: "Interactive · the same lesson as Day 1, from a different direction",
  heading: "Accuracy Domination",
  note: "Set your confidence that the next card is red (S) and that it's not red (¬S) — the same two dials as Day 1's Dutch book. The plot shows your credence as a point. The two corners are the only two ways the world can be. Coherent credences lie on the line between them. Step off it, and a single coherent point gets closer to both corners than you are — it beats you on truth, guaranteed.",
  sLabel: 'Credence in S — "next card is red"',
  nLabel: 'Credence in ¬S — "next card is not red"',
  sAria: "Credence in S",
  nAria: "Credence in not S",
  ledgerTitle: "Coherent — undominated",
  ledgerBody: "Your credences sum to 1, so the point sits on the line. No other credence is closer to the truth in every world. This is the bare demand of accuracy — the same conclusion as Day 1's Dutch book, reached without a single bet.",
  snap: "↳ Snap onto the coherence line",
  aria: "A unit square plotting credence in S against credence in not-S, with the two truth-corners and the coherence line.",
  axisS: "credence in S →",
  axisN: "credence in ¬S →",
  line: "coherent: sum = 1",
  worldTrue: "world: S true",
  worldFalse: "world: S false",
  caption: "On the line: nothing beats you on truth."
};
---
<Panel class="web-only accuracy-domination">
  <PanelTitle>{copy.panelTitle}</PanelTitle>

  <h3>{copy.heading}</h3>

  <PanelNote>{copy.note}</PanelNote>

  <div class="acc-grid">
    <div>
      <div class="slider-row">
        <label>{copy.sLabel} <span class="val accuracy-s-value" id="appendix-d001-the-edge-of-the-map-aS">0.50</span></label>
        <input type="range" id="appendix-d001-the-edge-of-the-map-raS" min="0" max="100" value="50" aria-label={copy.sAria} class="accuracy-s-range" />
      </div>
      <div class="slider-row">
        <label>{copy.nLabel} <span class="val accuracy-n-value" id="appendix-d001-the-edge-of-the-map-aN">0.50</span></label>
        <input type="range" id="appendix-d001-the-edge-of-the-map-raN" min="0" max="100" value="50" aria-label={copy.nAria} class="accuracy-n-range" />
      </div>
      <div class="acc-ledger coherent accuracy-ledger" id="appendix-d001-the-edge-of-the-map-aLedger">
        <p class="lh accuracy-ledger-title" id="appendix-d001-the-edge-of-the-map-aLh">{copy.ledgerTitle}</p>
        <p id="appendix-d001-the-edge-of-the-map-aBody" class="accuracy-ledger-body u-m-0">{copy.ledgerBody}</p>
      </div>
      <button class="snap accuracy-snap" id="appendix-d001-the-edge-of-the-map-aSnap">{copy.snap}</button>
    </div>
    <div class="acc-plot">
      <svg id="appendix-d001-the-edge-of-the-map-accSvg" viewBox="0 0 300 300" role="img" aria-label={copy.aria}>
        <rect x="46" y="46" width="200" height="200" fill="none" stroke="var(--line-strong)" stroke-width="1.4"></rect>
        <text x="146" y="276" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="10.5" fill="var(--ink-faint)">{copy.axisS}</text>
        <text x="20" y="146" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="10.5" fill="var(--ink-faint)" transform="rotate(-90 20 146)">{copy.axisN}</text>
        <line x1="246" y1="246" x2="46" y2="46" stroke="var(--accent)" stroke-width="2"></line>
        <text x="170" y="120" font-family="IBM Plex Mono,monospace" font-size="10.5" fill="var(--accent)" transform="rotate(-45 170 120)">{copy.line}</text>
        <circle cx="246" cy="246" r="6" fill="var(--ok)"></circle>
        <text x="246" y="262" text-anchor="end" font-family="IBM Plex Mono,monospace" font-size="10.5" fill="var(--ok)">{copy.worldTrue}</text>
        <circle cx="46" cy="46" r="6" fill="var(--hint)"></circle>
        <text x="52" y="40" text-anchor="start" font-family="IBM Plex Mono,monospace" font-size="10.5" fill="var(--hint)">{copy.worldFalse}</text>
        <g id="appendix-d001-the-edge-of-the-map-accPlines" stroke="var(--contested)" stroke-width="1.3" stroke-dasharray="3 3" opacity=".75">
          <line id="appendix-d001-the-edge-of-the-map-lp1" x1="146" y1="146" x2="246" y2="246" class="accuracy-point-line-s"></line>
          <line id="appendix-d001-the-edge-of-the-map-lp2" x1="146" y1="146" x2="46" y2="46" class="accuracy-point-line-not"></line>
        </g>
        <g id="appendix-d001-the-edge-of-the-map-accSlines" stroke="var(--ok)" stroke-width="1.3" opacity="0" class="accuracy-star-lines">
          <line id="appendix-d001-the-edge-of-the-map-ls1" x1="146" y1="146" x2="246" y2="246" class="accuracy-star-line-s"></line>
          <line id="appendix-d001-the-edge-of-the-map-ls2" x1="146" y1="146" x2="46" y2="46" class="accuracy-star-line-not"></line>
        </g>
        <line id="appendix-d001-the-edge-of-the-map-accConn" x1="146" y1="146" x2="146" y2="146" stroke="var(--ink-faint)" stroke-width="1.2" stroke-dasharray="2 3" class="accuracy-connector"></line>
        <circle id="appendix-d001-the-edge-of-the-map-accStar" cx="146" cy="146" r="5.5" fill="var(--ok)" opacity="0" class="accuracy-star"></circle>
        <circle id="appendix-d001-the-edge-of-the-map-accP" cx="146" cy="146" r="6.5" fill="var(--ink)" class="accuracy-point"></circle>
      </svg>
      <p class="figcap accuracy-caption" id="appendix-d001-the-edge-of-the-map-accCap">{copy.caption}</p>
    </div>
  </div>
</Panel>
