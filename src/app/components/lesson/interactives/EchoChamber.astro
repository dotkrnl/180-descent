---
import Panel from "@app/components/lesson/Panel.astro";
import PanelNote from "@app/components/lesson/PanelNote.astro";
import PanelTitle from "@app/components/lesson/PanelTitle.astro";

interface Props {
  locale?: "en" | "zh";
}

const zh = Astro.props.locale === "zh";
const copy = zh ? {
  panelTitle: "互动 · 为什么「只展示事实」会适得其反",
  heading: "气泡与回声室",
  note: "选择一个结构，然后点击接触外部声音——这是最常见的提议方案。观察它在两种情况下产生的截然不同的结果。（中心 = 你；蓝色 = 信任的内部来源；边缘的三个节点 = 外部声音。）",
  bubble: "认知气泡",
  chamber: "回声室",
  aria: "一个由你、内部来源和外部声音组成的网络。",
  center: "你",
  outside: "外部声音",
  expose: "▶ 接触外部声音",
  initialTitle: "认知气泡",
  initialBody: "外部声音根本不在这里——不是被反驳，而是缺失。气泡是脆弱的：它仅靠缺乏接触而存在。"
} : {
  panelTitle: 'Interactive · why "just show them the facts" backfires',
  heading: "Bubble vs. Chamber",
  note: "Pick a structure, then hit Expose to outside voices — the single most common proposed fix. Watch it do opposite things to the two cases. (Center = you; blue = trusted inside sources; the three edge nodes = outside voices.)",
  bubble: "Epistemic bubble",
  chamber: "Echo chamber",
  aria: "A network of you, inside sources, and outside voices.",
  center: "YOU",
  outside: "outside voices",
  expose: "▶ Expose to outside voices",
  initialTitle: "An epistemic bubble",
  initialBody: "Outside voices simply aren't here — not refuted, just missing. A bubble is fragile: it survives only on lack of exposure."
};
---
<Panel class="web-only echo-chamber">
  <PanelTitle>{copy.panelTitle}</PanelTitle>

  <h3>{copy.heading}</h3>

  <PanelNote>{copy.note}</PanelNote>

  <div class="echo-wrap">
    <div class="tbtns">
      <button class="tbtn" data-mode="bubble" aria-pressed="true">{copy.bubble}</button>
      <button class="tbtn" data-mode="chamber">{copy.chamber}</button>
    </div>
    <svg id="appendix-d001-the-edge-of-the-map-echoSvg" viewBox="0 0 420 290" role="img" aria-label={copy.aria}>
      <g id="appendix-d001-the-edge-of-the-map-echoInLinks" stroke="var(--accent)" stroke-width="1.6">
        <line x1="210" y1="150" x2="150" y2="100"></line>
        <line x1="210" y1="150" x2="270" y2="100"></line>
        <line x1="210" y1="150" x2="150" y2="200"></line>
        <line x1="210" y1="150" x2="270" y2="200"></line>
      </g>
      <g id="appendix-d001-the-edge-of-the-map-echoOutLinks" stroke-width="1.8" stroke-dasharray="4 4" opacity="0" class="echo-out-links">
        <line id="appendix-d001-the-edge-of-the-map-ol1" x1="210" y1="150" x2="55" y2="58"></line>
        <line id="appendix-d001-the-edge-of-the-map-ol2" x1="210" y1="150" x2="55" y2="240"></line>
        <line id="appendix-d001-the-edge-of-the-map-ol3" x1="210" y1="150" x2="378" y2="150"></line>
      </g>
      <g>
        <circle cx="150" cy="100" r="13" fill="color-mix(in srgb,var(--accent) 22%,var(--paper))" stroke="var(--accent)" stroke-width="1.8"></circle>
        <circle cx="270" cy="100" r="13" fill="color-mix(in srgb,var(--accent) 22%,var(--paper))" stroke="var(--accent)" stroke-width="1.8"></circle>
        <circle cx="150" cy="200" r="13" fill="color-mix(in srgb,var(--accent) 22%,var(--paper))" stroke="var(--accent)" stroke-width="1.8"></circle>
        <circle cx="270" cy="200" r="13" fill="color-mix(in srgb,var(--accent) 22%,var(--paper))" stroke="var(--accent)" stroke-width="1.8"></circle>
      </g>
      <circle cx="210" cy="150" r="20" fill="color-mix(in srgb,var(--brass) 20%,var(--paper))" stroke="var(--brass)" stroke-width="2.4"></circle>
      <text x="210" y="154" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="10.5" fill="var(--ink)">{copy.center}</text>
      <g id="appendix-d001-the-edge-of-the-map-echoOut">
        <g id="appendix-d001-the-edge-of-the-map-o1" class="echo-out-node"><circle cx="55" cy="58" r="13" stroke-width="1.8"></circle><text x="55" y="62" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="11"></text></g>
        <g id="appendix-d001-the-edge-of-the-map-o2" class="echo-out-node"><circle cx="55" cy="240" r="13" stroke-width="1.8"></circle><text x="55" y="244" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="11"></text></g>
        <g id="appendix-d001-the-edge-of-the-map-o3" class="echo-out-node"><circle cx="378" cy="150" r="13" stroke-width="1.8"></circle><text x="378" y="154" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="11"></text></g>
      </g>
      <text x="55" y="20" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="10.5" fill="var(--ink-faint)">{copy.outside}</text>
    </svg>
    <div class="echo-action"><button id="appendix-d001-the-edge-of-the-map-echoExpose" class="echo-expose">{copy.expose}</button></div>
    <div class="echo-msg neutral echo-message" id="appendix-d001-the-edge-of-the-map-echoMsg"><span class="ttl">{copy.initialTitle}</span>{copy.initialBody}</div>
  </div>
</Panel>
