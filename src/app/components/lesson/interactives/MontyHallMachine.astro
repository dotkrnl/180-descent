---
interface Props {
  locale?: "en" | "zh";
}

const zh = Astro.props.locale === "zh";
const copy = zh ? {
  oddsLabel: "策略胜率",
  stayOdds: "坚持保留第一次选择",
  switchOdds: "换门接住未选的组合",
  door: (n: number) => `${n} 号门`,
  pick: "选择",
  step: "步骤 1",
  mode: "先选门",
  say: "选一扇门",
  sayTail: "开始。",
  again: "再来一局 →",
  stayTitle: "如果每次都坚持",
  switchTitle: "如果每次都换门",
  wins: "— 胜率",
  autoLabel: "大规模实验（教师实验法的自动化版本）",
  auto: "自动运行 1000 次",
  reset: "重置计数"
} : {
  oddsLabel: "Strategy odds",
  stayOdds: "Stay keeps the first pick",
  switchOdds: "Switch takes the unchosen pair",
  door: (n: number) => `Door ${n}`,
  pick: "Pick",
  step: "Step 1",
  mode: "Pick first",
  say: "Pick a door",
  sayTail: " to begin.",
  again: "Play again →",
  stayTitle: "If you always STAY",
  switchTitle: "If you always SWITCH",
  wins: "— wins",
  autoLabel: "Run the experiment at scale (the schoolteachers' method, automated)",
  auto: "Auto-run 1,000×",
  reset: "Reset tallies"
};
---
<div class="mh-machine" id="mhMachine">
  <div class="mh-odds" aria-label={copy.oddsLabel}>
    <div class="mh-odd stay"><span>{copy.stayOdds}</span><span class="mh-odd-value">1/3</span></div>
    <div class="mh-odd switch"><span>{copy.switchOdds}</span><span class="mh-odd-value">2/3</span></div>
  </div>

  <div class="mh-stage" id="mhStage">
    {[1, 2, 3].map((door, index) => (
      <button class="mh-door" data-door={String(index)} id={`door${index}`} type="button">
        <span class="mh-door-face" aria-hidden="true">
          <span class="mh-door-number">{door}</span>
          <span class="mh-door-panel top"></span>
          <span class="mh-door-panel bottom"></span>
          <span class="mh-door-knob"></span>
          <span class="prizeholder"></span>
        </span>
        <span class="dlab">{copy.door(door)}</span>
        <span class="daction" aria-hidden="true">{copy.pick}</span>
      </button>
    ))}
  </div>

  <div class="mh-status">
    <span class="mh-step" id="mhStep">{copy.step}</span>
    <span class="mh-mode" id="mhMode">{copy.mode}</span>
    <p class="mh-say" id="mhSay" aria-live="polite"><span class="hl">{copy.say}</span>{copy.sayTail}</p>
  </div>

  <div class="mh-controls" id="mhNextWrap" hidden>
    <button class="btn ghost" id="btnNext" type="button">{copy.again}</button>
  </div>

  <div class="mh-tally">
    <div class="tcard stay">
      <p class="th">{copy.stayTitle}</p>
      <div class="big"><span id="stayWins">0</span> / <span id="stayPlays">0</span></div>
      <div class="pct" id="stayPct">{copy.wins}</div>
    </div>
    <div class="tcard switch">
      <p class="th">{copy.switchTitle}</p>
      <div class="big"><span id="switchWins">0</span> / <span id="switchPlays">0</span></div>
      <div class="pct" id="switchPct">{copy.wins}</div>
    </div>
  </div>

  <div class="mh-auto">
    <span class="h">{copy.autoLabel}</span>
    <button class="btn" id="btnAuto" type="button">{copy.auto}</button>
    <button class="btn ghost" id="btnReset" type="button">{copy.reset}</button>
  </div>
</div>
