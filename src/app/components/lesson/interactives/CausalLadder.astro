---
import Panel from "@app/components/lesson/Panel.astro";
import PanelNote from "@app/components/lesson/PanelNote.astro";
import PanelTitle from "@app/components/lesson/PanelTitle.astro";

interface Props {
  locale?: "en" | "zh";
}

const zh = Astro.props.locale === "zh";
const copy = zh ? {
  panelTitle: "互动 · 攀爬因果之梯",
  heading: "因果性的三个阶梯",
  note: "点击阶梯。每一层都增加了一个动词、一个记号以及一个下一层「无法」回答的问题。从第 1 层到第 2 层的跨越，正是今天我们要探讨的全部内容。",
  rungs: [
    ["3", "想象", "反事实", "「要是当时我服下了阿司匹林，头痛现在是不是已经好了？——考虑到我当时并没服药，且现在还在疼。」"],
    ["2", "行动", "干预", "「如果我服下这片阿司匹林，我的头痛会消失吗？」"],
    ["1", "观察", "关联", "「在服用阿司匹林的人群中，头痛得到改善的比例与未服用人群相比如何？」"]
  ],
  aria: "一个三级阶梯；选择某一层会更新解释。",
  labels: ["想象", "干预", "观察"],
  rungAria: ["选择第 3 层，反事实", "选择第 2 层，干预", "选择第 1 层，关联"]
} : {
  panelTitle: "Interactive · climb the ladder",
  heading: "The Three Rungs of Causation",
  note: "Tap a rung. Each adds a verb, a piece of notation, and a question the rung below cannot answer. The jump from Rung 1 to Rung 2 is the entire subject of today.",
  rungs: [
    ["3", "Imagining", "Counterfactuals", '"Would my headache be gone had I taken the aspirin — given that I didn\'t, and it still hurts?"'],
    ["2", "Doing", "Intervention", '"If I take an aspirin, will my headache go away?"'],
    ["1", "Seeing", "Association", '"Among people who took aspirin, how often did the headache improve compared with people who did not?"']
  ],
  aria: "A three-rung ladder; select a rung to update the explanation.",
  labels: ["imagine", "do", "see"],
  rungAria: ["Select rung 3, counterfactuals", "Select rung 2, interventions", "Select rung 1, association"]
};
---
<Panel class="web-only causation-ladder">
  <PanelTitle>{copy.panelTitle}</PanelTitle>
  <h3>{copy.heading}</h3>
  <PanelNote>{copy.note}</PanelNote>

  <div class="ladder-grid">
    <div class="rung-btns" id="rungBtns">
      {copy.rungs.map(([num, verb, title, question]) => (
        <button class="rungbtn" type="button" data-rung={num} aria-pressed={num === "2" ? "true" : "false"}>
          <span class="num">{num}</span>
          <span class="lab"><span class="verb">{verb}</span><b>{title}</b><span class="q">{question}</span></span>
        </button>
      ))}
    </div>

    <div class="ladder-vis">
      <svg viewBox="0 0 300 240" role="group" aria-label={copy.aria}>
        <line x1="70" y1="20" x2="70" y2="226" stroke="var(--line-strong)" stroke-width="4" stroke-linecap="round"></line>
        <line x1="230" y1="20" x2="230" y2="226" stroke="var(--line-strong)" stroke-width="4" stroke-linecap="round"></line>
        {[["lr3", "3", 30, 56, 40, copy.labels[0], copy.rungAria[0]], ["lr2", "2", 102, 128, 112, copy.labels[1], copy.rungAria[1]], ["lr1", "1", 174, 200, 184, copy.labels[2], copy.rungAria[2]]].map(([id, rung, rectY, lineY, textY, label, aria]) => (
          <g id={id} class="ladder-rung-hotspot" data-rung={rung} role="button" tabindex="0" aria-label={aria}>
            <rect x="50" y={rectY} width="200" height="42" fill="transparent" pointer-events="all"></rect>
            <line x1="70" y1={lineY} x2="230" y2={lineY} stroke="var(--ink-faint)" stroke-width="6" stroke-linecap="round"></line>
            <text x="150" y={textY} text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="11" fill="var(--ink-faint)">{label}</text>
          </g>
        ))}
        <circle id="climber" cx="150" cy="128" r="11" fill="var(--accent)" stroke="var(--raised)" stroke-width="3"></circle>
      </svg>
      <div class="rung-detail" id="rungDetail" aria-live="polite"></div>
    </div>
  </div>
</Panel>
