---
import MathInline from "@app/components/lesson/MathInline.astro";
import Panel from "@app/components/lesson/Panel.astro";
import PanelNote from "@app/components/lesson/PanelNote.astro";
import PanelTitle from "@app/components/lesson/PanelTitle.astro";

interface Props {
  locale?: "en" | "zh";
}

const zh = Astro.props.locale === "zh";
const copy = zh ? {
  panelTitle: "交互 · 赌徒的账本",
  heading: "对「公平」硬币下注",
  noteStart: "这里要检验的命题是原假设：硬币公平，",
  noteMiddle: "。滑块设置的是模拟器真正用来生成数据的",
  noteAfter: "；在真实实验里，这个值当然不会告诉检验者。设为",
  noteEnd: "时，原假设为真；设为 0.65 或 0.35 时，原假设为假。这个小工具只问数据是否足以强烈反对「公平」，不负责估计精确偏差。e 值策略会逐次抛掷，对「公平」下注。若财富达到 20，这场赌就「赢」到足以在 0.05 水平拒绝公平；若财富停在 1 附近或下滑，就表示这场赌还没有找到反对公平的证据。",
  actual: "模拟中的真实正面概率：",
  flip: "抛 25 次",
  reset: "重置",
  nullNote: "原假设：硬币公平（",
  chartAria: "下注策略在逐次抛掷中财富变化的对数坐标图。",
  xAxis: "抛掷次数 →",
  wealthTitle: "当前财富（e 值）",
  wealthSub: "1 美元平分到两张赌票",
  flipsTitle: "已抛掷次数",
  heads: "0 次正面",
  verdictTitle: "裁决",
  verdict: "收集数据中…",
  verdictSub: "需财富 ≥ 20",
  captionStart: "把模拟中的真实",
  captionEnd: "设为 0.50，原假设就为真：多数财富路径只会徘徊或缓缓下滑，只有极少数好运路径能爬到 20。拨到 0.65 或 0.35，数据就来自一枚有偏硬币，其中一张赌票往往会复利增长。向上冲的曲线，是下注策略赢了，也是反对公平的证据；持平或下滑的曲线，则是这场赌输了，意思是「继续收集」或「不拒绝」，不是「已经证明硬币公平」。"
} : {
  panelTitle: "Interactive · the gambler's ledger",
  heading: 'Betting against a "fair" coin',
  noteStart: "The claim being tested is the null: the coin is fair,",
  noteMiddle: ". The slider sets the simulator's actual data-generating",
  noteAfter: ", hidden from the test in a real experiment. At",
  noteEnd: "the null is true; at 0.65 or 0.35 the null is false. This widget is asking only whether the data give strong evidence against fairness, not what the exact bias is. The e-value strategy bets against fairness flip by flip. If wealth reaches 20, the bet has won enough to reject fairness at level 0.05; if wealth stays near 1 or falls, the bet has not found evidence against fairness.",
  actual: "Actual",
  flip: "Flip 25×",
  reset: "Reset",
  nullNote: "null: coin is fair (",
  chartAria: "Wealth of the betting strategy over successive coin flips, on a log scale.",
  xAxis: "flips →",
  wealthTitle: "Current wealth (e-value)",
  wealthSub: "$1 split across two tickets",
  flipsTitle: "Flips so far",
  heads: "0 heads",
  verdictTitle: "Verdict",
  verdict: "collecting…",
  verdictSub: "need wealth ≥ 20",
  captionStart: "Set actual",
  captionEnd: "to exactly 0.50 and the null is true: most wealth paths hover or sag, and only rare lucky streaks reach 20. Nudge it to 0.65 or 0.35 and the data now come from a biased coin, so one of the two tickets tends to compound. The upward march is a win for the betting strategy and evidence against fairness; a flat or falling line is a loss for that bet, meaning \"keep collecting\" or \"do not reject,\" not \"the coin is proven fair.\""
};
---
<Panel class="web-only probability-evalue">
  <PanelTitle>{copy.panelTitle}</PanelTitle>

  <h3>{copy.heading}</h3>

  <PanelNote>{copy.noteStart} <MathInline latex={String.raw`\mathrm{P}(\text{heads}) = 0.5`} />{copy.noteMiddle} <MathInline latex={String.raw`\mathrm{P}(\text{heads})`} />{copy.noteAfter} <MathInline latex={String.raw`0.50`} /> {copy.noteEnd}</PanelNote>

  <div class="ev-controls">
    <label>
      {copy.actual} <MathInline latex={String.raw`\mathrm{P}(\text{heads})`} />:
      <input type="range" id="rBias" min="20" max="80" value="50" />
      <span class="val" id="vBias">0.50</span>
    </label>
  </div>
  <div class="ev-controls">
    <button class="btn" id="btnFlip">{copy.flip}</button>
    <button class="btn ghost" id="btnEvReset">{copy.reset}</button>
    <span class="note">{copy.nullNote}<MathInline latex={String.raw`p = 0.5`} />)</span>
  </div>

  <div class="ev-chart">
    <svg id="evChart" viewBox="0 0 480 220" role="img" aria-label={copy.chartAria}>
      <line x1="44" y1="20" x2="44" y2="188" stroke="var(--line-strong)" stroke-width="1"></line>
      <line x1="44" y1="188" x2="468" y2="188" stroke="var(--line-strong)" stroke-width="1"></line>
      <line id="line20" x1="44" y1="60" x2="468" y2="60" stroke="var(--ok)" stroke-width="1" stroke-dasharray="4 4" opacity="0.7"></line>
      <line id="line1" x1="44" y1="124" x2="468" y2="124" stroke="var(--ink-faint)" stroke-width="1" stroke-dasharray="2 4" opacity="0.6"></line>
      <text x="40" y="63" text-anchor="end" font-family="IBM Plex Mono,monospace" font-size="10.5" fill="var(--ok)">20</text>
      <text x="40" y="127" text-anchor="end" font-family="IBM Plex Mono,monospace" font-size="10.5" fill="var(--ink-faint)">1</text>
      <text x="40" y="191" text-anchor="end" font-family="IBM Plex Mono,monospace" font-size="10.5" fill="var(--ink-faint)">.05</text>
      <text x="240" y="208" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="10.5" fill="var(--ink-faint)">{copy.xAxis}</text>
      <polyline id="evLine" points="" fill="none" stroke="var(--accent)" stroke-width="2"></polyline>
    </svg>
  </div>

  <div class="ev-readout">
    <div class="evcard ev-wealth">
      <p class="th">{copy.wealthTitle}</p>
      <div class="big" id="evWealth">1.00</div>
      <div class="sub">{copy.wealthSub}</div>
    </div>
    <div class="evcard ev-flips">
      <p class="th">{copy.flipsTitle}</p>
      <div class="big" id="evFlips">0</div>
      <div class="sub" id="evHeads">{copy.heads}</div>
    </div>
    <div class="evcard ev-verdict" id="evVerdict">
      <p class="th">{copy.verdictTitle}</p>
      <div class="big" id="evVerdictTxt">{copy.verdict}</div>
      <div class="sub" id="evVerdictSub">{copy.verdictSub}</div>
    </div>
  </div>
  <p style="font-size:.82em;color:var(--ink-soft);margin:1rem 0 0;">{copy.captionStart} <MathInline latex={String.raw`\mathrm{P}(\text{heads})`} /> {copy.captionEnd}</p>
</Panel>
