---
interface Props {
  as?: "div" | "p";
  class?: string;
  media: "web" | "print" | "epub" | "print-epub" | "deep-dive-epub" | "deep-dive-print";
  variant?: "alternate";
}

const Tag = Astro.props.as ?? "p";
const mediaClasses: Record<Props["media"], string> = {
  web: "web-only",
  print: "print-only",
  epub: "epub-only",
  "print-epub": "epub-only print-only",
  "deep-dive-epub": "epub-only deep-dive-edition-only",
  "deep-dive-print": "print-only deep-dive-edition-only"
};
const variantClass = Astro.props.variant === "alternate" ? "format-alt" : undefined;
const className = [mediaClasses[Astro.props.media], variantClass, Astro.props.class].filter(Boolean).join(" ");
---
<Tag class={className}><slot /></Tag>
