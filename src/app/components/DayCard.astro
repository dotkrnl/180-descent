---
import { padDay, type ContentDay } from "@app/site-data";

interface Props {
  day: ContentDay;
  locale: "en" | "zh";
  totalDays: number;
}

const { day, locale, totalDays } = Astro.props;
const kicker = locale === "zh"
  ? `第 ${padDay(day.day)} 日 / ${totalDays}`
  : `Day ${padDay(day.day)} / ${totalDays}`;
---
<article class="day-card">
  <p class="card-kicker">{kicker}</p>
  <h3><a href={day.url}>{day.title}</a></h3>
  {day.summary && <p>{day.summary}</p>}
</article>
