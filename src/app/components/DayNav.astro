---
import type { Locale } from "@lib/schemas/day";
import type { DayNavEntry } from "@app/day-route";
import { dayUrl, staticPageUrl } from "@lib/static-site/routes";

interface Props {
  locale: Locale;
  previous?: DayNavEntry;
  next?: DayNavEntry;
  position: "top" | "bottom";
}

const { locale, previous, next, position } = Astro.props;
const isZh = locale === "zh";
const navDayLabel = (day: number) => {
  const value = String(day).padStart(3, "0");
  return isZh ? `第${value}日` : `Day ${value}`;
};
const navHref = (item: DayNavEntry) => dayUrl(locale, item.path);
const positionName = position === "top" ? (isZh ? "顶部" : "Top") : (isZh ? "底部" : "Bottom");
const ariaLabel = isZh ? `日课导航（${positionName}）` : `${positionName} day navigation`;
const className = `lesson-nav lesson-nav-${position} wrap wide`;
---
<nav class={className} aria-label={ariaLabel}>
  {previous ? (
    <a class="lesson-nav-card lesson-nav-previous" href={navHref(previous)}>
      <span class="lesson-nav-kicker" aria-hidden="true">‹</span>
      <strong class="lesson-nav-title"><span class="lesson-nav-day">{navDayLabel(previous.day)}</span><span class="lesson-nav-separator"> · </span><span class="lesson-nav-name">{previous.title}</span></strong>
    </a>
  ) : (
    <span class="lesson-nav-card lesson-nav-previous is-disabled" aria-hidden="true">
      <span class="lesson-nav-kicker">‹</span>
      <strong class="lesson-nav-title">{isZh ? "起点" : "Start"}</strong>
    </span>
  )}
  <a class="lesson-nav-card is-syllabus lesson-nav-syllabus" href={staticPageUrl(locale, "syllabus")}>
    <span class="lesson-nav-kicker">{isZh ? "课程表" : "Map"}</span>
    <strong class="lesson-nav-title">{isZh ? "完整课程表" : "Full syllabus"}</strong>
  </a>
  {position === "top" && (
    <button class="lesson-nav-card is-syllabus lesson-nav-contents toc-fab" type="button" data-rail-fab aria-controls="lessonRail" aria-expanded="false" hidden>
      <span class="fab-glyph" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="lesson-nav-kicker">{isZh ? "本页目录" : "Contents"}</span>
    </button>
  )}
  {next ? (
    <a class="lesson-nav-card lesson-nav-next" href={navHref(next)}>
      <span class="lesson-nav-kicker" aria-hidden="true">›</span>
      <strong class="lesson-nav-title"><span class="lesson-nav-day">{navDayLabel(next.day)}</span><span class="lesson-nav-separator"> · </span><span class="lesson-nav-name">{next.title}</span></strong>
    </a>
  ) : (
    <span class="lesson-nav-card lesson-nav-next is-disabled" aria-hidden="true">
      <span class="lesson-nav-kicker">›</span>
      <strong class="lesson-nav-title">{isZh ? "前沿" : "Frontier"}</strong>
    </span>
  )}
</nav>
