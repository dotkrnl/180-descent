---
import BookShell from "@app/layouts/BookShell.astro";
import DayCard from "@app/components/DayCard.astro";
import { getBookData, getContentDays, getSyllabus, padDay } from "@app/site-data";
import type { Locale } from "@lib/schemas/day";
import { alternateLocale, homeUrl, staticPageUrl } from "@lib/static-site/routes";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const book = await getBookData();
const [days, syllabus] = await Promise.all([getContentDays(locale), getSyllabus(locale)]);
const isZh = locale === "zh";
const homePath = homeUrl(locale);
const alternatePath = homeUrl(alternateLocale(locale));
const downloads = isZh ? book.zh.downloads : book.downloads;
const publishedDays = [...days].sort((a, b) => a.day - b.day);
const firstPublishedDay = publishedDays[0];
const latestPublishedDays = [...publishedDays].reverse().slice(0, 8);
const featuredDay = latestPublishedDays[0];
const recentDays = latestPublishedDays.slice(1);
const currentFrontier = publishedDays.at(-1);
const syllabusUrl = staticPageUrl(locale, "syllabus");
const readingStartUrl = firstPublishedDay?.url ?? syllabusUrl;
const readingStartLabel = firstPublishedDay
  ? (isZh ? `从第 ${firstPublishedDay.day} 日开始` : `Start Day ${firstPublishedDay.day}`)
  : (isZh ? "查看课程表" : "View the syllabus");
const readingDays = days.map((day) => ({
  day: day.day,
  url: day.url,
  label: isZh ? `第${padDay(day.day)}日 · ${day.title}` : `Day ${padDay(day.day)} · ${day.title}`,
  title: day.title,
  summary: day.summary
}));
const blockCount = syllabus.blocks.length;
// The atlas legend strips the "+ DEEP DIVE …" tail from block titles so long
// EN/ZH titles read cleanly at the 1-line cap; a small ◈ glyph flags the row.
const deepDiveTailRe = /\s+\+\s+(?:DEEP DIVE|专题深入)\s+\d+[:：].*$/i;
const capstoneTailRe = /\s+\+\s+(?:Capstone|顶点)$/i;
const strata = syllabus.blocks.map((block, index) => {
  const total = block.endDay - block.startDay + 1;
  const publishedInBlock = publishedDays.filter((day) => day.day >= block.startDay && day.day <= block.endDay).length;
  const hasDeepDive = deepDiveTailRe.test(block.title) || capstoneTailRe.test(block.title);
  const isCurrent = currentFrontier
    ? currentFrontier.day >= block.startDay && currentFrontier.day <= block.endDay
    : false;
  const compactTitle = block.title.replace(deepDiveTailRe, "").replace(capstoneTailRe, "");
  return {
    id: block.id,
    title: compactTitle,
    fullTitle: block.title,
    hasDeepDive,
    isCurrent,
    hue: Math.round(200 + (index * 100) / Math.max(1, blockCount - 1)),
    startDay: block.startDay,
    endDay: block.endDay,
    total,
    publishedInBlock,
    fill: publishedInBlock / total
  };
});
const publishedPercent = Math.round((publishedDays.length / book.totalDays) * 100);
// Featured-day block hue: keeps the "current frontier" card's top-rule
// coloured to match the atlas row it stands in for.
const featuredBlockIndex = featuredDay
  ? Math.max(0, syllabus.blocks.findIndex((b) => featuredDay.day >= b.startDay && featuredDay.day <= b.endDay))
  : 0;
const featuredBlockHue = Math.round(200 + (featuredBlockIndex * 100) / Math.max(1, blockCount - 1));
// Hyphenated compounds ("180-Day") must never break mid-word on the cover.
const coverTitleParts = book.title.split(" ");
---
<BookShell
  title={isZh ? "首页" : "Home"}
  description={isZh ? "在线阅读并下载《深入一百八十日》。" : "Browse and download The 180-Day Descent."}
  locale={locale}
  pageKind="home"
  canonicalPath={homePath}
  alternatePath={alternatePath}
>
  <div class="atlas-home">
    <section class="cover" aria-labelledby="atlas-home-title">
      <div class="cover-inner">
        <div class="cover-text" data-reading-card data-reading-locale={locale} data-reading-continue-kicker={isZh ? "继续阅读" : "Continue where you left off"}>
          <p class="eyebrow">{isZh ? book.zh.subtitle : book.subtitle}</p>
          <h1 id="atlas-home-title">{isZh ? book.zh.title : coverTitleParts.map((part, index) => (
            <Fragment>{index > 0 ? " " : ""}{part.includes("-") ? <span class="title-compound">{part}</span> : part}</Fragment>
          ))}</h1>
          {isZh ? (
            <p class="sub book-credit">
              <span class="credit-line">一门按知识依赖关系编排的现代科学与思想入门课程。</span>
              <span class="credit-line">作者：{book.zh.authors}</span>
            </p>
          ) : (
            <p class="sub book-credit">
              <span class="credit-line">A dependency-ordered introduction to modern science and thought.</span>
              <span class="credit-line">By {book.authors}.</span>
            </p>
          )}
          <dl class="cover-metadata">
            <div>
              <dt>{isZh ? "全书结构" : "Blocks"}</dt>
              <dd>{isZh ? `${syllabus.blocks.length} 个模块 · 180 日` : `${syllabus.blocks.length} blocks · 180 days`}</dd>
            </div>
            <div>
              <dt>{isZh ? "最新一日" : "Latest lesson"}</dt>
              <dd>{currentFrontier ? (isZh ? `第 ${padDay(currentFrontier.day)} 日` : `Day ${padDay(currentFrontier.day)}`) : (isZh ? "首日尚未发布" : "Publication begins Day 001")}</dd>
            </div>
          </dl>
          <p class="cover-kicker" data-reading-kicker>{isZh ? "开始阅读" : "Start reading"}</p>
          <div class="cover-actions">
            <a class="cover-cta" href={readingStartUrl} data-reading-link>{readingStartLabel}</a>
            <a class="cover-map-link" href={syllabusUrl}>{isZh ? "查看完整课程表" : "See the syllabus"}</a>
          </div>
        </div>
        <a class="cover-chart" href={syllabusUrl} data-map-label={isZh ? "课程总览 / 001—180" : "Syllabus / 001—180"}>
          <span class="sr-only">{isZh ? "十三个模块的课程总览，进入课程表" : "The thirteen-block syllabus; opens the full route"}</span>
          <span class="atlas-map-head" aria-hidden="true">
            <span>
              <small>{isZh ? "课程总览" : "Progress"}</small>
              <strong>{isZh ? "从基础到前沿" : "Foundations to frontier"}</strong>
            </span>
            <b>{publishedPercent}%</b>
          </span>
          <span class="atlas-map-body">
            {strata.map((stratum) => (
              <span
                class:list={["stratum", "block-scope", { "is-current": stratum.isCurrent }]}
                style={`--block-hue:${stratum.hue};--stratum-fill:${stratum.fill.toFixed(3)}`}
                title={stratum.fullTitle}
                aria-hidden="true"
              >
                <i class="stratum-fill"></i>
                <span class="stratum-id">
                  {stratum.isCurrent && <b class="stratum-glyph stratum-here" aria-hidden="true">▸</b>}
                  {stratum.id}
                  {stratum.hasDeepDive && <b class="stratum-glyph stratum-deep" aria-hidden="true">◈</b>}
                </span>
                <span class="stratum-title">{stratum.title}</span>
                <span class="stratum-count">{stratum.publishedInBlock}/{stratum.total}</span>
                <span class="stratum-days">{padDay(stratum.startDay)}—{padDay(stratum.endDay)}</span>
              </span>
            ))}
          </span>
          <span class="cover-chart-caption" aria-hidden="true">
            <span>{isZh ? `已发布 ${publishedDays.length} / ${book.totalDays} 日` : `${publishedDays.length} of ${book.totalDays} days published`}</span>
            <span>{currentFrontier ? (isZh ? `进度 ${padDay(currentFrontier.day)}` : `Latest Day ${padDay(currentFrontier.day)}`) : "000"}</span>
          </span>
        </a>
      </div>
    </section>
    <script type="application/json" data-reading-days data-reading-locale={locale} set:html={JSON.stringify(readingDays)} />

    <section class="wrap wide home-project-strip" aria-label={isZh ? "项目与下载信息" : "Project and download information"}>
      <p class="home-release-note">
        <strong>{isZh ? "编辑札记" : "About this release"}</strong>
        <span>{isZh ? "新内容不一定每天更新。人工编辑有时会暂停发布，以便手动核查质量；最新发布的几课可能仍有编辑尚未复读的粗糙之处。" : "New content doesn't arrive every day. The editor sometimes pauses publishing to check quality by hand, and the newest lessons may still have rough spots that haven't been re-read yet."}</span>
      </p>
      <p class="home-offline-lead">
        <strong>{isZh ? "离线阅读" : "Offline editions"}</strong>
        <span>{isZh ? "当前版本也可下载后离线阅读：" : "Download the current edition to read offline:"}{" "}
          <a href={downloads.epub}>{isZh ? "EPUB" : "EPUB"}</a>
          <span class="home-offline-sep" aria-hidden="true"></span>
          <a href={downloads.pdf}>{isZh ? "印刷版 PDF" : "Print PDF"}</a>
        </span>
      </p>
    </section>

    <section class="wrap wide home-latest" aria-labelledby="latest-descents-title">
      <header class="home-section-head">
        <div>
          <p class="sec-eyebrow">{isZh ? "最新发布" : "Recently published"}</p>
          <h2 id="latest-descents-title">{isZh ? "最新几课" : "Recent lessons"}</h2>
        </div>
        <p>{isZh ? "从最新一日往回追溯，或回到课程表选读任意一课。" : "Browse the most recent lessons, or open the full syllabus for anything earlier."}</p>
      </header>
      <div class="home-latest-grid">
        {featuredDay && (
          <div
            class="home-featured-day block-scope"
            data-folio={padDay(featuredDay.day)}
            style={`--block-hue:${featuredBlockHue}`}
          >
            <p class="featured-signal"><span aria-hidden="true"></span>{isZh ? "刚刚发布" : "Just published"}</p>
            <DayCard day={featuredDay} locale={locale} totalDays={book.totalDays} />
          </div>
        )}
        <div class="toc-grid recent-descent-stream">
          {recentDays.map((day) => (
            <DayCard day={day} locale={locale} totalDays={book.totalDays} />
          ))}
        </div>
      </div>
      <p class="all-days-link"><a href={syllabusUrl}>{isZh ? "查看完整课程表" : "See every published lesson"}</a></p>
    </section>
  </div>
</BookShell>
